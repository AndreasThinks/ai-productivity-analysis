mpl_file": null}, {"sha": "8ff0241c0532bcb9be0f6f37fdcd97974b5888b9", "message": "Update portfolio.js", "created_at": "2025-12-05T10:41:47Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "70abac1f56f37bf6f8e7aa9322bfb611f28c9183", "message": "Update RefreshButton.js", "created_at": "2025-12-05T10:41:40Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "23b27a24f08264033541068ca8bce940b1403fd1", "message": "Update fetchTokenAttributes.js", "created_at": "2025-12-05T10:41:34Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7677d00284c2cec1ea4b6375a499de622e4103b6", "message": "Enable order selection at price level in order book\n\nAggregates orders by price in order book components and allows users to select a price level, displaying all available orders at that price. Adds Redux action and reducer support for storing available orders at a selected price, and updates TradeForm to provide a dropdown for selecting which order to execute. Improves user experience for executing orders when multiple exist at the same price.", "created_at": "2025-12-04T19:34:36Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f3e638ecb2c574513e012f8f501d4f272d794425", "message": "Update markets.js", "created_at": "2025-11-16T16:35:04Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7abd413bf8396f547908cde723c47f02664b79d8", "message": "Update formatNumber.js", "created_at": "2025-11-16T16:34:59Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d93b106f12ebe351f1db277da138026a748ef20a", "message": "update version nr", "created_at": "2025-11-16T15:37:49Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f454d108c6237e7b95745ca4d03206cb55c3cfca", "message": "Update package.json", "created_at": "2025-11-15T22:48:30Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3c7219487e50e203113e82dacd98eda1621f3466", "message": "Update stablecoinSwap.js", "created_at": "2025-11-15T21:28:38Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9a21815e54d9661b24dbab5481188fe517d46fa1", "message": "Update stablecoinSwap.js", "created_at": "2025-08-16T10:44:28Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2ed6a726d208af0b858a3aabc5fe2d7058c78feb", "message": "Update stablecoinSwap.js", "created_at": "2025-08-14T21:03:43Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b84cd2f366dd0c97f0d1c656ca7be7cc2c39aa88", "message": "Bump version to 0.4.0", "created_at": "2025-08-12T21:13:20Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3d426556dadbde651f90c25d8114c16b6e6b8e67", "message": "Update stablecoinSwap.js", "created_at": "2025-08-12T21:06:23Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9d583ff611ded2cc851b9513b9fb14e573798dcb", "message": "Update stablecoinSwap.js", "created_at": "2025-08-12T14:28:49Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "795f1e709aa93990d1e9ddb19eb87794662dbe9e", "message": "Update stablecoinSwap.js", "created_at": "2025-08-12T10:54:31Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "09e3c8fa54d289fc1a2a27857577a17654a27e72", "message": "Update README.md", "created_at": "2025-08-11T13:21:32Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "15ec3ad44c2db995b0c3fda6ec562ed9922c60d4", "message": "Update README.md", "created_at": "2025-08-11T13:20:09Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "eba343713455bd9da2d0098a9c3edee864a94224", "message": "Add swap fees and minimum amount enforcement\n\nIntroduces flat and percentage-based fees for swaps, enforces a minimum swap amount, and displays fee breakdown and estimated received amounts in the UI. Updates transaction handling and validation logic to account for these new requirements.", "created_at": "2025-08-11T13:11:05Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3663ee7cc1ffe96a9777f58251f6af5d5d872d4f", "message": "Refactor stablecoin swap to remove wallet UI and add external Solana tx tracking\n\nRemoved all Solana wallet connection UI and logic; swaps are now initiated externally and tracked by pasted Solana transaction signatures. Added Solana RPC helpers and polling to monitor USDC transfers and Nexus USDD credits. Improved instructions and input fields for users to send USDC from any Solana wallet and track swap status. Updated USDD\u2192USDC flow to validate recipient USDC token account before debiting.", "created_at": "2025-08-11T13:03:43Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0d3c5405c9a7cf8e5cd985f2fdaf7ac3a5127ca1", "message": "Reduce account fetch limit and adjust table widths\n\nDecreased the API fetch limit from 1000 to 100 for accounts in HoldersList to improve performance. Updated the table column widths for Amount and Percentage to better fit the displayed data.", "created_at": "2025-08-01T09:52:59Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0c69ed5dcbb714e8f795894126baf95b9c1c0751", "message": "Improve HoldersList loading, error handling, and UI\n\nAdded loading and error states to HoldersList, improved API data processing, and enhanced table rendering with owner/account columns and better feedback for empty or failed loads. The component now defaults to showing 10 holders and provides clearer context in the UI.", "created_at": "2025-08-01T09:33:53Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5e0effb91078160878ef62442c245fa484e7acfc", "message": "Limit HoldersList to 10 entries in Overview\n\nPasses num={10} to the HoldersList component in the Overview page to restrict the displayed holders to 10, improving consistency with other components.", "created_at": "2025-08-01T09:33:37Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a47469522d9be804cacb9dac08489790739e8de6", "message": "Add linear/log scale toggle to ChartWindow\n\nIntroduces a toggle button to switch between linear and logarithmic price scales in the chart. Updates chart options and applies scale mode dynamically without recreating the chart. Also adjusts number formatting for price and volume displays.", "created_at": "2025-07-31T16:00:50Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "49555884763bf7b2a2658a15646378589e6bb40b", "message": "Merge branch 'testing-3.1.5' of https://github.com/AkstonCap/DEX into testing-3.1.5", "created_at": "2025-07-31T15:35:03Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3fab0b5c16bce5a86d04ffc5f232df37b462584e", "message": "Add myUnconfirmedTrades reducer for market UI\n\nIntroduces a new reducer to manage unconfirmed trades in the market UI. Handles setting, adding, and removing unconfirmed trades based on dispatched actions.", "created_at": "2025-07-31T15:34:58Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1e2abd6a3217a9e9a3a092f693979bc1d640241a", "message": "Update myUnconfirmedOrders.js", "created_at": "2025-07-31T15:34:39Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "50e0a1aeb7d934f98b9641460f5c58d4593fb5bb", "message": "Update myCancellingOrders.js", "created_at": "2025-07-31T15:34:28Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "99ce89459fc4da3651a974ed360eccd21e9b6844", "message": "Update index.js", "created_at": "2025-07-31T15:34:20Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3e46df71b8621b304342ddf00951e3a6d6714bb6", "message": "Exclude temporary order states from session storage\n\nUpdated the stateMiddleware in configureStore.js to prevent temporary order and trade states from being saved to session storage. Also disabled Redux DevTools to avoid serialization errors.", "created_at": "2025-07-31T15:34:04Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1dcd720ae80eca3fb241519fcae9a8a63c2b9a08", "message": "Use dynamic step size in TradeForm inputs\n\nReplaced hardcoded step values in quote amount and price input fields with dynamic values based on quoteTokenDecimals for improved precision and flexibility.", "created_at": "2025-07-31T15:33:45Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "05d2b15a14d580bf3f8b9064de0edab195e7c477", "message": "Show unconfirmed trades in PersonalTradeHistory\n\nAdds support for displaying unconfirmed trades alongside confirmed trades in the PersonalTradeHistory component. Unconfirmed trades are filtered by the current market pair and rendered with a distinct table row, improving user visibility of pending transactions.", "created_at": "2025-07-31T15:33:30Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ccae220b2f6856059a1eadfa928035da60966a02", "message": "Filter unconfirmed orders by current market pair\n\nUnconfirmed orders are now filtered to only display those matching the selected market pair, ensuring the open orders list is relevant to the user's current market context.", "created_at": "2025-07-31T15:33:13Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6aa577e2a2e55be95643b147ac5a81620ff24bbd", "message": "Add hide zero balances option to portfolio\n\nIntroduces a checkbox to allow users to hide tokens with zero balances in the portfolio view. The token list is filtered based on the checkbox state, improving usability for users with many tokens.", "created_at": "2025-07-31T15:32:56Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "47245238365a7e83e78a713f6b5a435ae4cf077d", "message": "Add unconfirmed trades action types\n\nIntroduces action types for managing unconfirmed trades: SET_MY_UNCONFIRMEDTRADES, ADD_UNCONFIRMED_TRADE, and REMOVE_UNCONFIRMED_TRADE. This supports future state management for unconfirmed trades.", "created_at": "2025-07-31T15:32:43Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "05d1d003ef7ee08ad38af55a76b33c5b35805960", "message": "Refactor dialogs and add unconfirmed trade handling\n\nReplaces dispatching of dialog actions with direct function calls to showErrorDialog and showSuccessDialog for improved consistency. Adds unconfirmed trade handling in executeOrder and ensures only serializable strings are passed to dialogs. Also updates imports to include addUnconfirmedTrade.", "created_at": "2025-07-31T15:32:29Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "326aac1f7ab4e33ebc87f2d3bfe3487c34ec20a2", "message": "Limit displayed digits in formatNumberWithLeadingZeros\n\nAdjusts the slice of digits to show at least one digit and no more than the remaining token decimals after leading zeros. This prevents displaying excess digits and improves formatting consistency.", "created_at": "2025-07-31T15:32:03Z", "repo": "DEX", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d767430bcd7e28302fffd46753e6221c20d500b4", "message": "Update fet