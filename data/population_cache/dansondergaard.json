201cafd91661efb10447fe44cc7d0f124ac", "message": "Merge branch 'master' into master", "created_at": "2019-08-05T08:49:22Z", "repo": "rs-munge", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "dd5c1c0846fc0ed3fba3f085512bb712236429a7", "message": "Add roundtrip example", "created_at": "2019-08-02T11:34:33Z", "repo": "rs-munge", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "98b544803168c23403615f9a43959f5e14f98dcd", "message": "Fix broken test", "created_at": "2019-08-02T11:29:16Z", "repo": "rs-munge", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5672a2f9ed22f037599df3739697a63cbb8d8122", "message": "Remove invalid free() in encode\n\nThe munge documentation says:\n\n    A pointer to the resulting credential is returned via cred; on\n    error, it is set to NULL.\n\nThus, there's no need to free(cred) when an error occurred.", "created_at": "2019-08-02T11:27:33Z", "repo": "rs-munge", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1667b756b5245b1389c30280f81f7d146930f526", "message": "More meaningful type in cast", "created_at": "2019-08-02T11:26:32Z", "repo": "rs-munge", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7345a51c9774cf84b593722f81ef1a49d2db7280", "message": "Use more meaningful type in cast", "created_at": "2019-08-02T11:22:36Z", "repo": "rs-munge", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ac6ce3fc37dd2032123f4603040c69493949d723", "message": "Use String::from_raw_parts to get payload\n\nSince the length of the payload is known in decode()\nwe can use String::from_raw_parts() to get a String\ndirectly. I'm not sure if this is faster than the\nother approach, but it seems cleaner.\n\nAlso, this commit renames payload_ptr to payload.", "created_at": "2019-08-02T11:19:26Z", "repo": "rs-munge", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "87f64022cc132fd78f99dfb1bf419822891ea1a3", "message": "Attempt to free memory to fix leaks", "created_at": "2019-08-01T08:04:06Z", "repo": "rs-munge", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "41a739d647861cea1cd3d379e3d3487e1add2b4e", "message": "Add test for memory leaks", "created_at": "2019-08-01T08:04:06Z", "repo": "rs-munge", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f4bd60efd742b049f8dfd583c3a704c40b2676a5", "message": "Implement Error for MungeError to make it wrappable", "created_at": "2019-08-01T07:55:38Z", "repo": "rs-munge", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0749f3e799a8375c3163061f585deb65e245021a", "message": "Add missing munge_ctx_strerror to munge-sys\n\nApparently there's both a munge_strerror and munge_ctx_strerror.\nThis commit adds the previously missing munge_ctx_strerror.", "created_at": "2019-07-31T13:46:25Z", "repo": "rs-munge", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3ff29a88a0a9db38e66acefd5b193972dfd40af2", "message": "Better encapsulation, make API public", "created_at": "2019-07-31T13:43:12Z", "repo": "rs-munge", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a4838d4d79ff263b1dbc32c642c8ff14c2911e02", "message": "Add README.md", "created_at": "2019-07-31T13:20:45Z", "repo": "rs-munge", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b3e396c6166ab512d3f909885ef12dfbdebfa43f", "message": "Make payload optional", "created_at": "2019-07-31T13:20:34Z", "repo": "rs-munge", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "98c2a67f1a40bf9eedc30c661eb8bde751d3c63f", "message": "Add support for payload", "created_at": "2019-07-31T13:02:35Z", "repo": "rs-munge", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "157f69c0f96456ea61801ba7bbe1979fcf8a294d", "message":