1ea\u52d5\u7684\u306bvim-indent-guides\u3092\u30aa\u30f3\u306b\u3059\u308b\r\nlet g:indent_guides_enable_on_vim_startup=1\r\n\r\n\"# \u30ac\u30a4\u30c9\u306e\u5e45\r\nlet g:indent_guides_guide_size = 1\r\n\r\ncall neobundle#end()\r\n\r\n\"# \u30d5\u30a1\u30a4\u30eb\u30bf\u30a4\u30d7\u5225\u306e\u30d7\u30e9\u30b0\u30a4\u30f3/\u30a4\u30f3\u30c7\u30f3\u30c8\u3092\u6709\u52b9\u306b\u3059\u308b\r\nfiletype plugin indent on\r\n\r\n\r\n\uff13\uff09vim\u306e\u30b3\u30de\u30f3\u30c9\u30e2\u30fc\u30c9\u306b\u3066\u4ee5\u4e0b\u3092\u5b9f\u884c\r\n:NeoBundleInstall", "created_at": "2018-02-28T02:38:18Z", "repo": "dotfiles", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f9c8a6f862d6b8564a9086926a1d922dc59844ce", "message": "bash_profile\u306e\u5909\u66f4", "created_at": "2018-02-22T11:42:58Z", "repo": "dotfiles", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4f111e630d1b4d3ff4093dc8f7ac1d8a15763943", "message": "bash_profile\u306e\u5909\u66f4", "created_at": "2018-02-22T11:41:52Z", "repo": "dotfiles", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8194f253494b2eaf9393d297f2a7f3062926da1d", "message": "Merge pull request #1 from yuta-ushijima/fix/vimrc\n\nvimrc\u306e\u4fee\u6b63", "created_at": "2018-02-22T05:45:08Z", "repo": "dotfiles", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f4024b268ac9a8838a843e8274df19e244b63ee4", "message": "vimrc\u306e\u4fee\u6b63\n\nvimrc\u306e\u4fee\u6b63", "created_at": "2018-02-22T05:44:33Z", "repo": "dotfiles", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6c23626a629adbea084cb052b01c7ae4706c74b7", "message": "git\u306ealias\u3092\u5909\u66f4", "created_at": "2018-01-20T01:08:59Z", "repo": "dotfiles", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "39263201e319875fd3550017c1ec1a0ed6c028fd", "message": "first commit", "created_at": "2017-09-13T12:04:27Z",