39:28Z", "repo": "TF2Monitor", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5d2465ca3067e3b3f1fc2d990cfed31d24d1e131", "message": "DB work", "created_at": "2026-01-01T12:15:40Z", "repo": "TF2Monitor", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a26a313a4a18296f44353ead5dd182ae648494c0", "message": "Update .gitignore", "created_at": "2026-01-01T12:15:25Z", "repo": "TF2Monitor", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "58876cb304a016af490cd11f96d57eec2fd70d95", "message": "Add fetch_date to account and implement DB setup\n\nIntroduces a new `fetch_date` field to the account model and updates the data model documentation accordingly. Adds a new `db.rs` module to handle database connection and schema setup, including table and index creation. Updates the module exports to include the new db module.", "created_at": "2026-01-01T11:05:09Z", "repo": "TF2Monitor", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7d77948aeeccea412e832bc677d2c177b8bf4b64", "message": "Bump version to 0.1.5\n\nUpdate Cargo.toml and Cargo.lock to reflect the new version 0.1.5 for the tf2monitor package.", "created_at": "2025-12-31T16:46:12Z", "repo": "TF2Monitor", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "77815764391aa3eba2bf0e3a97a7eebb02af49da", "message": "Update config.rs", "created_at": "2025-12-31T16:46:02Z", "repo": "TF2Monitor", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7572b872aef735b7a4b9446d4fe93f49425d4971", "message": "Nicer list of source bans on the player detail panel", "created_at": "2025-12-31T16:21:48Z", "repo": "TF2Monitor", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e0224b5f94efb02ad655dcf54fba9a167f3702e0", "message": "Update player_details_panel.rs", "created_at": "2025-12-30T20:08:27Z", "repo": "TF2Monitor", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e1027d4a17b82b35bde4cc78b8e7019b23394e8a", "message": "Add option to toggle ping display in scoreboard\n\nIntroduces a new 'Show ping' setting in AppSettings and the top menu, allowing users to show or hide the ping column in the scoreboard. The scoreboard layout and header now conditionally render the ping column based on this setting.", "created_at": "2025-12-30T15:11:01Z", "repo": "TF2Monitor", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "80df5055a0c0e2b65cddb72fe3be9a73a21165a2", "message": "Rename player ping field to ping_ms for clarity\n\nRefactored all relevant structs and code to rename the player ping field from 'ping' or 'pingms' to 'ping_ms' for consistency and clarity. This affects player data structures and their usage in the GUI, lobby, and RCON parser modules.", "created_at": "2025-12-30T14:56:15Z", "repo": "TF2Monitor", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "769b50643ba229592a3493e85abbb6ef6052dd0e", "message": "Refactor kill/death handling in LobbyThread", "created_at": "2025-12-30T14:53:37Z", "repo": "TF2Monitor", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b2848c21cc5bd8b633b53ca7132f4ab7a9a8d6cd", "message": "Refactor SharedLobby to use get/set pattern\n\nReplaces direct mutable access to the lobby with a get/set approach, ensuring the mutex lock is only held briefly during state access and updates. Refactors all lobby mutations in LobbyThread to use this pattern, improving thread safety and reducing lock contention. Also updates chat translation to avoid holding the lock during expensive operations.", "created_at": "2025-12-30T13:07:29Z", "repo": "TF2Monitor", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c1a040318d9799ed2576b14738cd6dbf26494f5a", "message": "Add warning log when Steam API key is missing\n\nA warning is now logged if the Steam API key is not set when attempting to fetch additional info, improving visibility for missing configuration.", "created_at": "2025-12-30T13:03:23Z", "repo": "TF2Monitor", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1dc9b4fdb40acb98efd915fe867b04a44de817d7", "message": "Update and clarify README instructions and sections\n\nRevised the README for improved clarity and structure, including updated setup instructions, privacy statement, and Linux support details. Simplified feature descriptions, reorganized configuration steps, and removed redundant or outdated content.", "created_at": "2025-12-30T12:05:40Z", "repo": "TF2Monitor", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "95284d303583772ed83e66bfb3aa9121aa2d4f11", "message": "v0.1.4", "created_at": "2025-12-29T18:27:47Z", "repo": "TF2Monitor", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "dd0b6ea5d464f5e0fd7438a0b9baac12018d6ad2", "message": "Update player_details_panel.rs", "created_at": "2025-12-29T18:27:02Z", "repo": "TF2Monitor", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c585749b1f415c35c6a624ea0474a9c6e676e258", "message": "Made the Health column selectable if it should be shown", "created_at": "2025-12-29T18:04:57Z", "repo": "TF2Monitor", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "33f6c994790a155c4ca65ba4262107ed424eff1d", "message": "Clippy fixes", "created_at": "2025-12-29T17:59:09Z", "repo": "TF2Monitor", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "399ecd359793d9da7835c129e5c7a2851f4711e7", "message": "Update lobby_thread.rs", "created_at": "2025-12-29T17:47:45Z", "repo": "TF2Monitor", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0eb31f6a76f7547b2ff68dde4991817d7d2c14e7", "message": "Update mod.rs", "created_at": "2025-12-29T17:47:29Z", "repo": "TF2Monitor", "file_sampled"