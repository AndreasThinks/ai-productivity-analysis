{"login": "gillibrand", "location": "Southern California, USA", "commits": [{"sha": "f03f57fdae2a2ea1a5bc6d774d2e95f56773dcc9", "message": "Fix comment typo\n\nWrote \"final\" instead of \"find\".", "created_at": "2025-01-27T15:19:27Z", "repo": "expand-selection-to-function-js", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7dcad63e54430c33319482ba824eac7508d51469", "message": "Simple profiling", "created_at": "2024-06-04T21:46:23Z", "repo": "expand-selection-to-function-js", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d04a0a13b6cded88e9c4ac07c07651e45eece6cb", "message": "Performance improvement with finditer\n\nUse re.finditer to find all function matches before our selection instead of trying to walk backwards.", "created_at": "2024-06-04T21:32:26Z", "repo": "expand-selection-to-function-js", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c4bd540269b7234aff307a428a32acec2655101d", "message": "Note about semver releases", "created_at": "2024-06-04T18:43:36Z", "repo": "expand-selection-to-function-js", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "abb856c2e4c577170f2de31f41f7d05a7b85a8da", "message": "Support comments between name and opening brace\n\nIssue #6", "created_at": "2024-06-04T18:07:17Z", "repo": "expand-selection-to-function-js", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5c8260cb9ef9dee5365b30abbc65b1f4f8831fb5", "message": "Update README about typo fix.", "created_at": "2015-01-04T08:08:01Z", "repo": "expand-selection-to-function-js", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "16cd594faf6a8c55569f08c2f8b4e09cbde97a4c", "message": "Merge pull request #4 from chenglou/readme-typo\n\nOops. Thanks again.", "created_at": "2015-01-04T08:05:51Z", "repo": "expand-selection-to-function-js", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a995bc7343995a8d9537cd667770a8ff7b60d83d", "message": "Add Version History section to README", "created_at": "2015-01-04T07:16:42Z", "repo": "expand-selection-to-function-js", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9cce092b3888f5b4a15dce9bd3eceeb1df74b8ac", "message": "Added Compatibility section in README.", "created_at": "2013-03-12T23:38:21Z", "repo": "expand-selection-to-function-js", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1023bfd33ae63e148bbd065ef6f340f4683f1292", "message": "Cleaned up some comment alignment issues.", "created_at": "2013-03-12T23:34:07Z", "repo": "expand-selection-to-function-js", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "01ad0e99c21d7a70906162c6877a7ce48f341ca9", "message": "Python/SublimeText 3 compatibility.\n\nReplaces xrange with range to work i nPy 3 and Sublime Text 3. No other\nobvious changes needed.\n\nAdd new functon style to match: ClassName.prototype.methodName style.", "created_at": "2013-03-12T23:20:19Z", "repo": "expand-selection-to-function-js", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4492f72abd3cc0ca607977d33b4a391e55a98466", "message": "Ignore commented out functions.\n\nWhen matching a function start, check if the scope is \"comment\" and\nignore if so.\nMoves check for comment into slighlty clearer is is_comment_at_point\nmethod.", "created_at": "2013-01-03T18:22:32Z", "repo": "expand-selection-to-function-js", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c348b255e3ee4c86207d9127c9d6c84a61d40359", "message": "When balancing braces, ignore braces in comment scopes.", "created_at": "2012-10-19T04:24:34Z", "repo": "expand-selection-to-function-js", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3052bcdeb6a4cbc5bee3f1626f7f3c56e88d2cf5", "message": "Match capitalization other \"expand\" commands.", "created_at": "2012-08-30T05:44:18Z", "repo": "expand-selection-to-function-js", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b461d59edac91e383cc911193fd4b8648feb85de", "message": "Typos and clarifications in README.", "created_at": "2012-08-30T05:07:14Z", "repo": "expand-selection-to-function-js", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8040693597445017bf2277479d489ac3e5814452", "message": "Fix README typos.", "created_at": "2012-08-27T05:07:35Z", "repo": "expand-selection-to-function-js", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6bc0b9e03d72778574eb11ca9a943ae802a9a23f", "message": "More detailed README.", "created_at": "2012-08-26T23:24:31Z", "repo": "expand-selection-to-function-js", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3991802659e597406bab3fab8a67001b678526e5", "message": "Standardize on preferred \"\"\"triple quotes\"\"\".", "created_at": "2012-08-25T18:18:07Z", "repo": "expand-selection-to-function-js", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3e295cf403cc1cc256903c8f1a2cc4ac73eb529c", "message": "Initial commit.", "created_at": "2012-08-25T18:06:55Z", "repo": "expand-selection-to-function-js", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "270bff0462dc06d444bd46d526953ab1dd18b90e", "message": "Update README.md\n\nTypo \"he\" to \"the\"", "created_at": "2024-12-06T18:36:40Z", "repo": "sublimetext-dojo-modules", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3f912ab14bb0ef94efd217fe3722efb48dd36c96", "message": "Use only one background thread to scan directories.\n\nSince IO is the bottleneck, many threads won't help. Just keep all the\nscanning IO in the background so it doesn't affect startup time. Since\nthere is less IO contention, this should be faster and simplifies the\ncode.", "created_at": "2014-01-06T20:58:56Z", "repo": "sublimetext-dojo-modules", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "282603ffbea01f253b47cf917c610571ddbf83d3", "message": "Requires Sublime Text 3 now.", "created_at": "2014-01-06T18:47:52Z", "repo": "sublimetext-dojo-modules", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "075b60539e5315178b7ec4b03ed8aa4ad48e87ae", "message": "Update README with performance info.", "created_at": "2014-01-06T18:44:40Z", "repo": "sublimetext-dojo-modules", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "fbf3130898d9954bb34457c5810c0dda75c6bc89", "message": "Merge branch 'master' of https://github.com/gillibrand/sublimetext-dojo-modules", "created_at": "2014-01-06T18:39:16Z", "repo": "sublimetext-dojo-modules", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9a238e958782deed3b4a8a1f4697250e8368e78f", "message": "Scan paths in background threads; faster startup.\n\nStatus message will be shown once all paths are scanned.", "created_at": "2014-01-06T18:36:34Z", "repo": "sublimetext-dojo-modules", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "bc72fbda5643ad806059a2a7e2a6ecf4fcc0bdd9", "message": "Merge pull request #1 from hbhakhra/master\n\nAdd a feature to insert dojo.provide based on the file name", "created_at": "2013-11-18T17:00:05Z", "repo": "sublimetext-dojo-modules", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e7b3636320c9235a0227d56d991432cac105dff2", "message": "Cannot load setting from \"top level\" script.", "created_at": "2013-11-13T00:00:02Z", "repo": "sublimetext-dojo-modules", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c71dc6ec1eb583a1aca39ecc056ea8412c081084", "message": "Sublime Text 3 workaround. Must create new TextCommands to get an Edit\nobject in callbacks.", "created_at": "2013-11-12T17:57:17Z", "repo": "sublimetext-dojo-modules", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ca9a9b0b63c86cb0681041d889b5147781438603", "message": "Update README.md", "created_at": "2013-03-14T03:52:12Z", "repo": "sublimetext-dojo-modules", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7b4064d3b48d6f30244ba21fceb06f88a88bcd7a", "message": "More complete README.\n\nREADME is still missing some details.", "created_at": "2013-03-13T21:34:00Z", "repo": "sublimetext-dojo-modules", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "70996afe93a782c17cdc8f5b9d8d243b8402ece1", "message": "Start a real README", "created_at": "2013-03-13T21:11:36Z", "repo": "sublimetext-dojo-modules", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0c1a882d6001a5d76dbf45080eab3328fc1dd005", "message": "Stub out readme", "created_at": "2013-03-13T21:03:47Z", "repo": "sublimetext-dojo-modules", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "19e7c2aafd19918989efc30cd4696d3315204885", "message": "Initial Sublime Text 3 support", "created_at": "2013-03-13T20:55:04Z", "repo": "sublimetext-dojo-modules", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0e056a898c1814f29dab9ce6b1f3f5846064448d", "message": "first commit", "created_at": "2013-03-13T20:51:54Z", "repo": "sublimetext-dojo-modules", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e9e71ce0dfe5f3b382b23f7c3b9b2a3dacc2617d", "message": "Update README to say \"not supported\"", "created_at": "2022-10-24T22:11:34Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5ca2d98f1e3d37d1fef20cf3c8111f7f386f3b68", "message": "Ignore exported workflow\n\nWorkflow can now be downloaded from the assets of the latest release.", "created_at": "2022-03-25T03:26:43Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ec38d2874c003b42d25a8a26cc599f298fb20100", "message": "Merge branch 'master' of github.com:gillibrand/alfred-change-case", "created_at": "2022-03-25T03:21:25Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ed630ccd773de6185edb0f00d52c180da5cde2a5", "message": "Some inner letters are uppercase when using titlecase\n\nTitlecase has an allow list of known acronyms that alwasys remain all uppercase. They were being matched within words though, so \"previous\" became \"PrevIOUs\" (since IOU is uppercase).\n\nChanged the match to only occur on word boundaries.", "created_at": "2022-03-25T03:21:03Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6d3db861fba4bdd2b64c2e4c9b8201437c37a718", "message": "Remove built the workflow from repo (get from release assets)", "created_at": "2022-03-24T22:39:55Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "05a40765644fad006dedcbc6b843308c4a2a6a6f", "message": "Fix URL to release asset", "created_at": "2022-03-24T22:38:33Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "434b134883b8cf0f097dbd411ea1286c3f3aa290", "message": "Point to latest release for download link.", "created_at": "2022-03-24T22:37:16Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0a9b0658118a7bd2041f5475c4cd3d2e92c5b42b", "message": "Add direct download link to readme", "created_at": "2022-03-24T20:56:01Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4a1d3433c454946d819de403a3b819847aa3d8b8", "message": "Add version number\n\nAdd missing version number and category for smoother imports.", "created_at": "2022-03-24T20:50:24Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3d9eb5850eaafcb2df4307fefa27fdf76a3745da", "message": "Update for macOS Monterey, Python 3\n\nPrefers python3 if available, which is the default on Monterey.\nFallsback to plain python (2) if available. Script should work on both.\nUpdates icon to work better with dark themes.", "created_at": "2022-03-24T20:29:55Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "64eb34178795b6176fdcf546f2f07d4bd13d788e", "message": "Merge branch 'blizzrdof77-master'", "created_at": "2018-09-10T07:46:37Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "075c93a7063c2a5702129665d96b773721c6da72", "message": "Simplify previews\n\nChanged item titles to from sentences to just the name of the case.\nRemoved quotes from previews.\nKept workflow name as simply \"Change Case\".\nRemoved default keybinding (conflicted with other keybindings).", "created_at": "2018-09-10T07:45:53Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ed3715e8c0e6b6b3c837863db44456f5c552118d", "message": "Rebuild workflow with stable results sorting.", "created_at": "2013-04-20T04:55:16Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "205080d94aaf9dacf218f3a3251c755f60a08288", "message": "Remove `uid` from returned items.\n\nAlways sorts the case styles the same way in Alfred now, since Alfred\n2.0.3 will generate a UID on the fly now and respect the order of items\nreturned from script filters.", "created_at": "2013-04-20T04:53:13Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "36a6644e82bebca1c83b63e79c2339612550e958", "message": "New download URL.", "created_at": "2013-04-15T04:25:36Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "57cb264ac5a7cd28930cd17112ec53ace60d7960", "message": "Add exported workflow to GitHub for better sharing URL.", "created_at": "2013-04-15T04:19:51Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0734c5dd945fea3765fdf87f3ad2d0763695d66f", "message": "Better support for always-uppercased acronyms for Title Case.", "created_at": "2013-04-07T06:19:13Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "82dc32e54ae97eac6f58cba8b7127e597ac6ff24", "message": "Upload pre-built workflow with title case fix.", "created_at": "2013-04-04T04:03:30Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3185a33176992d9579578c32edbdb8def5b83c48", "message": "Temp fix for title case not work on all uppercase input.\n\nThe titlecase module assume words in all uppercase are acronyms (XML,\nHTML, ID, etc), but this fails when all the text it uppercase. This\nmodule was originally written to normalize blog titles, instead of being\nfor general use. Will need a better fix later.", "created_at": "2013-04-03T16:35:15Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ba8a9ac14069884c0f2f061d9341194cc95e6818", "message": "Fix download link.", "created_at": "2013-03-31T00:26:13Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8c13f2658365fce2beb45d6517823034a1f7e545", "message": "Updated workflow with a default hotkey for the selected text.", "created_at": "2013-03-27T05:37:18Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "27731141d676c8f901737499c329926cdc04214e", "message": "Add .gitignore", "created_at": "2013-03-26T22:48:55Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ce133a15b2cc8244735edded5fb0ea99ac9684e2", "message": "Add a proper titlecase algorithm.\n\nIncluded open source titlecase module from\nhttp://muffinresearch.co.uk/archives/2008/05/27/titlecasepy-titlecase-in\n-python/", "created_at": "2013-03-26T22:23:39Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "33d1309a641e9cdfb9b16a719e11a1e430d3e4b8", "message": "Update screenshot", "created_at": "2013-03-26T21:39:50Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "65c6475fec93f8644ea3d55ff226bb4b838a048c", "message": "Remove temp files", "created_at": "2013-03-26T21:38:50Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "fe457ed576b51f491458eb9915631faba92eb8f9", "message": "Add some ugly icons.", "created_at": "2013-03-26T21:37:12Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3a62525d48481045f06cfbecf1c10213c3440c66", "message": "Link to pre-built workflow.", "created_at": "2013-03-26T15:55:26Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "93981e3a44453deec3dbf50ab3026cfc0e820c9f", "message": "Add screenshot to README.", "created_at": "2013-03-26T15:51:07Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "81231ddd951f71c37898b980b537136b771fe7ae", "message": "Add minimal README", "created_at": "2013-03-26T05:48:17Z", "repo": "alfred-change-case", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0a0c21ab1cf8cfc8ce8ef91a513a2689c972b817", "message": "Create README.md", "created_at": "2013-03-26T05:44:06Z", "repo": "alfred-change-case", "file_sampled": false, "has_te