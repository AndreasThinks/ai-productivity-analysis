{"login": "bmartino1", "location": null, "commits": [{"sha": "cfec1a1e5a39a98492125c99bf5a665b76e7dee3", "message": "Update README.md", "created_at": "2025-10-04T20:46:21Z", "repo": "unraid-lxc-unifi", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5a9fb80347cce1713ccc8f1c03338c55c4c31521", "message": "Update LICENSE\n\nUnifi Network Application on code sharing have changed.\r\nI'm all for GNU License Agreement as most our adaptions to edit and manipulate thing to run on other things. One can follow the build script and run them themselves to install and run unfi network application. AS Such folowing the TOS with Unifi, I Have decided that this need to follow the MITS License agreement.", "created_at": "2025-02-05T19:27:14Z", "repo": "unraid-lxc-unifi", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c7a714c1b935f20b3ebc5932dad6faa7535b3148", "message": "Update update-unifi.sh\n\nFixing version check and download for when new update occurs.\r\nnew script due to unfi tool change", "created_at": "2025-02-05T19:19:55Z", "repo": "unraid-lxc-unifi", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7f13713873d55036fafb6114276d08118ec7974d", "message": "Update 07-make-sure-unifi-is-installed\n\nfix minor script issues and typos", "created_at": "2025-02-05T19:10:46Z", "repo": "unraid-lxc-unifi", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "aa02e3ae78df29d83d3078652645768417dd8d86", "message": "Update 07-make-sure-unifi-is-installed", "created_at": "2025-02-05T19:07:26Z", "repo": "unraid-lxc-unifi", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6b43739a4d9ac7d6cfb0b0250b7e0c858ff76a4f", "message": "Update notes.txt\n\nDate time and version with in the latest unfi lxc", "created_at": "2025-02-05T19:05:57Z", "repo": "unraid-lxc-unifi", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f8e5f0ad180b581bad2d7aba83c62f05d5642614", "message": "Update notes.txt", "created_at": "2025-02-05T19:03:54Z", "repo": "unraid-lxc-unifi", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b59f760dbb186fb7d36937e6fb54d6986207795a", "message": "Update update-unifi.sh\n\nNew way to get unfi version tool no longer package nor provided\r\n\r\nold script:\r\n\r\n\r\n\r\n#!/bin/bash\r\n# Display date\r\necho $(date)\r\necho\r\n\r\n# Allow apt repo to update for Unifi\r\necho \"apt-get update for next Unifi release\"\r\napt-get update --allow-releaseinfo-change\r\napt-get update --allow-releaseinfo-change\r\n\r\n# Get latest and current version\r\nLAT_V=\"$(wget -qO- https://dl.ui.com/unifi/debian/dists/stable/ubiquiti/binary-amd64/Packages | grep \"^Version:\" | awk '{print $2}' | cut -d '-' -f1)\"\r\nCUR_V=\"$(/usr/lib/unifi/bin/ubnt-apttool showpkgver unifi | cut -d '-' -f1)\"\r\n\r\n# Fall back to current version if latest version is empty\r\nif [ -z \"${LAT_V}\" ]; then\r\n  echo \"Can't get latest version from Unifi Network Server, falling back to: ${CUR_V}\"\r\n  LAT_V=\"${CUR_V}\"\r\nfi\r\n\r\n# Update routine\r\nif [ \"${CUR_V}\" != \"${LAT_V}\" ]; then\r\n  rm -f /tmp/unifi.deb\r\n  echo \"Found newer version from Unifi Network Server: ${LAT_V}, installing please wait...\"\r\n  if wget -O /tmp/unifi.deb \"https://dl.ui.com/unifi/${LAT_V}/unifi_sysvinit_all.deb\" ; then\r\n    echo \"Successfully downloaded Unifi Network Server!\"\r\n  else\r\n    echo \"Something went wrong while downloading Unifi Network Server!\"\r\n    rm -f /tmp/unifi.deb\r\n    systemctl start unifi\r\n    exit 1\r\n  fi\r\n  systemctl stop unifi\r\n\r\n  # Pre-configure debconf to answer \"Yes\" to the backup prompt\r\n  echo \"unifi unifi/has_backup boolean true\" | sudo debconf-set-selections\r\n\r\n  # Install the package non-interactively\r\n  DEBIAN_FRONTEND=noninteractive apt-get -y install /tmp/unifi.deb\r\n\r\n  rm -f /tmp/unifi.deb\r\n  systemctl start unifi\r\n  \r\necho \"System check and Full system upgrade\"\r\napt update && apt full-upgrade -y\r\n\r\nelse\r\n  echo \"Nothing to do, Unifi Network Server ${CUR_V} up-to-date!\"\r\nfi", "created_at": "2025-02-05T19:02:51Z", "repo": "unraid-lxc-unifi", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "12395fb062425786c0ec7ecd93634a31cf791a22", "message": "Update 07-make-sure-unifi-is-installed\n\nadded new script for tag release", "created_at": "2025-02-05T18:55:33Z", "repo": "unraid-lxc-unifi", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "899fcf92c900b8ae06156d2fe253ad3d54bb2f80", "message": "Create 07-make-sure-unifi-is-installed\n\nAddition build step for lxc release", "created_at": "2025-02-05T18:51:23Z", "repo": "unraid-lxc-unifi", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7bb5118e2ac4ae861a654a4e26225071a93c0a46", "message": "Update README.md\n\nupdate and fix spelling", "created_at": "2024-11-03T19:25:32Z", "repo": "unraid-lxc-unifi", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b784921491e73a8c6627c0c1480bbe894a7192a8", "message": "Update createLXCarchive.sh", "created_at": "2024-09-04T18:56:49Z", "repo": "unraid-lxc-unifi", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d82d46f922f3c452aa2dfc4e4e434a5ef56b0f20", "message": "Update 04-copy_files.sh", "created_at": "2024-09-01T19:40:06Z", "repo": "unraid-lxc-unifi", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "94cb01f05c99682d0727cf4d933742dfe0756211", "message": "Update update-unifi.sh\n\nupdates", "created_at": "2024-09-01T19:31:50Z", "repo": "unraid-lxc-unifi", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c80cb6807c677b81e2be0e254939a98987d3530e", "message": "Update update-system.sh\n\nDebian distro release", "created_at": "2024-09-01T19:31:04Z", "repo": "unraid-lxc-unifi", "file