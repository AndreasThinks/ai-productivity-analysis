mpled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5b2f01b9b8cc27e5423138fc3fd316c3ae6d009e", "message": "Update env.py", "created_at": "2025-02-11T21:27:02Z", "repo": "TodoGemini-App", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b85f3c2f850a1d3dec66dcb055538ed360af31cb", "message": "migration dosyalar\u0131", "created_at": "2025-02-11T21:22:22Z", "repo": "TodoGemini-App", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "aaba4f7f343578b619a8e0a4533c548908750b1a", "message": "Static", "created_at": "2025-02-11T21:20:50Z", "repo": "TodoGemini-App", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8b064c492739c0f93cf261fa67fb189bb31885ff", "message": "Create Dockercompose.yml", "created_at": "2025-02-11T21:18:28Z", "repo": "TodoGemini-App", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9415289f685858b1394d92046cb8799fb1b8fa91", "message": "Create Dockerfile", "created_at": "2025-02-11T21:17:47Z", "repo": "TodoGemini-App", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6671b4b9911b0f0b32ec4e64620b53e4f97151da", "message": "Update and rename env to .env", "created_at": "2025-02-11T21:17:07Z", "repo": "TodoGemini-App", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d25f2b12a3b593f648cb25123c4b66f59b98fb60", "message": "Create env", "created_at": "2025-02-11T21:16:01Z", "repo": "TodoGemini-App", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8234098d9cae912d3c5d466cf90b97cbe531229d", "message": "Create env.py\n\nAlembic i\u00e7in veritaban\u0131 migration y\u00f6netimini sa\u011flayan yap\u0131land\u0131rma dosyas\u0131.", "created_at": "2025-02-11T21:13:53Z", "repo": "TodoGemini-App", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "357165392bb812d8f11c7e172e6a34e3de3034d0", "message": "Rename models.py to database_models.py", "created_at": "2025-02-11T21:09:41Z", "repo": "TodoGemini-App", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "21b05340e0efddb58d3985e388d8cd95c9b6f39f", "message": "Create alembic.ini", "created_at": "2025-02-11T21:08:38Z", "repo": "TodoGemini-App", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "cd0fcd77d6677c7955c303111f42ad9dad90a75c", "message": "Create read.py\n\nFastAPI ile t\u00fcm g\u00f6revleri (To-Do'lar\u0131) listeleyen bir API endpoint'i.", "created_at": "2025-02-11T21:07:57Z", "repo": "TodoGemini-App", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7205436d3c96963f387c6996b3c38563f7c8de90", "message": "Create models.py", "created_at": "2025-02-11T21:05:33Z", "repo": "TodoGemini-App", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5faeefec0012a44fd94f5e83df72d73a1f2d3fcb", "message": "Create todo.py\n\nGemini AI entegrasyonu ile, kullan\u0131c\u0131 taraf\u0131ndan girilen g\u00f6rev a\u00e7\u0131klamalar\u0131 otomatik olarak detayland\u0131r\u0131l\u0131r ve daha kapsaml\u0131 hale getirilir.", "created_at": "2025-02-11T21:04:39Z", "repo": "TodoGemini-App", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2f472fc2790b8470a27856b016b42226bd06bfb4", "message": "Create auth.py\n\nFastAPI ile kimlik do\u011frulama ve yetkilendirme i\u015flemlerini y\u00f6netir. Kullan\u0131c\u0131lar bcrypt ile \u015fifrelenmi\u015f parolalarla kaydedilir, JWT tabanl\u0131 OAuth2 kimlik do\u011frulama kullan\u0131larak giri\u015f yap\u0131l\u0131r ve yetkilendirme i\u015flemleri ger\u00e7ekle\u015ftirilir.", "created_at": "2025-02-11T21:02:34Z", "repo": "TodoGemini-App", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "10c8097e850fef8da4a7c63d9fcadfc4be7d7720", "message": "Create main.py\n\nAna FastAPI uygulamas\u0131n\u0131 ba\u015flat\u0131r, statik dosyalar\u0131 sunar ve auth ve todo y\u00f6nlendiricilerini i\u00e7e aktar\u0131r. SQLite veritaban\u0131 i\u00e7in \u015fema olu\u015fturma i\u015flemini ger\u00e7ekle\u015ftirir.", "created_at": "2025-02-11T21:01:08Z", "repo": "TodoGemini-App", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "bd60735b5f8bbe27f59a96a8da22ef51daf66809", "message": "Create database.py\n\nFastAPI, SQLAlchemy ve SQLite ile geli\u015ftirilmi\u015f bir To-Do uygulamas\u0131. ORM tabanl\u0131 modelleme ve ba\u011f\u0131ms\u0131z oturum y\u00f6netimi i\u00e7erir.", "created_at": "2025-02-11T21:00:03Z", "repo": "TodoGemini-App", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c2c108e2e6a17ab5f3c9a6593edd1e8175b714cb", "message": "Create requirements.txt\n\nBackend: FastAPI, PostgreSQL, SQLAlchemy, Alembic\r\nAuthentication: JWT (python-jose, passlib, bcrypt)\r\nAI Integration: Gemini AI (google-generativeai, langchain-google-genai)\r\nFrontend Templating: Jinja2\r\nTesting: Pytest, HTTPX\r\nDeployment: Uvicorn", "created_at": "2025-02-11T20:58:19Z", "repo": "TodoGemini-App", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "aa74c18cd8143a0797f7d9165b7d0e1a331e5763", "message": "Update note.py", "created_at": "2025-03-06T15:01:33Z", "repo": "AI-NotesApp", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9ca9fe91fa435b74549a900b4d88478f3575a641", "message": "Update note.py", "created_at": "2025-03-06T15:01:26Z", "repo": "AI-NotesApp", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "802d550d6f5e906cdc985634fc9f3469de919037", "message": "Update note.py", "created_at": "2025-03-06T15:01:18Z", "repo": "AI-NotesApp", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8e42e04eaea1fba3343d030ad9c3299984829f61", "message": "Update note.py", "created_at": "2025-03-06T15:01:09Z", "repo": "AI-NotesApp", "file_sampled": false, "has_test_f