iance_checker.ps1\n\nmade some color corrections, and border shapes changes, border size changes\n\nremoved aliases", "created_at": "2021-09-16T05:28:34Z", "repo": "SQL_Compliance_checker", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c25235f4a2188fc73b771bbfc9532fb06a97c2c6", "message": "Create sqlcompliance_checker.ps1", "created_at": "2021-09-15T19:32:22Z", "repo": "SQL_Compliance_checker", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b8b47932f64c1a8ba152170815b3f2825db54260", "message": "Merge pull request #1 from shamvil89/1.2\n\n1.2", "created_at": "2021-01-20T01:33:09Z", "repo": "SQL_Compliance_checker", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "76018e78127d5fe9d507891d2007711f5894735c", "message": "Delete SQL_Compliance_Checker", "created_at": "2021-01-20T01:31:34Z", "repo": "SQL_Compliance_checker", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "16549b5c9931594f506555d5e36dae25743be6ec", "message": "Create README.md", "created_at": "2021-01-20T01:29:16Z", "repo": "SQL_Compliance_checker", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d4a5fa94b86f5cdbbfe2c9c7b54caf23fd6a9c01", "message": "Add files via upload\n\nscript version 1.2\r\n\r\n1. server name\r\n2. Logins that need to be removed/added\r\n3. DB File locations - flags red if any files in C drive\r\n4. Lists SQL Services if running as localsystem\r\n5. Ensure that below service accounts dont have below access \r\n\r\n\t1. Log on as a service \r\n\t2. Log on as a batch job \r\n\t3. Replace a process-level token \r\n\t4. Bypass traverse checking \r\n\t5. Adjust memory quotas for a process\r\n6. Displays port number\r\n7. Displays ForceEncryption (0/1)\r\n8. Checks for Filesystem Format\r\n9. Displays SQL SErver authentication mode\r\n10. checks if default sa login exists", "created_at": "2021-01-20T01:28:27Z", "repo": "SQL_Compliance_checker", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3292ae9fbb32864c23d42e98ce1f93233b9c3540", "message": "Create SQL_Compliance_Checker\n\nRead comment and make necessary changes to line 62\r\nread the code before executing it on your environment\r\nEmail me if you need any assistance - shamvilkazmi@hotmail.com\r\n\r\nThe code is incomplete and will not give an overall compliance report. it just covers 5 topics as of 02/08/2020", "created_at": "2020-08-02T07:16:09Z", "repo": "SQL_Compliance_checker", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0392f8934ad934046f3da18ee88c6f4ae6080971", "message": "Update README.md", "created_at": "2020-08-20T08:08:54Z", "repo": "backup_restoresqldb", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8cd11cc1407eb9698675ad136c8ff28ad04a8f87", "message": "Add files via upload\n\nfixed a bug in stopat", "created_at": "2020-08-20T08:07:04Z", "repo": "backup_restoresqldb", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f21cd01030c51aa0ee64f76e0ff3b95f9d75511d", "message": "Update README.md", "created_at": "2020-08-20T06:08:26Z", "repo": "backup_restoresqldb", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "835304d3d785423a22c76c47fe9d87dc9df3f423", "message": "Update README.md", "created_at": "2020-08-20T06:05:15Z", "repo": "backup_restoresqldb", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "77ae5fb63e76403707f99ff28533ed314c7d532a", "message": "Add files via upload\n\nGeneric syntax\r\nmsdb..sp_dbundo 'database_name' <-- this will build script to restore the database to how it was 15 minutes before\r\nto tell a specific time, use following\r\nmsdb..sp_dbundo 'database_name' , @stopat = 'DateTime of your choice'", "created_at": "2020-08-20T06:04:00Z", "repo": "backup_restoresqldb", "file_sampled": false, "has_test_file": null, "has_impl_file": n