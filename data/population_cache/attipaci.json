_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f5c2b5067d38e0f5e5d428ee96d5d10676191cac", "message": "HIRMES: Steve Maher's tweak to support both all caps and mixed case FITS column names.", "created_at": "2019-01-08T15:49:58Z", "repo": "crush", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1601862958237ed89d42cea295489ed67c6370ce", "message": "2.50-a1 (devel.15): 'write.spectrum' column headers, more efficient ChannelGroup.slim(), and move Channel-related classes back to crush package.", "created_at": "2019-01-07T18:35:25Z", "repo": "crush", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7baf4d12a2fda1c0033f16ae830c7c8fa46d1d9e", "message": "2.50-a1 (devel.14): Yet more FindBugs related tweaks - eliminate unnecessary toString() calls when concatenating strings.", "created_at": "2019-01-07T02:50:37Z", "repo": "crush", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "32e416dbef41c44fbebc1eb1c6b5eaaf67143933", "message": "2.50-a1 (devel.13): More FindBugs (contrib) related tweaks - eliminate superfluos Exceptions and unnecessary Thread.yield() calls (no longer needed in modern Java).", "created_at": "2019-01-07T02:28:06Z", "repo": "crush", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6f052990dd7426be257dd34675525d27bfd104b1", "message": "2.50-a1 (devel.12): More moves / deletes.", "created_at": "2019-01-05T21:01:55Z", "repo": "crush", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "680e4195beee5c51ad5d11972fa31143ce8d0822", "message": "2.50-a1 (devel.12): Moving thigs around, removing old & unused classes.", "created_at": "2019-01-05T20:52:28Z", "repo": "crush", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c2a9e8cb959755242ec33f1981bef75041807ad4", "message": "2.50-a1 (devel.11): Scan set validation: reinstated finding outliers and slews, common valid