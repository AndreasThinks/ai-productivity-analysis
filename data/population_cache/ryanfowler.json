: null}, {"sha": "c2f31333b325e9e10470d35777f81686b854b20b", "message": "Merge pull request #782 from ryanfowler/deps\n\nUpdate dependencies", "created_at": "2025-10-13T01:13:09Z", "repo": "lines", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3df37b62f487e7209637768c6e66b031418547a5", "message": "Update dependencies", "created_at": "2025-10-13T01:12:12Z", "repo": "lines", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3ce4da6a5dc06e664c7221f95a3aabafd0d95936", "message": "Merge pull request #781 from ryanfowler/rust-1.90.0\n\nUpgrade Rust to v1.90.0", "created_at": "2025-10-13T01:10:01Z", "repo": "lines", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5b5ab9ae4f3030fbfebc416eec403a1b29669843", "message": "Apply rustfmt changes", "created_at": "2025-10-13T01:09:04Z", "repo": "lines", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "673387f81aa3c15b505088b5b5d42c17c875b4b7", "message": "Apply clippy fixes", "created_at": "2025-10-13T01:08:16Z", "repo": "lines", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ac9fb0de76542a9824fd37b83a362efe1d5184b7", "message": "Upgrade Rust to v1.90.0", "created_at": "2025-10-13T01:05:05Z", "repo": "lines", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "08e167644e9e2dc44e3d9f2efaad243140998116", "message": "Merge pull request #761 from ryanfowler/exclude-fix\n\nEnsure directories are excluded by name", "created_at": "2025-07-10T13:53:15Z", "repo": "lines", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5b4c7ee3a39c3a2ef7e56e2d1c60020055c67039", "message": "Ensure directories are excluded by name", "created_at": "2025-07-10T13:51:59Z", "repo": "lines", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f29abe9e3c8f84e1620d84f5c9ec1cece70c7f48", "message": "Merge pull request #760 from ryanfowler/add-exclude-flag\n\nAdd --exclude flag for custom pattern filtering", "created_at": "2025-07-10T03:08:51Z", "repo": "lines", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "526f1eba1a19f0360cb15d439d7e2066cbb3a3b0", "message": "Add --exclude flag for custom pattern filtering\n\nThis adds a new --exclude flag that allows users to exclude files from line\ncounting using exact filename matching. The flag can be used multiple times\nto specify multiple exclusion patterns.\n\nFeatures:\n- Added --exclude/-e flag to CLI arguments\n- Supports multiple exclusion patterns\n- Exact filename matching for optimal performance\n- Works with both table and JSON output formats\n- Updated README with usage examples\n\n\ud83e\udd16 Generated with [Claude Code](https://claude.ai/code)\n\nCo-Authored-By: Claude <noreply@anthropic.com>\n\nMake command fail on invalid regex patterns\n\nUpdated the exclude flag implementation to fail fast when any regex pattern\ncannot be compiled successfully, providing better user feedback and preventing\nsilent failures.\n\nChanges:\n- Modified compile_exclude_patterns to return Result<Vec<Regex>, String>\n- Updated visit_path_parallel to return Result and propagate regex errors\n- Added proper error handling in main.rs with exit code 1 for invalid patterns\n- Maintained clear error messages showing which pattern failed and why\n\nBehavior:\n- Program exits with code 1 if any regex pattern is invalid\n- Program exits with code 0 for successful execution\n- Clear error messages indicate which pattern failed and the specific error\n- Fails fast - stops on first invalid pattern rather than continuing\n\n\ud83e\udd16 Generated with [Claude Code](https://claude.ai/code)\n\nCo-Authored-By: Claude <noreply@anthropic.com>", "created_at": "2025-07-10T03:07:11Z", "repo": "lines", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c2f08fb686f28dc47cae7385232d6a4f4c64dbc5", "message": "Merge pull request #759 from ryanfowler/update/cargo-lock-dependencies\n\nUpdate Cargo.lock dependencies", "created_at": "2025-07-09T23:48:07Z", "repo": "lines", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "98da905ce8f8c15ae3cbeb62b5d78527f9e9fb3e", "message": "Update Cargo.lock dependencies\n\nUpdate cc crate from v1.2.27 to v1.2.29 to incorporate latest fixes\nand improvements.\n\n\ud83e\udd16 Generated with [Claude Code](https://claude.ai/code)\n\nCo-Authored-By: Claude <noreply@anthropic.com>", "created_at": "2025-07-09T23:46:48Z", "repo": "lines", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ae0ad58eb8816e66fad8bbef474b81fe6e357931", "message": "Merge pull request #758 from ryanfowler/fix/exact-dependency-versions\n\nFix dependency versions to exact versions", "created_at": "2025-07-09T23:45:07Z", "repo": "lines", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b8b64bf40320300b8bf2aec3ee09573b168968c6", "message": "Fix dependency versions to exact versions\n\nUpdate all dependencies in Cargo.toml to use exact versions instead of\ncaret requirements to improve build reproducibility and prevent\nunexpected breaking changes from minor version updates.\n\nAlso add .claude/ to .gitignore to exclude Claude-specific files.\n\n\ud83e\udd16 Generated with [Claude Code](https://claude.ai/code)\n\nCo-Authored-By: Claude <noreply@anthropic.com>", "created_at": "2025-07-09T23:43:52Z", "repo": "lines", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e53b709f0702b4b0b3d945ebaee102193aa8b591", "message": "Merge pull request #757 from ryanfowler/replace-jemalloc-with-mimalloc\n\nReplace jemalloc with mimalloc", "created_at": "2025-07-09T23:39:26Z", "repo": "lines", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c4a50db0f95ccbf0515798b704661b4f6307b3dd", "message": "Replace jemalloc with mimalloc for better performance\n\nSwitch from jemallocator to mimalloc as the global allocator. This change:\n- Replaces jemallocator dependency with mimalloc in Cargo.toml\n- Updates the global allocator in main.rs to use mimalloc::MiMalloc\n- Removes Windows-specific conditional compilation for allocator\n\n\ud83e\udd16 Generated with [Claude Code](https://claude.ai/code)\n\nCo-Authored-By: Claude <noreply@anthropic.com>", "created_at": "2025-07-09T23:38:04Z", "repo": "lines", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e514ddd80f3275421f954c4a69ff5a21f5ada785", "message": "Release v0.3.16", "created_at": "2025-07-09T02:08:18Z", "repo": "lines", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "08da96ca85350e62386a06498820f67671b4b349", "message": "Merge pull request #756 from djgaven588/master\n\nAdd support for scripting language 'Rhai'", "created_at": "2025-07-09T02:06:40Z", "repo": "lines", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9432cfb576e528d574d51355815b1f34cabb64a4", "message": "Merge pull request #755 from ryanfowler/rust-1.88.0\n\nUpgrade Rust to v1.88.0", "created_at": "2025-06-26T21:42:53Z", "repo": "lines", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "63adb23d37bf0bbdef6fb7a9f83df58b4616ce10", "message": "Upgrade Rust to v1.88.0", "created_at": "2025-06-26T21:40:44Z", "repo": "lines", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c98b4af7696a6c961ed7620fadfaf1cb8f8099a4", "message": "Upgrade Rust to v1.87.0", "created_at": "2025-06-21T03:48:56Z", "repo": "lines", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f1f04bc0b1f792b5e92dde25f446d4da5dcf2dd9", "message": "Update dependencies", "created_at": "2025-06-21T03:48:43Z", "repo": "lines", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "21248f59edf5744ba51911919c750c0cc7a8f76b", "message": "Release v0.3.14", "creat