2:08Z", "repo": "kingjuke", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "352662c59893ce57666493f3d6abf90670583d72", "message": "PoC of Go re-implementation\n\nThe server was partly reimplemented in Go in order to ease Linux/Windows\ncross-compatibility and installation.\n\nFor now, only very basic features have been implemented:\n\n    * Adding a song\n\n    * Playing the next song\n\n    * Pause / unpause / toggle pause\n\nSome design choices have been made: no more online streaming (there were some\ncrashes and it made the program rely on VLC and libvlc). The songs are now\ndirectly downloaded and played from the local machine. A caching system and\noption will soon be implemented.\n\nThe API will also be reimplemented.", "created_at": "2018-04-27T13:16:47Z", "repo": "kingjuke", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "aa83063e2b6417e3ebefc3a3e93cdd26309926dc", "message": "Updated author email", "created_at": "2017-09-22T12:02:57Z", "repo": "kingjukeclient", "file_sampled": false, "has_test_file": null, "has_impl_file": null}], "prs": []}