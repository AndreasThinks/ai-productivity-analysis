eated_at": "2024-02-21T21:28:17Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4b407bbdb189d3b3171755469fbadcd2680abf62", "message": "Add RAG::parse_website", "created_at": "2024-02-21T16:56:06Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9b04f1388677321367a328ee69d7e2167f5cbc45", "message": "Add max_length param to Koboldcpp GenerateRequest", "created_at": "2024-02-21T16:55:16Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0ba787182d4e8efd1a04782c89984af079c9968c", "message": "Replace reqwest by ureq\n\nThis allows us to drop async/await and tokio\ncurrently the only use was to send generate request to Koboldcpp\nsince we only send requests seconds apart we don't gain anything\n\nLater we'll send requests to download websites\nbut we'll have to process them and this will take a significant amount of time anyway", "created_at": "2024-02-18T06:02:58Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "819a170454f992d46dadac3c268a3dd4727c1586", "message": "Remove empty main.rs", "created_at": "2024-02-18T02:45:45Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "bb1f6287bc578acef04af29936ad6bb4488efa28", "message": "initial commit for real", "created_at": "2024-02-17T07:11:37Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "05fd76ce3b409440eca6b744c0f2295bae72126c", "message": "initial commit", "created_at": "2019-02-09T22:25:10Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "09ceeac082a6a26a0c279a14717ebc257875598b", "message": "fix typo", "created_at": "2019-03-19T00:54:41Z", "repo": "co_sort", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f236eb966fee14438c19543b96d97f69ca0a33d1", "mes