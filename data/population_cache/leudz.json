{"login": "leudz", "location": "France", "commits": [{"sha": "fa05ec3a4b51175356809ac7bdb3c755aa2f217a", "message": "Update ureq to v3", "created_at": "2025-01-29T04:02:58Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8b1c3e27963cb96f3b881976e3672f8e5dc3a0f1", "message": "Handle generate request per template\n\nCoT models benefit from adding sentences or symbols to the prompt\nlike <think>\nThis shouldn't appear in the history", "created_at": "2025-01-23T15:21:24Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b4eebc8e74760ba1bc8a7b3b2f03c01435f4a778", "message": "Remove spaces in Deepseek prompt template", "created_at": "2025-01-23T15:06:41Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "fa1f422c537b9f10e6d6e7b3dc71ed6cfad365c6", "message": "Add Deepseek qwen distill model", "created_at": "2025-01-22T18:08:56Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "882767b951d0f7ab617ee5264874ee7891ccb873", "message": "Add RAG reranking\n\nTo find the best documents that match a user query, cross encoder models are the best\nBut they don't scale well\n\nInstead most people use other search methods, like BM35 and encoder only embeddings, to find some good enough match\nThen the cross encoder (or reranker) model can run on these results", "created_at": "2025-01-21T18:36:57Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5c5c5f4a2086a9419a4abbfb9b31e75b96a214b1", "message": "Add fastembed to gitignore", "created_at": "2025-01-21T18:32:08Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7f89aff082f8a7ba89118bc2734b5c5969ed0aa0", "message": "Make STT work again\n\nSTT was commented out for some time\nSTT is now connected to the rest of the pipeline\n\nSwitch from burn-whisper to whisper.cpp to get the new turbo model\nThe rust bindings (whisper-rs) isn't update to date and is missing some fixes, at least on AMD GPU", "created_at": "2025-01-21T00:04:45Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "28c202699efaf7b4e634dee8ef066d3d87adfa30", "message": "cargo update", "created_at": "2025-01-20T23:42:57Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "879f0312fef5205fe4eb3ff096ef26a31ce7c575", "message": "Remove leftover dbg", "created_at": "2025-01-20T23:39:23Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "466a188ff046c06bd4c0f6f59c977839aca2a79c", "message": "Move Youth to its own module", "created_at": "2025-01-18T15:10:31Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a769354d29d90879f5e76b2b7ade391ace271160", "message": "Switch Piper TTS for Kokoro TTS\n\nKokoro is a new model based on the StyleTTS 2 architecture\nIt has ranked 1st in TTS Arena\n\nPiper remains a lot faster and has more voices available but Kokoro has the best quality", "created_at": "2025-01-18T14:25:29Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d0a2c32a8ba4e50b07a019e323c9feaa1f281b61", "message": "Implement CoT for Phi 4", "created_at": "2025-01-17T15:33:32Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2df0a6714f854b98683fd136abb224ca80c9fd32", "message": "Improve KTANE prompt", "created_at": "2025-01-17T15:27:55Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4408de30a4634a87cbd18ca45b336ab51321a355", "message": "Add Phi 4 model", "created_at": "2025-01-15T17:52:27Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "33d91af393bd33ef467d5d1e5e8b4e1bdc86e388", "message": "Increase output length for CoT", "created_at": "2025-01-15T17:50:49Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a57ec9ef5d98bae5df1b4bddfc0b024670743b2b", "message": "Improve KTANE prompt", "created_at": "2025-01-15T15:45:13Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9a61dac98d88340151c2db2d41e928eb739cb473", "message": "Add modes", "created_at": "2025-01-10T10:33:33Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7f32949535962331b0ea8f6c4553d7666190cd17", "message": "Add llama 3.1 model", "created_at": "2025-01-10T10:33:02Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1889443930855cb4f554a9ac486fd73a7871f5a8", "message": "Split lib.rs in multiple modules", "created_at": "2025-01-07T11:22:56Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5fafd3ffdca5b6989a7cb5ac1447b1ec5a6476ea", "message": "Rename History to Prompt", "created_at": "2025-01-07T11:09:27Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "76eb95ecb06c82c70a537392fb64e0b7bfd7c3b6", "message": "Refactor assistant prompt", "created_at": "2025-01-07T10:58:33Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5a3259f4a58ac758daa21377113f16bd2bd0a271", "message": "Try to make the AI a bit less cringe\n\nMost LLM have a default dry tone\nRecent models like llama 3 or o1 are trying to reverse this\nI simply nudge the models with prompt engineering\nBut \"sassy\" was going a bit too far", "created_at": "2025-01-04T23:50:10Z", "repo": "youth", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9a7d23cc6f64fabd8a908b7242bddffe138feb9d", "message": "Add Nemo and update Koboldcpp", "created_at": "2025-01-04T07:52:42Z", "r