, "created_at": "2021-02-28T06:00:57Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "07cd5c0f4dd2b344cc2af36d851bdb31a2e29b93", "message": "Add the gradle-update-checker github action", "created_at": "2021-02-28T05:11:15Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4e9cbab7fa435c2800c00242d5519e3156b170ab", "message": "Publish to the portal directly (fixes #473)", "created_at": "2021-02-26T08:40:20Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "622f1670de3a4fbac4c82fbbbf3d95d4dd655093", "message": "Release 0.37", "created_at": "2021-02-23T03:59:31Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "055fbb7f468919ec5d1972d0a26e8fcaeb9d10f2", "message": "Ignore when kotlin-stdlib has a null version (fixes #443)", "created_at": "2020-11-08T22:42:48Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6c4a1e89c8d961313fa4d3c2a37283680b4e8997", "message": "Copy Kotlin variant metadata from alternative source (fixes #442)", "created_at": "2020-11-07T19:22:20Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4f2d15c3e234409f8c2fb4655cbd1dc9772281c3", "message": "Copy legacy Kotlin variant metadata (fixes #438)", "created_at": "2020-11-02T10:19:33Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0a290fb86d8ba3962fead9d3c2be8fa91f1ab5e5", "message": "Copy over only Kotlin external dependencies from super configurations\n\nThis avoids project resolution failures or variant failures from\ncapabilities conflicts. As Kotlin stashes its stdlib magically as an\nimplicit dependency that appears at runtime (versus a default dependency\nas per Gradle's idioms), we have to special case its inclusion for those\nprojects.", "created_at": "2020-09-13T09:46:24Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a23c5550e784f0d4ce444cefa0afeb13656af4cb", "message": "Copy configuration attributes for variant resolution (see #334)", "created_at": "2020-09-13T01:54:14Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "85ddff268db652f06f3b9f7e9782f12543cf3f04", "message": "Resolve with the classifier and extension if specified (fixes #224)", "created_at": "2020-09-13T00:31:08Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3e9bdf80a5f34e77629d9733cd8a10ebfff7cd22", "message": "Retain inhertited dependencies from super configurations (fixes #423)", "created_at": "2020-09-12T23:26:30Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9effd941ff765dafb3149ac9246da5c7f288e333", "message": "Copy dependency attributes for dynamic query (fixes #334)", "created_at": "2020-09-08T04:44:35Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "db3d3a1ea5e83a5fd04c4016bfd392c063d234fa", "message": "Release 0.29.0", "created_at": "2020-07-16T22:52:38Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "dcd8db1da3e701df3eb6df6a7e52907244d0dbc5", "message": "Fix NPE caused by malformed repository metadata (fixes #409)", "created_at": "2020-07-16T22:52:30Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "bafd707be0504f7bda7bad073ebe5e49a0b3aa4d", "message": "Release 0.27.0", "created_at": "2019-10-16T04:32:33Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3add857ecdc8791ae979ce363de2feed816e0bd3", "message": "Remove unnecessary escapes in regex (fixes #354)", "created_at": "2019-10-16T04:30:53Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d97e7f338594e9c7e77ba7f8b1fe7a10c69a0d4b", "message": "Release 0.26.0", "created_at": "2019-10-10T05:18:57Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6e5dfb0a6435393ad287aa5e1e44a62ff714fddf", "message": "Log the stacktrace for unresolved dependencies", "created_at": "2019-09-18T16:20:13Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f8d60b362839db8e77134211695235cfebf1a214", "message": "Fix groovy example in readme", "created_at": "2019-09-01T11:49:40Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "246b1ad37cb73b507c3a7ba3bc19204e19f3874c", "message": "Backwards compatibility of direct closure assignment (fixes #331)", "created_at": "2019-09-01T03:06:42Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "88811895430dd56eaf2cb69da2156e8c1529d692", "message": "Release v23", "created_at": "2019-08-29T22:43:58Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1318ed1d9b03ff1997693b249edf5d34423495d3", "message": "Fix flaky tests\n\nFor some reason running Gradle 3.0 and 5.6.1 causes the integration\ntests to fail locally.\n\nTravis builds broke with the default OS changing to Xenial, so going\nback to Trusty to see if that stabilizes it.", "created_at": "2019-08-29T21:52:58Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "95a62d4666bbd821159f861a65c298715e58359f", "message": "Release v22", "created_at": "2019-08-06T16:11:11Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "fa17d545d981cb5feffe5cd0011d8954bc00b171", "message": "Remove incompatible parallelization (fixes #255)\n\nUnfortunately the GPars trick is not safe, causing deadlocks with other\nplugins. The safest solution is to remove and eventually use newer\nGradle apis that expose some parallel support. The core performance\nissue, though, is that Gradle does not resolve dependencies in parallel\nso doing project & configurations was a marginal gain.", "created_at": "2019-02-27T06:06:17Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "03052db27e929ee58f9416a559114fb79bb6c6eb", "message": "Add deblibs-gradle-plugin to extensions \n\n@eyedol", "created_at": "2019-01-31T07:27:02Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5640630d2cd2d10f6ea94f0e3f358d0e355cd006", "message": "Add gradle-kotlin-dsl-libs to integrations (#259)", "created_at": "2018-10-04T22:19:25Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "cc2d88d321cd3deb6a72baef6b5d12f5a2dc1fbc", "message": "Release v20", "created_at": "2018-06-19T16:35:55Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5f8e46af2ca9c88620dcc9a845e701aecdf1c806", "message": "Add flag to disable gradle update check (fixes #241)\n\nThe task property `checkForGradleUpdate` is defaulted to `true`. When set to\n`false` no check is performed, the plain text report, does not include the\nstatement, and the json/xml report includes an enable flag, no version, and\nthe reason.\n\nDue to URLConnection defaulting to infinite timeout that can cause a hung build,\nthe maximum connection and read timeouts are set to 15 seconds as a failsafe.", "created_at": "2018-06-19T06:32:01Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "296d04270ac499b2326f479db7109c5015bc54ad", "message": "Use non-strict parsing of pom.xml (fixes #238)", "created_at": "2018-06-15T16:48:49Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "96995f473da0260f9482b4db5e60e35c615fcedd", "message": "Release v18", "created_at": "2018-06-14T01:21:09Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "02227069a180eb6caf579eec746a65c38a304368", "message": "Resolve Gradle 4.6+ BOM style dependencies (fixes #231)", "created_at": "2018-06-14T01:11:05Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "97a93dceeb6ddc22150355f623b228ae24efd809", "message": "Touch up the readme", "created_at": "2018-06-12T19:40:14Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a891c8218f35ec4816de04bb55fdc96fb55540a9", "message": "Parallelize and cache project url resolution\n\nThe artifact query is not cached by Gradle, making it a slow sequential\ncall to multiple http endpoints (repositories). A dependency may be in\nmultiple configurations, causing repeated lookups. This change helps in\na JDK6 compatible fashion by caching the lookup and using the GPars pool\nto query in parallel. Unfortunately, I think the query is synchronous\nwithin Gradle, so the pool does not assist much.", "created_at": "2018-06-12T16:50:05Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c8c344ac6dd62a9f5beb1ee0384dce566f7b01a3", "message": "Indent the project url to improve readability", "created_at": "2018-06-12T06:44:45Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ca1d99d934d0552ad232fca17078209b43469efc", "message": "Parallelize configurations across all projects", "created_at": "2018-06-12T06:28:53Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "144866de1e8bae2d2ab03bdf19e410b875e80178", "message": "Optimize the maximum number of threads to use", "created_at": "2018-06-12T05:27:18Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4c24d94b139c5709576a2cab43d96f531828409a", "message": "Fix unresolved dependencies having group/name flipped (fixes #223)", "created_at": "2018-06-12T05:07:17Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "536bbac0df1875514886e6da0b030e5e6ebb617d", "message": "Add back type checking of the task", "created_at": "2018-06-12T04:56:05Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9f0aa472d38b33e1477754ab19950e6a12b8a304", "message": "Minor pretty print improvement", "created_at": "2018-06-12T04:27:58Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "61405e79ffbad726a7a4ffef75b34c18e6921aef", "message": "Fix sample json formatting", "created_at": "2018-03-22T01:15:18Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f37ed2aab4ea461f61e219fedda1490ce154623a", "message": "Promote community extensions\n\n@patrikerdes\n@fkorotkov\n@y-yagi", "created_at": "2018-03-21T20:36:09Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "29963fc479567dc48c41cca62bd768060610f5aa", "message": "Fix sort order in text report (fixes #165)", "created_at": "2018-03-10T05:06:11Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "80e8aa00a6ae99d969a38d5c22bfb55a2048923d", "message": "Task should never be up-to-date (fixes #187)", "created_at": "2017-10-25T18:01:49Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3cce551e9ced67e38dc99022018f209fd103bea1", "message": "Support Gradle 4.3-rc2 by not marking a closure as an task input (fixes #185)\n\nThanks to @jochenberger for finding this issue, and @bmuschko and @lptr for\nfiguring out how to fix it.", "created_at": "2017-10-18T19:09:36Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a50727d410151666cb5e085120905dbeba36d072", "message": "Support Gradle 4.0-rc-1 (fixes #162)", "created_at": "2017-05-31T04:50:21Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "eae7a087ee80a148740a960910027ff9cf97da7b", "message": "Update release version to 0.13.0", "created_at": "2016-07-06T08:37:46Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e2032c3987808ffff989c3626a90b223530d134a", "message": "Compatibility with dependency-management-plugin (fixed #97)", "created_at": "2016-07-02T21:21:53Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "21d6c09251796f929a25676e96a81cff7749cbe9", "message": "Fix duplicate listings for unresolved dependencies (fixes #91)", "created_at": "2016-01-14T17:57:12Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "894fbdf833e897713d0a7d19a551bf7be4de0464", "message": "Update documentation", "created_at": "2016-01-13T08:08:20Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0070f9aab541dc09e8126cb496a85b6c034395ae", "message": "Add option for task scoped resolution strategy (fixed #68, fixed #75)", "created_at": "2016-01-13T06:20:31Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "559a286e8885e53ec08c708f44e098ab0432f24d", "message": "Report output to using project.buildDir (fixes #80)", "created_at": "2016-01-13T05:44:17Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c5f7d4c05da636cd86327b9d9b9c3ffc2b6d0cd6", "message": "Pretty console report when no dependencies found (fixes #52)", "created_at": "2016-01-13T05:11:45Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "42ed08e93c70d2c309e04fd35c8e03fa217018c3", "message": "Do not aggregate repositories (fixes #66, #78, #79, #90)", "created_at": "2016-01-13T04:29:18Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "486024fb017e18431280009e7e005244d21ef896", "message": "Show multiple versions of dependency in same report group (fixes #65)", "created_at": "2015-06-30T03:27:07Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6249164ec02954e5efbbdbd00206791164139424", "message": "Skip hidden dependencies", "created_at": "2015-06-29T07:40:19Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d3f284c4d7bf0196071415fca12e03381b6662ce", "message": "Add backwards compatibility Gradle prior to 2.2 (fixes #67)\n\nI'm not confident that this works due to the Groovy backwards\ncompatibility shim. This is a best effort, as users can either\nupgrade Gradle or use an old plugin version.", "created_at": "2015-06-28T14:22:32Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "122ba358bdd5d0a34dbb39b441f9aaf4cc31b597", "message": "Handle failures gracefully\n\nFor some reason when running on Gradle itself (master) some configurations\nfail to resolve and throw an exception, instead of the usual unresolved\ndependency. Instead of a build break log the error and continue.", "created_at": "2015-06-28T13:23:11Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "14f8a684df740ca127b1d44c3ffbf9ce8dfc06a3", "message": "Ignore hidden dependencies on a configuration (e.g. jacoco)", "created_at": "2015-06-28T10:35:59Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2e79cf0b63fa95febe7ab530a54204c2eb4eecd1", "message": "Fix reporter grouping", "created_at": "2015-06-28T08:34:44Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4e1c56fec4256a285abc563d4a57099a3e460cdb", "message": "Fix version mapping (closes #65)", "created_at": "2015-06-28T08:30:03Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "607ec09b041500501016d4cf4b4383dfd56e8c56", "message": "Add note that downgrading is okay", "created_at": "2015-06-25T17:55:29Z", "repo": "gradle-versions-plugin", "file_sampled": false, "has_test_file": null, "has_impl_file": null}], "prs": []}