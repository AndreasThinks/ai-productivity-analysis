{"login": "joostlek", "location": "Utrecht, The Netherlands", "commits": [{"sha": "2f067993b2d6782bf967acf0004a4da4d284c9cd", "message": "Published with https://stackedit.io/", "created_at": "2016-06-22T14:26:33Z", "repo": "Cryonite", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1da0bbd99dc349a0fa767a2e2ad2d992ef8bd812", "message": "Introducing Remote Kicking and Shared Settings\n\nWant to kick someone silencly without anyone noticing? Kick them in your modgroup.\nWant to edit your group settings but your group is getting annoyed by the amount of messages I produce? Edit them in your modgroup!", "created_at": "2016-06-17T20:47:17Z", "repo": "Cryonite", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "95bf80aea9f19a8a1fad2546346f16263e4c4f18", "message": "Added /modset\n\nEdit your Modsettings easily with /modset", "created_at": "2016-06-17T10:48:25Z", "repo": "Cryonite", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "001ea0b811bf20ea27e5f7a13e225731775c2e42", "message": "Updated Administration to 1.10.4\nBugfixes", "created_at": "2016-06-17T07:57:41Z", "repo": "Cryonite", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8860dbb2537b64954ce25414c0c04577cee5e50f", "message": "Added /modgroup\nUpdated Otouto to 3.10+", "created_at": "2016-06-16T17:50:19Z", "repo": "Cryonite", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "fa4b8ac3c333100c67f9d80c621ab41d43b5bd21", "message": "Revert \"Added /modgroup - Have Cryonite output kick/ban/unban messages to yourself or to a modgroup\"\n\nThis reverts commit d97b6f7c7b3ab05cb035f8110e27f8d07c56e569.\n\nReverted because of test", "created_at": "2016-06-16T17:46:51Z", "repo": "Cryonite", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d97b6f7c7b3ab05cb035f8110e27f8d07c56e569", "message": "Added /modgroup - Have Cryonite output kick/ban/unban messages to yourself or to a modgroup", "created_at": "2016-06-16T17:30:58Z", "repo": "Cryonite", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0fa4b7f6b67805bb346f6680dd0e8fdc1956fe78", "message": "Added Otouto", "created_at": "2016-06-08T07:25:25Z", "repo": "Cryonite", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5454a9d6f2becd190bb5e5d137193a505125504c", "message": "Revert \"Added the bot\"\n\nThis reverts commit 7151acce15c06d646c63be7c7f49e72538fcca47.", "created_at": "2016-06-07T17:20:29Z", "repo": "Cryonite", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7151acce15c06d646c63be7c7f49e72538fcca47", "message": "Added the bot", "created_at": "2016-06-03T21:09:03Z", "repo": "Cryonite", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b03d5583b069c2163e3fb3d04719ef53f529b1b0", "message": "Version A0.07\n + Redesigned the WalletActivity.\n + Added date before a day of transactions\n + Added a Quick Add Card to the new and upcoming Rainbow Dashboard", "created_at": "2017-10-05T23:57:09Z", "repo": "MoneyManager", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "679776aea5c6482cd03b80941ecc42a5d1768ea9", "message": "Version A0.06\n + Added transaction adding menu\n + Outgoing tab works\n + Added Category storage to the Database Handler\n + Added a bit of Documentation\n ~ Fixed small bug where the next walletId would be the length + 1, now it starts at zero\n ~ Changed the last FAB to Recurring Transaction", "created_at": "2017-10-03T23:53:17Z", "repo": "MoneyManager", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "09c88e90ee36568ce7bb02bdffcd8ce0d520c229", "message": "Version A0.05\n + Added Floating Action Button Menu for adding Wallets and Transactions\n + Changed colors\n + Added GetTransactions(int walletId) for all transactions for that wallet", "created_at": "2017-10-02T22:59:11Z", "repo": "MoneyManager", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c72d858741fe53667392ba9ec53554165fa668e6", "message": "Version A0.04\n + Added different currencies\n + Added total on top of the wallet view\n + Added date to Transaction\n + Added way to add wallets", "created_at": "2017-10-02T16:16:22Z", "repo": "MoneyManager", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "df7ba8eadbed9513604c3b1c1395ba2ef13b56dd", "message": "Version A0.03\n + Added Wallet Activity\n ~ Transactions now store the categoryId instead of the category itself\n ~ Changed minimum SDK version to 21 and target SDK version to 26, and updating the tools to that version", "created_at": "2017-10-01T21:20:18Z", "repo": "MoneyManager", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2a81cb235d22c1aea2c38e20ac638c604c3c3ea6", "message": "Version A0.02\n + Added SQLite database storage\n ~ Source/Destination wallets now use IDs instead of complete wallets", "created_at": "2017-10-01T00:31:46Z", "repo": "MoneyManager", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4e67b316da42313ba7e5158bcd9931f45317823e", "message": "Version A0.01:\n + Basic objects for the basic transactions", "created_at": "2017-09-30T23:42:48Z", "repo": "MoneyManager", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "fcf60949ff4461940ea9914aa5fc2616f893b299", "message": "Initial commit", "created_at": "2017-09-04T14:40:04Z", "repo": "MoneyManager", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6a0d16776f63039fef1347e1863746307e4bbd2e", "message": "Fin.", "created_at": "2017-10-27T14:19:07Z", "repo": "python_school", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8d256a6270e6610d947c7cb5cf72ac611c18dd0f", "message": "Practice Exercise 9 af. En die perkovic ook", "created_at": "2017-09-30T17:15:17Z