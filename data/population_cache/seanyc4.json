: false, "has_test_file": null, "has_impl_file": null}, {"sha": "f8176c2b1a4e3f66cb4d7b574a90611653074a0a", "message": "Merge pull request #449 from seanyc4/ui-refinement\n\nui-refinement", "created_at": "2026-04-04T07:50:07Z", "repo": "Orbital", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4c62ebe050aa66ebd37cf87959238647c6b2fb1d", "message": "adjust heor logic to add a 30 minute delay before filtering it out", "created_at": "2026-04-04T07:37:57Z", "repo": "Orbital", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8863a806f61362f54eff390df24ef96cc917b22f", "message": "adjust NewsSection layout", "created_at": "2026-04-04T07:32:48Z", "repo": "Orbital", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "38327a2b1f280077fc427414dbf84bc544ada62f", "message": "fix live indicator position", "created_at": "2026-04-04T07:25:54Z", "repo": "Orbital", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f12414778262c7c6448e95fd64b555b3285b00e4", "message": "Merge pull request #448 from seanyc4/live-badges\n\nadds live pulsing pill to launch heros", "created_at": "2026-04-03T20:27:45Z", "repo": "Orbital", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5983ccc92bb0d132d43218cf25357aa08deb2ba4", "message": "adds live pulsing pill to launch heros", "created_at": "2026-04-03T20:23:51Z", "repo": "Orbital", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "89d3776fa40dd37479aa1059100c19e6c971d202", "message": "Merge pull request #447 from seanyc4/notifications_v2\n\nnotifications_v2", "created_at": "2026-04-03T19:39:32Z", "repo": "Orbital", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8e50ad083c60690702e245a24618b305599b597c", "message": "feat: refresh launch data when reminder notification fires\n\nWhen a notification reminder fires, the receiver now enqueues a\nOneTimeWorkRequest that fetches the latest launch data from the API\nand caches it locally. This ensures that when the user taps the\nnotification and deep-links into the launch screen, they see the most\nup-to-date information.\n\nArchitecture:\n- LaunchRefreshWork (core:notifications) \u2014 helper that enqueues work\n  using the worker's FQCN to avoid cross-module class dependency\n- RefreshLaunchWorker (:app) \u2014 HiltWorker that calls getLaunchUseCase\n  with isRefresh=true, which fetches from API and upserts to Room\n- LaunchReminderReceiver now calls LaunchRefreshWork.enqueue() after\n  showing the notification\n\nAdded WorkManager runtime dependency to core:notifications module.\nTests: 6 new RefreshLaunchWorkerTest tests (success, failure, missing\ninput data, invalid input data).\n\nCo-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>", "created_at": "2026-04-03T19:28:56Z", "repo": "Orbital", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4dd1d2433cdea12f6dca7f3248defb991e1352ca", "message": "fix: cache launch detail after network fetch\n\nfetchLaunchFromNetwork now upserts the response into the local detail\ntable (Upcoming or Past) after a successful API call. Previously,\nnetwork responses were returned but not persisted \u2014 meaning the sync\nworker's API calls and manual refreshes didn't update the cached data.\n\nThis ensures the UI always reflects the latest launch details after\nany network fetch, including during the 3-hour subscription sync.\n\nUpdated LaunchesRepositoryImplTest to stub and verify the new upsert\ncall in all network-fetch test scenarios.\n\nCo-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>", "created_at": "2026-04-03T18:07:18Z", "repo": "Orbital", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3f41cd43d01f78c72a8f6db1da2933f52b713c3a", "message": "adds notification sync work manager", "created_at": "2026-04-03T17:32:48Z", "repo": "Orbital", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "727970b2c8c1e0cb4ccd909c4e5a18e005cb3cce", "message": "adds usecase and logic to delete notification cache", "created_at": "2026-04-03T16:47:02Z", "repo": "Orbital", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8d6f6aecbe17256ec3af0e358d11c15814eb609e", "message": "adds workmanager logic", "created_at": "2026-04-03T16:41:41Z", "repo": "Orbital", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8deef8eee439fbb34a497a076a7a24fd27f1e728", "message": "adds workmanager", "created_at": "2026-04-03T16:39:48Z", "repo": "Orbital", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "61169e40aef9338259765b8a1eb29f2f0402a5e5", "message": "Merge pull request #446 from seanyc4/cleanup-2\n\ncleanup-2", "created_at": "2026-04-03T15:13:27Z", "repo": "Orbital", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "17b9d2823a6f6838cfc169c05306230ebbd06d98", "message": "moves location of status chip to above title", "created_at": "2026-04-03T14:50:21Z", "repo": "Orbital", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3ee24d86d016520dfdbd3d76047231dbbac2745c", "message": "Merge remote-tracking branch 'origin/cleanup-2' into cleanup-2", "created_at": "2026-04-03T14:48:39Z", "repo": "Orbital", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0492035bc18b4280409a98170531335c46ee55d9", "message": "adds default color", "created_at": "2026-04-03T14:32:55Z", "repo": "Orbital", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5edb6be6ba717d81b7864da0beff4d6d07093458", "message": "updates chip", "created_at": "2026-04-03T14:05:57Z", "repo": "Orbital", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ddaf077dbf8c1713b2a6305f58f138d8942faa0e", "message": "updates chip", "created_at