31\u0430\u0432\u043b\u0435\u043d \u043c\u0435\u0442\u043e\u0434 getInfo() \u0434\u043b\u044f \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u0438 \u043e NFT\n- \u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d \u043c\u0435\u0442\u043e\u0434 getList() \u0434\u043b\u044f \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u0441\u043f\u0438\u0441\u043a\u0430 NFT \u0441 \u043f\u0430\u0433\u0438\u043d\u0430\u0446\u0438\u0435\u0439\n- \u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d \u043c\u0435\u0442\u043e\u0434 getHistory() \u0434\u043b\u044f \u043f\u043e\u043b\u0443\u0447\u0435\u043d\u0438\u044f \u0438\u0441\u0442\u043e\u0440\u0438\u0438 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0439 \u0441 NFT", "created_at": "2025-12-29T23:53:39Z", "repo": "IrisSweetsApi", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0737f81ff148c4469068afe5b039d63a1e49cdfc", "message": "\u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0430 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430 \u043f\u0440\u043e\u043a\u0441\u0438-\u0441\u0435\u0440\u0432\u0435\u0440\u043e\u0432\n\n\u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0430 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u044c \u0440\u0430\u0431\u043e\u0442\u044b \u0447\u0435\u0440\u0435\u0437 \u043f\u0440\u043e\u043a\u0441\u0438-\u0441\u0435\u0440\u0432\u0435\u0440\u044b \u0434\u043b\u044f \u0432\u0441\u0435\u0445 HTTP \u0437\u0430\u043f\u0440\u043e\u0441\u043e\u0432.\n\u041f\u0440\u043e\u043a\u0441\u0438 \u043c\u043e\u0436\u043d\u043e \u043d\u0430\u0441\u0442\u0440\u043e\u0438\u0442\u044c \u0447\u0435\u0440\u0435\u0437 .env \u0444\u0430\u0439\u043b, \u043a\u043e\u043d\u0441\u0442\u0440\u0443\u043a\u0442\u043e\u0440 \u0438\u043b\u0438 \u0434\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u0438.", "created_at": "2025-12-23T23:07:44Z", "repo": "IrisSweetsApi", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "94e7d7cc56c8cf2ee692d761403e2db8fadfc678", "message": "\u041e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 API \u0438 \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0438 \u0442\u0433-\u0437\u0432\u0451\u0437\u0434 \u0438 \u043d\u043e\u0432\u043e\u0433\u043e \u0431\u0438\u0440\u0436\u0435\u0432\u043e\u0433\u043e API\n\n\u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f:\n\n1. \u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440 donate_score \u0432 \u043c\u0435\u0442\u043e\u0434\u044b give \u0434\u043b\u044f sweets \u0438 gold\n   - \u041f\u0430\u0440\u0430\u043c\u0435\u0442\u0440 \u043f\u043e\u0437\u0432\u043e\u043b\u044f\u0435\u0442 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0438\u0442\u044c \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e\u0435 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u043e\u0447\u043a\u043e\u0432 \u0434\u043e\u043d\u0430\u0442\u0430\n   - \u041f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e -1 (\u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u043c\u0430\u043a\u0441\u0438\u043c\u0430\u043b\u044c\u043d\u043e \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0435)\n\n2. \u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u0430 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u043a\u0430 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0439 \u0441 \u0442\u0433-\u0437\u0432\u0451\u0437\u0434\u0430\u043c\u0438 (TG Stars)\n   - give() - \u043f\u0435\u0440\u0435\u0434\u0430\u0447\u0430 \u0442\u0433-\u0437\u0432\u0451\u0437\u0434 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044e\n   - buy() - \u043f\u043e\u043a\u0443\u043f\u043a\u0430 \u0442\u0433-\u0437\u0432\u0451\u0437\u0434 \u0437\u0430 \u0438\u0440\u0438\u0441\u043a\u0438\n   - getPrice() - \u043e\u0446\u0435\u043d\u043a\u043