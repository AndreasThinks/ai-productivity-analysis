": "6b25ce7f2b9c321c62d356b56fe3b9807e4033ef", "message": "move type definitions in Datalog to Types", "created_at": "2012-06-12T21:26:20Z", "repo": "datalog-fixpoint", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "282fd7648d63a9b66d616f5bd7cbee281379a068", "message": "get rid of useless test case", "created_at": "2012-06-12T21:26:20Z", "repo": "datalog-fixpoint", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6e961837dcfef42112613b5cfa241c3e3a77f99f", "message": "moved `applyRule' and `fixpoint' to Datalog\n\nAs it turned out, they are more general than expected.", "created_at": "2012-06-12T21:26:19Z", "repo": "datalog-fixpoint", "file_sampled": false, "has_test_file": null, "has_impl_file": null}], "prs": []}