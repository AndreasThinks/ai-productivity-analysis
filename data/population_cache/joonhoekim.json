_file": null}, {"sha": "002877aa95d5cb7fc6132ddc4a61568b9e86f310", "message": "Study about XML configuration for IoC Container", "created_at": "2024-03-11T05:44:27Z", "repo": "mystudy", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d0d0f71e6e4182caffbafd037143b03bf7019599", "message": "\uc2a4\ud504\ub9c1\uc5d0\uc11c null\uc744 \ubabb\ubc1b\uc73c\ubbc0\ub85c \ubc1c\uc0dd\ud558\ub294 \ub85c\uadf8\uc778 \uc624\ub958 \uc218\uc815\n\nController\uc5d0\uc11c \ucfe0\ud0a4\uc5d0 \uc6d0\ud558\ub294 \uac12\uc774 \uc5c6\uc5b4\uc11c \ubc1c\uc0dd\ud558\ub294 \ubb38\uc81c\ub97c \uc218\uc815 (\ud544\uc218 \uc694\uad6c\ub97c \ud558\uc9c0 \uc54a\uac70\ub098 \uae30\ubcf8\uac12\uc744 \uc8fc\ub294 \ubc29\uc2dd\uc784. \uc560\ub108\ud14c\uc774\uc158 \ubb38\ubc95\uc5d0 \ub530\ub77c \uc791\uc131\ud558\uba74 \ub428)\n\n\uc544\ub798 \ub450 \ubc29\ubc95 \ubaa8\ub450 \uc801\uc6a9 \uac00\ub2a5\ud568. \uc801\uc808\ud558\uac8c \uc0ac\uc6a9.\n\n@CookieValue(value = \"email\", required = false)\n@CookieValue(value = \"email\", defaultValue= \"\")\n\n\ub118\uc5b4\uc624\ub294 \ub370\uc774\ud130\uac00 \uc798\ubabb\ub41c \uac83\uc778\uc9c0, DB\ucabd\uc5d0\uc11c \uc798\ubabb\ub41c\uac74\uc9c0 \ubb34\uc5c7\uc774 \uc798\ubabb\ub41c\uac74\uc9c0 \ucc3e\ub294 \uac83\uc774 \uc911\uc694\ud55c\ub370, \uc5d0\ub7ec \ud574\uacb0 \uacbd\ud5d8\uc774 \uc911\uc694\ud568...\n\n\ucd94\uac00\uc608\uc2dc: \uccb4\ud06c\ubc15\uc2a4\ub294 \uccb4\ud06c\ud558\uc9c0 \uc54a\uc73c\uba74 \uac12\uc774 \uc544\uc608 \uc548\ub118\uc5b4\uac00\uace0, \uc778\ud48b\ubc15\uc2a4\ub294 \ub123\uc740 \uac12\uc774 \uc5c6\uc73c\uba74 \ube48\ubb38\uc790\uc5f4\uc774 \ub118\uc5b4\uac10.", "created_at": "2024-03-08T03:34:10Z", "repo": "mystudy", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "50ec980fdc390f24d38238b9c5a50d08ebb34025", "message": "Spring WebMVC \ub3c4\uc785\n\n- gradle implementation : Spring \ucd94\uac00\n- DispatcherServlet \ud074\ub798\uc2a4 \ubc0f \ub2e4\ub978 \uc560\ub108\ud14c\uc774\uc158\ub4e4 \uc804\ubd80 Spring Web-MVC \ub85c \uad50\uccb4\n- web.xml \ubc0f config/app-servlet.xml \uc124\uc815 \ucd94\uac00\n@Component -> @Controller", "created_at": "2024-03-08T02:26:05Z", "repo": "mystudy", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7843093c5eabc1f42425a78d765a679f44aa8de3", "message": "Spring Framework IoC Container \ub3c4\uc785\ud568\n\nSpring Framework IoC Container \ub3c4\uc785\ud568", "created_at": "2024-03-07T06:41:47Z", "repo": "mystudy", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5fa807a41f5d6b24764a8be7b1316790108b65cb", "message": "PageController \uc790\ub3d9 \ucd94\uac00 (@Component \uc560\ub108\ud14c\uc774\uc158)\n\n\ud074\ub798\uc2a4\ub97c \ubd84\uc11d\ud574\uc11c \uc790\ub3d9\uc73c\ub85c controllers \uac1d\uccb4\uc5d0 \uc778\uc2a4\ud134\uc2a4 \ucd94\uac00\ud568", "created_at": "2024-03-06T07:07:43Z", "repo": "mystudy", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "32e16eff44287b4a220301d3260c33b4f82f7855", "message": "\uc11c\ube14\ub9bf \ud504\ub808\uc784\uc6cc\ud06c\ub97c \uc7ac\ud604\ud574\ubcf4\uae30\n\n\ud504\ub860\ud2b8 \ucee8\ud2b8\ub864\ub7ec\uac00 \uc544\uc8fc\uc544\uc8fc \ubcf5\uc7a1\ud574\uc9c0\ub294 \uc911", "created_at": "2024-03-06T05:46:15Z", "repo": "mystudy", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ba63419bfeed625e22077621795b4caf4d87839e", "message": "FrontController \uac1c\uc120\n\n@RequestParam(\"no\") int no \uac19\uc740 \ud615\ud0dc\ub85c, request \uac1d\uccb4\uc5d0\uc11c \ud544\uc694\ud55c \ubcc0\uc218 \uc774\ub984\uc744 \uc5b4\ub178\ud14c\uc774\uc158\uc73c\ub85c \uc804\ub2ec\ud558\uc5ec \ubc1b\uc544\uc634. (\uc2a4\ud504\ub9c1 \ud504\ub808\uc784\uc6cc\ud06c\uc5d0\uc11c\ub294 \uc5b4\ub178\ud14c\uc774\uc158 \uc5c6\uc774 \ub354 \uac04\uacb0\ud558\uac8c \uc4f4\ub2e4.)\n\n\uc790\ubc14 \ucef4\ud30c\uc77c\ub7ec\uc5d0\uc11c \ucef4\ud30c\uc77c \uc2dc \ubcc0\