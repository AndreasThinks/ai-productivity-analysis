file": null}, {"sha": "bc8bcf9531579e153994ade9eb6a02ee9f52d59c", "message": "Merge branch 'development' of https://github.com/barjin/pw-web into development", "created_at": "2021-08-11T22:36:59Z", "repo": "pw-web", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f470e1c9aa0d3fc4c735815e7a7ff950a112b44c", "message": "[Daily 11/08] Right-click to read element text, various tweaks and fixes", "created_at": "2021-08-11T22:36:05Z", "repo": "pw-web", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ecfbe2a600d8590b07200da18f8595632eab673a", "message": "[Daily 10/08d] GH actions troubleshoot\n\nGH Actions seems to be down, everything is OK with my current workflows.", "created_at": "2021-08-10T22:36:17Z", "repo": "pw-web", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "02a453115b43e4a221b6f589b4c3cbfa85ebc5d6", "message": "[Daily 10/08c] GH Actions troubleshoot", "created_at": "2021-08-10T22:34:07Z", "repo": "pw-web", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ff69fb1f6c93a61d107c9543c4f21bf56e7f21a9", "message": "[Daily 10/08b] GH Actions troubleshoot", "created_at": "2021-08-10T22:32:04Z", "repo": "pw-web", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b92946824601efa95c07cfe65c1300b9fe110d9b", "message": "[Daily 10/08] New recording format, better error handling, little more robust messaging channel", "created_at": "2021-08-10T22:22:13Z", "repo": "pw-web", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "883fe6424b9614df3d59f60277a7e16a9671d83c", "message": "[Daily 09/08c] Drag&Drop, removing code blocks\nFrontend changes to allow for simple recording modification.", "created_at": "2021-08-09T21:21:28Z", "repo": "pw-web", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9783d45a57da6ece035dcc57febf5831b935306d", "message": "[Daily 09/08b] Updater - da