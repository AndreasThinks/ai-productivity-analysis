led": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3aacaa7dadff136475cf585581adbe5a604a07ae", "message": "created coin class to simplfy math with values", "created_at": "2016-12-05T07:18:03Z", "repo": "CPSC240-project-zorkGroupProject", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b303ffb8372aebaa279828b17a0d22aa33c18f05", "message": "Add items for test reasons", "created_at": "2016-12-05T07:17:35Z", "repo": "CPSC240-project-zorkGroupProject", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1afcb0eb6565ca0425a6b94f27d882f9cee82aa6", "message": "quick drawing for inital level layout\n\neverything above the dotted line in the battle zone and below is city\nzone", "created_at": "2016-12-05T03:24:18Z", "repo": "CPSC240-project-zorkGroupProject", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f390a8014d1edcb7dd74b28193e19401d9493e9b", "message": "Removed return statement", "created_at": "2016-12-05T02:30:39Z", "repo": "CPSC240-project-zorkGroupProject", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3d4ddc4756c0d6a6c28d96a2f0311cced3f16b08", "message": "Random Object Generation Fucntion Started\n\nRoom constructor now reads for one word permission descriptions in\nbetween the angle brackets \"<>\" on the Room 'Contents: ' line when\nreading the .bork file. The string is separated into two parts. The\nfirst part is split again into a String array and passed to another\nhelper sub routine setRandPermissions() method which then determines\nwhich permissions should be unlocked for this room. At this time the\nonly key words which act as permission key words are coin and mob.\nNaturally the load file was updated with a few test functions. The file\nloads properly and the booleans are correctly set.", "created_at": "2016-12-05T02:25:10Z", "repo": "CPSC240-project-zorkGroupProject", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1628cf4dc499a68aa0d620a0fa2783268097fc17", "message": "Fixed coin value return amount", "created_at": "2016-12-05T00:59:30Z", "repo": "CPSC240-project-zorkGroupProject", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8eb19f49f17779f4e866e49a8972dbf77ba3c942", "message": "Remove test print statement", "created_at": "2016-12-05T00:59:07Z", "repo": "CPSC240-project-zorkGroupProject", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2bda72f649b7eb82387d1aa8265b88f21af608cb", "message": "Added coin taking functionality to take command\n\nRecognises if a taken item is a coin, if so it sends it to GS.addmoney()\nwithin the message return statement, if not the take command routine is\ncontinued as per last version.", "created_at": "2016-12-05T00:51:24Z", "repo": "CPSC240-project-zorkGroupProject", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "52175b91312c9f3846b8d8574162e7f5fede2742", "message": "Upgraded printout\n\nnow inventory command displays bank amount as well", "created_at": "2016-12-05T00:49:18Z", "repo": "CPSC240-project-zorkGroupProject", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "52717fa2f4472549cfa06ad7421aafec1c2fc5ae", "message": "Item name change\n\nChanged Dummy item name to Item for ease of testing.", "created_at": "2016-12-05T00:48:30Z", "repo": "CPSC240-project-zorkGroupProject", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1737c70469166369b8b68e83fd664f5ddc907e82", "message": "command parts parsing update\n\nuser commands which are passed to CommandFactory with more than two\nwords will now recognize every word after the second as an extension of\nthe noun. The single letter or verb command funcutionality is retained\nby giving the noun variable the value of empty string if the command\npassed to the CommandFactory is only on part(string/word/character)\nlong. Take command is retested on coin and normal objects.  Events\ntested too.", "created_at": "2016-12-05T00:48:02Z", "repo": "CPSC240-project-zorkGroupProject", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "29f74ea998f22c14421f604e7688ea987134ad73", "message": "Add and update Bank fucntions\n\nAdded a function for added to the player bank. This includes an array\ndata structure which holds the values of the coins that will be\ncolleceted in the game. Each coin in assigned a coeficient corresponding\nto the array index ('coinValue') which can be modified in GameState\ninitialization. Added and formatted comments.", "created_at": "2016-12-05T00:42:03Z", "repo": "CPSC240-project-zorkGroupProject", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a3a682c21c17765bcdc1e0136a8e562a086412d6", "message": "Added money item for testing\n\nAlso included dummy item, mostly to act as a place holder and item\ntemplate for the level loader file.", "created_at": "2016-12-05T00:38:13Z", "repo": "CPSC240-project-zorkGroupProject", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a9993a12dafec5d71e136d46c416831f53656461", "message": "merge", "created_at": "2016-12-04T22:42:30Z", "repo": "CPSC240-project-zorkGroupProject", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4ed82ad4d3be189ee98cd55e7e760cccac3eb37a", "message": "Merge pull request #3 from frenchGoat/master\n\nbox to 3b", "created_at": "2016-12-04T22:28:28Z", "repo": "CPSC240-project-zorkGroupProject", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b3840c0e4740d96d61d70a3e36a4c6139c422ade", "message": "merge", "created_at": "2016-12-04T22:25:28Z", "repo": "CPSC240-project-zorkGroupProject", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "404b9981de71857249fae050206387d8f85ab941", "message": "Merge pull request #2 from frenchGoat/3b_jacques\n\n3b ja