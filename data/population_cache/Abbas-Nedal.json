1:41Z", "repo": "RentItOut", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b880435417fec223c5444b4a564c4e3ac09dd5fd", "message": "Add Swagger documentation setup with auto-generation\n\n- Installed swagger-jsdoc and swagger-autogen for automated API documentation generation.\n- Integrated swagger-ui-express for serving Swagger UI.", "created_at": "2024-10-27T13:10:42Z", "repo": "RentItOut", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "496e07776530e67875ac295c1c93d9aef1051dfa", "message": "Very important updates.\n\n- Sequelize removed and ORM based queries replaced with raw SQL queries\n- All modules removed", "created_at": "2024-10-22T13:55:37Z", "repo": "RentItOut", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6f016428b58f6965771d032395e719e458ffee57", "message": "A number of files have been added, namely:\n1-server.js\n2-reviewRoutes.js\n3-reviewController.js\n4-logisticRoutes.js\n5-logisticController.js\n\nI have built all the APIs required for the delivery service and the review service.\nAnd made sure they are fully functional (please see the files with comments on how to make them work)\n\nA simple summary of the main things I have added:\n- Prevent users from adding multiple reviews for the same item\n- Added created_at and updated_at timestamps for reviews\n- Include review statistics (average rating and number of reviews) in the item reviews API\n- Improve the logistics system by ensuring unique delivery entries for each rental\n- Prevent re-adding delivery records for the same rental\n- Added proper error handling and validation of review and logistics processes", "created_at": "2024-10-21T15:51:26Z", "repo": "RentItOut", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "002dac6c1674eb4ea3022fa3c3218a27c5c0cd5e", "message": "Merge branch 'main' of https://github.com/Abbas-Nedal/RentItOut\n\n# Conflicts:\n#\tREADME.md", "created_at": "2024-10-20T21:57:08Z", "repo": "RentItOut", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "735a310c181bb057936628e9f8b6a9aa7331b138", "message": "Update ReadMe", "created_at": "2024-10-20T21:55:55Z", "repo": "RentItOut", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ce5827d7c5b1b428aef6d09fb6a9d4c29d2083ef", "message": "1- Build the project Structure (MVC)\n2- Build the modules and connect them via sequelize\n 3- Build the database and upload it to AWS and connect it with the project", "created_at": "2024-10-20T18:13:11Z", "repo": "RentItOut", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5df7f772616c14c8d534a06a934eb36f34d25858", "message": "Initial commit", "created_at": "2024-10-20T17:59:11Z", "repo": "RentItOut", "file_sampled": false, "has_test_file": null, "has_impl_file": null}], "prs": [{"created_at": "2023-06-27T19:28:07Z", "body_length": 0}]}