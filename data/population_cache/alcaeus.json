as_test_file": null, "has_impl_file": null}, {"sha": "d1cf153dd6c30d12431761bf42897616f1915fcd", "message": "Bump version number to 2.0.1", "created_at": "2013-11-07T18:04:40Z", "repo": "bootstrap-table-responsive", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8c40c772b67d9f1dae3289a9675f48c8eca0763a", "message": "Change role attribute to data-caption\n\nThis change unfortunately breaks BC but it's not possible to do without.\nPreviously, the role attribute was used to denote the caption for a table field\nin it's collapsed state. This is not the correct use for the role attribute,\nwhich is why the new attribute is now data-caption.", "created_at": "2013-11-07T18:02:07Z", "repo": "bootstrap-table-responsive", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e894812727af904e44339449e6dccd078561703c", "message": "Remove branch-alias for master", "created_at": "2013-10-19T15:11:24Z", "repo": "bootstrap-table-responsive", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b95ec76558d086de263c249e9b01d923efb43a40", "message": "Merge branch 'release/2.0.0'\n\n* release/2.0.0:\n  Update readme and delete changelog\n  Fix composer branch aliases\n  Fix link to repository in package.json\n  Minor readme update\n  Add compiled CSS files\n  Remove clearfix from table caption\n  Add grunt file and meta file for compiling\n  Add rules for visibility toggle (WIP)\n  Fix borders - necessary when using captions\n  Cleanup table-responsive.less\n  Add package files for bower and npm\n  Update .gitignore file\n  Tabs -> Spaces\n  Update to Bootstrap 3.0\n  Added colons behind dt labels for max-width < 767px", "created_at": "2013-10-19T15:08:42Z", "repo": "bootstrap-table-responsive", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c78567af08a20e0f82a3023e85f61b6543df78aa", "message": "Update readme and delete changelog", "created_at": "2013-10-19T15:07:32Z", "repo": "bootstrap-table-responsive", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9cd84bbc38d69c698e34815b1d6106b9408b304f", "message": "Fix composer branch aliases", "created_at": "2013-10-19T15:05:12Z", "repo": "bootstrap-table-responsive", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1eb84be7ca14399436ac3d495a1db4c5218ab87b", "message": "Fix link to repository in package.json", "created_at": "2013-10-19T15:04:57Z", "repo": "bootstrap-table-responsive", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f53c224e7941c618ce89dc452dc438d81df94777", "message": "Minor readme update\n\nJust fixing the obvious, a more detailed documentation is coming.", "created_at": "2013-10-02T21:26:50Z", "repo": "bootstrap-table-responsive", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f2f6e41b2e0484ab76788c7e9381c42cac877809", "message": "Add compiled CSS files", "created_at": "2013-10-02T21:25:42Z", "repo": "bootstrap-table-responsive", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "48237802108cf65465c8e4e30391ea07c0fbce26", "message": "Remove clearfix from table caption", "created_at": "2013-10-02T21:25:30Z", "repo": "bootstrap-table-responsive", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "929a75cf2f374bc1c9fbb3b81847f0e096891d4b", "message": "Add grunt file and meta file for compiling\n\nThe bootstrap-table-responsive.less file is only used for compiling. It imports\nthe bootstrap variables and mixins and is compiled by grunt.\nBefore compiling will work, dependencies must be installed using bower.", "created_at": "2013-10-02T21:20:55Z", "repo": "bootstrap-table-responsive", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "11c3c04512aa69ecd12ee1611fbd4b7dc1d92988", "message": "Add rules for visibility toggle (WIP)", "created_at": "2013-10-02T21:20:02Z", "repo": "bootstrap-table-responsive", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "36089401800ec7847649bb3783f368e4739d3a0e", "message": "Fix borders - necessary when using captions", "created_at": "2013-10-02T21:16:49Z", "repo": "bootstrap-table-responsive", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "269257d2bc6af8ca93d64effe8429e78299701ac", "message": "Cleanup table-responsive.less\n\nThis cleans up many style rules and styles the collapsible tables.\nThe CSS class is now table-collapse to avoid conflicts with table-responsive.\nAlso, the collapse toggle has been removed for now - will figure out a nice way\nto bring it back.", "created_at": "2013-10-02T20:32:23Z", "repo": "bootstrap-table-responsive", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "189defba1ead798d85c5d20c4adc823c49c5113a", "message": "Add package files for bower and npm", "created_at": "2013-10-02T19:45:35Z", "repo": "bootstrap-table-responsive", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "75560a06672a18cacd174b6acbd7c06d78a0cfed", "message": "Update .gitignore file", "created_at": "2013-10-02T19:45:35Z", "repo": "bootstrap-table-responsive", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1cf1696bcb7082b82f87a4a7f4e8cb3bccd88bc2", "message": "Tabs -> Spaces", "created_at": "2013-10-02T19:45:35Z", "repo": "bootstrap-table-responsive", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a21c15ddd3d1677bd21a4eb9e01381500b7ccd8f", "message": "Merge branch 'master' of https://github.com/phillies2k/bootstrap-table-responsive into develop\n\n* 'master' of https://github.com/phillies2k/bootstrap-table-responsive:\n  Update to Bootstrap 3.0\n  Added colons behind dt labels for max-width < 767px", "created_at": "2013-10-02T16:01:30Z", "repo": "bootstrap-table-responsive", "file_sampled": false, "has_test_file": null, "