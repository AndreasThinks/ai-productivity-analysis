{"login": "ArseniyMirniy", "location": "Bulgaria", "commits": [{"sha": "90e18472e3e0a935f3c36e53a6564b8d816edd2e", "message": "Update README.md", "created_at": "2024-09-01T13:47:29Z", "repo": "Free-4K-UV-Mapping-Texture-10x10", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "dc79e35a61d0b30c23ddf8f66623d45b10331108", "message": "Delete UV.blend1", "created_at": "2024-09-01T13:38:38Z", "repo": "Free-4K-UV-Mapping-Texture-10x10", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b5fd36b26a8036ae187d29f0dc60641ff2c4832c", "message": "Blend File updated with 8x8", "created_at": "2024-09-01T13:38:16Z", "repo": "Free-4K-UV-Mapping-Texture-10x10", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "814ccb6a8b5295df4b73b64057258a7422acba04", "message": "Fixed 8x8\n\nSmall grid was fixed to match 8x8", "created_at": "2024-09-01T13:37:10Z", "repo": "Free-4K-UV-Mapping-Texture-10x10", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c34cae5c4079f5472eb499d05918f84090f1f5c7", "message": "Uploaded 8x8 versions\n\nBasically the same scene in Blender re-focused on 8x8 cells of the grid and its 2048 versions.", "created_at": "2024-09-01T13:25:35Z", "repo": "Free-4K-UV-Mapping-Texture-10x10", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "13c00c24826cf30faae351b07c6bba89d387bb93", "message": "Update README.md", "created_at": "2024-09-01T08:01:48Z", "repo": "Free-4K-UV-Mapping-Texture-10x10", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7ee5788180ebe29b795b7a79a08ecc7c6b3f7e50", "message": "Update README.md", "created_at": "2024-09-01T08:01:21Z", "repo": "Free-4K-UV-Mapping-Texture-10x10", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9d1b7fe18c688aae029a02784ea8862e93330199", "message": "Update README.md", "created_at": "2024-09-01T07:58:13Z", "repo": "Free-4K-UV-Mapping-Texture-10x10", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "97886ab97bdb8d6090e4badd23b83b26db3fbf15", "message": "Update README.md", "created_at": "2024-09-01T07:53:46Z", "repo": "Free-4K-UV-Mapping-Texture-10x10", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "42bd8825c74f236cc904ce72b09fd456aa0d679f", "message": "Uploading Media Files\n\nThree types of UV texture and Blender 4.2 file that can be used to achieve your own vision of this project with.", "created_at": "2024-09-01T07:36:30Z", "repo": "Free-4K-UV-Mapping-Texture-10x10", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9950ccf2c878f69378fea5e9170f1626baafe25e", "message": "Update README.md\n\nUpdated the license", "created_at": "2024-09-01T07:28:07Z", "repo": "Free-4K-UV-Mapping-Texture-10x10", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2952d2bacbb33083ff85933a0b917812668a5ded", "message": "Initial commit", "created_at": "2024-09-01T07:20:21Z", "repo": "Free-4K-UV-Mapping-Texture-10x10", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "21d03b27d1f83879d43c4aad18e1ca69f2000cae", "message": "Update README.md\n\nI really misspelled newer as never and it will bother me for ages now", "created_at": "2025-03-05T20:27:25Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a9411c9a3f1995bb595fb875d75b5bd1252501ce", "message": "Update issue templates", "created_at": "2025-03-04T20:58:42Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5aa88cda3f59fdeaeb71c5a22db436537b66f261", "message": "Update README.md", "created_at": "2025-03-04T20:54:18Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "347b9a6056df491a395f89f1f4d86340623bb0bb", "message": "Create LICENSE\n\nSwitching to a more usable MIT licence", "created_at": "2025-03-04T20:52:27Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7af7ef94ea37c1a3a5c980a5a3eac7a6d10eb9a4", "message": "Godot 4.4 Support\n\nThe project has been updated to support Godot 4.4 Stable. It seems like all features work as intended.", "created_at": "2025-03-03T21:13:40Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "45b2596cb43b0c40b106328feb6614f1bd470f02", "message": "Update README.md", "created_at": "2025-01-25T20:32:49Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "76466600b1c7f4ef520ce1762ed3d7ebda192737", "message": "Update README.md", "created_at": "2024-12-15T23:09:24Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "dd13fe33608b406c974b53db9b6a9903c5a63bdb", "message": "Update README.md", "created_at": "2024-12-15T21:49:37Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c19d62718db51a4715fc7182c111ee8b1344e5f7", "message": "Update README.md", "created_at": "2024-12-15T15:36:13Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c35c9cfff1f3d5648bd02625e9d03e863ba8a479", "message": "Update README.md", "created_at": "2024-12-15T15:34:14Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b29031e33a5904d8b967b88f4941a1886d02b8ef", "message": "Improved MIX Weights\n\nSeveral effects were applied by RGB, but have to be applied via HSV (Value) only. Now they work properly.", "created_at": "2024-12-15T15:33:26Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b963d0bfb6b7bc8a044273a0abe1d1f874988f63", "message": "Gradient Filter FIX\n\nThe fixed version only uses LUMINOSITY of the frame to apply the gradient. Which looks more usable.\n\nBefore, all three components were raising it up.", "created_at": "2024-12-14T21:53:30Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "34de679ab3f960fdb6420c5e69c5f84ad0c4522a", "message": "4 Color Filter Gradients Added\n\nTo make it easier to begin with, 4 linear color gradients were added to Textures folder.", "created_at": "2024-12-14T16:27:00Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d46b381a39392ee2962a74efa5fb4175648ba8b0", "message": "Posterization FIX\n\n10 steps instead of 8 to preserve more colors on sides and avoid significant color shifting.", "created_at": "2024-12-13T09:26:23Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a413afd4767687af44b4d3d9d2b9b638c20b892d", "message": "Color Filters UPGRADE\n\nBetter Color Filter via 1D Gradient Texture that can be applied as a gradual filter and is mapped by the image luminosity (the same as the posterization).", "created_at": "2024-12-13T09:04:12Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "05dc7050fd91036f2eeee4df0a32e2a07cc32464", "message": "Posterization FIX\n\nColor Ramp instead of nested IFs", "created_at": "2024-12-13T08:45:32Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e6cd7666be02407da11f2d7ec2bdc138e2a749a3", "message": "Updated Illustrations", "created_at": "2024-12-12T20:47:20Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e451c572879487e8ec89ba6e68bf3a3360a7b3fc", "message": "Update README.md", "created_at": "2024-12-12T16:52:36Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4526ee06f435c0ad0b63cceaabf2cc373f24d061", "message": "Additional Illustration", "created_at": "2024-12-12T16:51:14Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "679721de4c21773076fa355062ac8064974d58b2", "message": "Merge branch 'main' of https://github.com/ArseniyMirniy/Godot-4-Color-Correction-and-Screen-Effects", "created_at": "2024-12-12T16:43:17Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "79b910d339fcaca8ab39fb2347d38df9f3884833", "message": "RC1", "created_at": "2024-12-12T16:43:08Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d38107eb34c8ce2713c1afc919bf721862776676", "message": "Update README.md", "created_at": "2024-12-12T16:38:01Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "fa5b528ab537488e7b12b8f408daf96ebfe49b2d", "message": "Film Grain", "created_at": "2024-12-12T16:12:26Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "af08a2e3be93c937dac4aaa65144f014a335bb48", "message": "Inverse Blur", "created_at": "2024-12-08T19:54:39Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1bee519e1c9d7a847af399f51fb9f16b5cf02b8d", "message": "Pixelation Example", "created_at": "2024-12-06T19:47:36Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "cf0097d0dcb8a5e367b74c10485d01918ea6beef", "message": "Update README.md", "created_at": "2024-12-06T16:44:12Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "80b689c7074daa7e00e0d143a88d2e8339ee6ad9", "message": "Update README.md", "created_at": "2024-12-06T16:33:17Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "afab08109b550944ac9a0232ea5a2b90d6eea8c9", "message": "BLOOM FIX +\n\nBloom Booster now has less boxy appearance with better samples distribution in both diagonal and horizontal-vertical spaces.\n\nThe app has proper icon.\n\nChromatic Bloom deleted \u2014 it was experimental and wasn't doing what I was expecting (the solution is absolutely different and works with current setup).", "created_at": "2024-12-06T16:28:39Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "022b2bcb9244aaa207b897235ed7e49c7c8de388", "message": "Fixes and Improvements\n\nFixed: Contrast, Pixelization with Panini Applied, and more.", "created_at": "2024-12-05T09:55:20Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5a03d684221254ef64c6a260262fa14ef081df5e", "message": "Improved BLOOM\n\nBloom now has extra 8 samples in addition to the first 8 samples it was using initially.", "created_at": "2024-12-04T23:53:05Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2a35aa8b48da8ab57fac57e34bf118dbfebc2744", "message": "Panini FIX+", "created_at": "2024-12-04T20:33:31Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "95ee697d5b3cf95d0f492e3157ffd0adcfbdea51", "message": "Panini FIX", "created_at": "2024-12-04T08:09:02Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "711c4c5a29793d9b6593ed202f60d5234dc78192", "message": "Merge branch 'main' of https://github.com/ArseniyMirniy/Godot-4-Color-Correction-and-Screen-Effects", "created_at": "2024-12-03T22:00:06Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "776d0d877ad76025179bb5c9aaeb9d0de0965a89", "message": "Panini FIX and Blur Improvements\n\nBlur and Sharpening can now be applied mostly to the center (which makes sense, since it's exactly where we see things). It has gradient fall off, same as the one for Chromatic Aberrations.", "created_at": "2024-12-03T22:00:04Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f658c3a01f40cdab59be714b7756b1a6016b3b47", "message": "Update README.md", "created_at": "2024-12-03T21:16:00Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0f9a3fd0d62edbf8b1180ef99e72c4367213239b", "message": "Update README.md", "created_at": "2024-12-03T21:11:35Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1c72c433fbf7d5e78c1763c7c3bc7ae01083a3da", "message": "Update README.md", "created_at": "2024-12-03T21:11:21Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9ef7b7a1af3c45948a0df71de39200359950bff2", "message": "Merge branch 'main' of https://github.com/ArseniyMirniy/Godot-4-Color-Correction-and-Screen-Effects", "created_at": "2024-12-03T21:08:51Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0e69035a1a194d939739665e964681745dd4d8ef", "message": "Panini GIF", "created_at": "2024-12-03T21:08:42Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "145e3c5e99a47aea708a33e9c0fbaa73000b70b8", "message": "Update README.md", "created_at": "2024-12-03T21:04:57Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1f7dbfea9884f83972e69748a09e3968a4139a69", "message": "Panini Projection Example", "created_at": "2024-12-03T21:00:02Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "fd00b303b19279ac48512b5413bf6502ae51a4e2", "message": "Panini Projection Example", "created_at": "2024-12-03T20:52:53Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "dc3cc1917208f53d5294f2ebd3beae85939e5601", "message": "Panini Projection and Various Fixes\n\nMeet Panini Projection!\n\nIt is used with wide angle cameras to compensate the distance to the center of the image by making it closer. For example, I'm going to use a 28mm (in physical units in Godot) lens with 0.4 scale of my Panini slider.\n\nMy implementation can't overscan the image in higher resolution, so with too high values it will lose details noticeably. But with proper setup it allows to use fairly wide angles with acceptable sharpness. It will help to avoid motion sickness in first person games.\n\nChromatic Aberrations now have falloff in the center (in addition to the one that was lowering the effect for dark areas). Both sliders are 0.9 by default, which allows you to use very high aberrations without motion sickness.\n\nWARNING: Bloom Booster has been disabled in this commit, it will be created from scratch tomorrow (some blocks are prepared for it). We need a better solution (along with anamorphic lens flares).", "created_at": "2024-12-03T20:51:22Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8d86d3c597f89a9911f6734be426676e0285261f", "message": "Booleans Removed\n\nGodot Boolean Switchers are always passing both values and are not useful for optimization. This is why several passes were fixed and made neutral by default. Their respective switchers were detached. Use SLIDERS instead.", "created_at": "2024-11-30T16:35:13Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4a6568fa019dd30bddbca87cdc591f87d26c5965", "message": "Pixelation FIX\n\nNew scale is per-pixel (of Viewport HEIGHT). The default range is 1-256px, where 1 isn't doing anything (since it keeps 1px = 1px).\n\nBefore, it was aiming the % of the screen, which was hard to use.", "created_at": "2024-11-30T12:22:44Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "630a47e1c755ade1d870ccde9a0e4616dfac6296", "message": "Posterization FIX 2\n\nOne extra slice to improve transition between midtones and highlights of the image with Posterization effect.", "created_at": "2024-11-30T11:03:39Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "333bdf92bd41dc87b08c9f8443ce9103a2cbfb67", "message": "Posterization FIX\n\nSlightly darken the darkest slice", "created_at": "2024-11-30T09:19:59Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "cbc8c84ee141f0a63b40e72a0f6c4cd1d5213576", "message": "NEW: Posterization Effect\n\nPosterization in this case works only with LUMINANCE, which means, it only cut VALUE of color (Not Hue or Saturation).\n\nA bit of explanation for ones who are reading all these: we take RGB in the end of all changes of our shader, convert it to HSV (Hue, Saturation, Value), and cut Value (or Brightness) into slices and asign them with one specific color each. And then convert it back to RGB, but this time Brightness can only be in steps.\n\nFor some games, same workflow must be applied to HUE and Saturation as well.\n\nAdditionally, I'm using predefined values for slices, but you can turn them into parameters.", "created_at": "2024-11-30T08:57:47Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7d911710c757305ffc0348fba5a938f886b0b0c5", "message": "Fixed Shadows and Midtones Leak\n\nSince my approach to image splitting is to cut, subtract height, and then add back Dark + Mid + High, the lower (dark and mid) areas were affecting the upper (mid and high) ones. Changing tones or light in shadows, caused changes in mid and high ones heavily.\n\nWith the new approach, I mostly compensate the effect, where bottom changes were impacting upper ones. It's still noticeable, but the issue is rather insignificant. It's now usable.", "created_at": "2024-11-28T20:52:00Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d1f8051fc3efd9ba25f32acabaa0a7dadceafb84", "message": "Viewport Optimization", "created_at": "2024-11-26T21:48:12Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "73b27749c05a88908fcd2a0652ad0f7bd3b90e33", "message": "Merge branch 'main' of https://github.com/ArseniyMirniy/Godot-4-Color-Correction-and-Screen-Effects", "created_at": "2024-11-11T09:55:13Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c207aec90626844a27f70a5a7754d82672238142", "message": "Ultimate 2.0 and Mini FIXES", "created_at": "2024-11-10T20:35:36Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f5826d8302b305c471a22a01a8f6e609934a4d83", "message": "Update README.md", "created_at": "2024-11-09T12:45:37Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ab6f2668fd4112b1f0caad99810fd3acd558da15", "message": "Ultimate 2.0", "created_at": "2024-11-08T21:09:19Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2a2e170599f15c12bedd6622b8f959c0b4c9e083", "message": "Update README.md", "created_at": "2024-11-08T21:08:20Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0efd534f7a72f7ec52c3417fbe124ac7a6649c50", "message": "Update README.md", "created_at": "2024-11-08T21:03:02Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "69dca0904e0c792a0a5183d694a89a3e519603bf", "message": "Update README.md", "created_at": "2024-11-08T21:00:46Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "484ab7ba08a8240dd34e945c711e817ef65987db", "message": "Ultimate 2.0", "created_at": "2024-11-08T20:39:09Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "520170c628d793232f62cd5b7789601025cf1b88", "message": "Ultimate 2.0: Fixed Chromatic", "created_at": "2024-11-08T19:11:50Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4efd7bd97528b1e0ba766eb6b1357a6b63eff3f7", "message": "Ultimate 2.0: Small Fixes", "created_at": "2024-11-08T16:58:39Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c50f44df46be9aa2d7157711680ab9fad8a0e338", "message": "Ultimate 2.0: Small fixes", "created_at": "2024-11-08T16:46:29Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "55cc844e17d7db40ead203d4d45a2190dea79913", "message": "Ultimate 2: Better Luminosity Merge", "created_at": "2024-11-08T16:43:15Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "caafc2e6320c3cad40883a54700b935c90b729f1", "message": "ULTIMATE 2.0 full Color Correction", "created_at": "2024-11-08T15:33:19Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "346f825cda9cadd00b44c61da467863eb27afb4e", "message": "Main Color Correction FIX", "created_at": "2024-11-07T13:21:08Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "08bd82b2553d4810e128d5e9923b542d4c04b7cf", "message": "Color Correction 2.0 (Main Image)\n\nImplemented a reliable CC for the overall image, that works for both 2D and 3D. Still working on effects that require levels.", "created_at": "2024-11-07T12:50:27Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0b6f12d27f339fb65caa1d9cc6a8e4c30ee1a685", "message": "Pixelation Fixes", "created_at": "2024-11-06T15:54:44Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e4c1496729666f117d51c8701f94a1ea4bf0a12e", "message": "Pixelation Fixes\n\nMy goal with pixelation was to build a % scale, not per-pixel scale (since exact pixels are not reasonable for random screens and 3D space I'm working with).", "created_at": "2024-11-06T15:21:32Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "59af5d2e54f95f3e7d72aec65de27444c973b032", "message": "Pixelation Fixes", "created_at": "2024-11-06T15:18:49Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d3a1714229e29d36459f68d7f0cb41e1ea109b60", "message": "Pixelation Effect", "created_at": "2024-11-06T14:59:15Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f52476b6e4b8f619b668ecfcfc1ed42ee51e2b84", "message": "WIP A Better version\n\nBuilding a better 2D implementation that will not break reflections.", "created_at": "2024-11-05T18:31:13Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c0a354ca511b3564f0aba7c7859f75d28e7b8415", "message": "Chromatic Aberrations + Better Vignette", "created_at": "2024-10-28T21:07:21Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "80cfdef8ab1ef567a1d7aa227d0740e859584ee6", "message": "Chromatic Aberrations + Better Vignette", "created_at": "2024-10-28T21:04:22Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5508ac4d4f4485938d9cd72042eef63c9b834bed", "message": "ENV UPD", "created_at": "2024-10-28T18:45:21Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c9bc900a113719b653f41f9015e79305aced0957", "message": "Parameter to Constant FIX", "created_at": "2024-10-28T18:43:18Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "bef48b4a11182dee1b233d657f4b145b765f4beb", "message": "Fine-tuning default values", "created_at": "2024-10-27T21:18:23Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c43b47c41d2d6571a546879c57d639932a638f8c", "message": "Halation effect FIX", "created_at": "2024-10-27T20:54:24Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3638358f528191546a8e3d8f9eb43d5dbd9d5835", "message": "Halation Effect in Ultimate\n\nHalation Effect that makes the image look a little bit like a film video has been added to Ultimate shader. It makes image WARMER by default.", "created_at": "2024-10-27T20:38:18Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b4a585edf6d941b887298caece4334d275cb761d", "message": "Vignette for Mini and Extra", "created_at": "2024-10-27T18:25:58Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "10821047764f9b6a4801b613e17de43b6dd4dff1", "message": "Godot BUG #98513\n\nTrying to cover up Godot #98513 bug with redistributing nodes density in the graph. Should be editable in scales from 100 to 150%.", "created_at": "2024-10-27T18:16:58Z", "repo": "Godot-4-Color-Correction-and-Screen-Effects", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "385d79ed75f5d