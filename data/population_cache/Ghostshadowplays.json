{"login": "Ghostshadowplays", "location": null, "commits": [{"sha": "6e195efd478c6d8f648ade83be0a38d11e6db1bd", "message": "Update security-audit.yml (#15)", "created_at": "2026-03-30T13:25:14Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4d68e3943f02bcfff7862b3b95731c84b0fe6714", "message": "v5.1.1 - v5.1.2\n\nv5.1.1 - v5.1.2", "created_at": "2026-03-19T22:24:00Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "77afa1e51f6f3be3f62b5bb445374b9411587692", "message": "Fix Debloat and System tools\n\nFix Debloat and System tools not showing in the GUI", "created_at": "2026-03-19T22:05:05Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "27cc4de39ee240072c342009304d6b2068747621", "message": "v5.1.1", "created_at": "2026-03-08T03:06:03Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "517446981cc96960d73c3cc47f60b3afdad2c41c", "message": "Update ghostytools.ps1", "created_at": "2026-03-08T02:51:23Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "aee008f40461693a60f2383a16b56770e3cb03b8", "message": "v5.1.0", "created_at": "2026-03-08T02:38:32Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e12b6fe412c0574759eb6210b402528b93bfae90", "message": "v5.1.0\n\nv5.1.0", "created_at": "2026-03-08T02:27:56Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3d5f7c34b00769a9eaccf36129bc65a243d78444", "message": "Merge branch 'main' of https://github.com/Ghostshadowplays/Ghosty-Tools", "created_at": "2026-03-08T02:12:36Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c7619992f9c9b7919df351a0966737d3746df002", "message": "v5.0.9", "created_at": "2026-03-08T02:12:34Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "abe0674a0b5a5f0ea773d9053dc83af40caeaae2", "message": "Update README.md (#11)", "created_at": "2026-02-17T17:39:16Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2ac4dc457edfa3949e494b8fe637232ef6486911", "message": "Update README.md (#10)", "created_at": "2026-02-17T17:30:50Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4b510d0044891e0a9ee311f4298fda5b4ca729ff", "message": "Update README.md (#9)", "created_at": "2026-02-17T17:16:39Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "88f57a680237cac048197da310b1c0b1852bd165", "message": "Repair\n\nRepair", "created_at": "2026-02-14T08:49:20Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4f0e710fb560f7bdf4fd34d46b82495aaf865d5b", "message": "Update release.yml", "created_at": "2026-02-14T08:43:40Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f553736883e5aef86b06a90bc0286eb2856f222d", "message": "Speed Test Improvements\n\nSpeed Test Improvements\nReworked the Speed Test backend to eliminate crashes in PyInstaller --noconsole builds.\n\nImplemented a safe stdout patch to prevent speedtest-cli from calling sys.stdout.fileno() in GUI mode.\n\nCleaned up imports and removed deprecated from speedtest import Speedtest usage.\n\nStandardized the worker to use the speedtest module directly for improved stability.\n\nImproved error handling to ensure failures emit clean, readable messages instead of raw tracebacks.\n\nEnsured full compatibility with PyQt6 threading and signal emission.\n\nGeneral code cleanup and removal of redundant logic.", "created_at": "2026-02-14T08:29:27Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c269633375b56c2a7e96f0d2a4e3e1dd6f40211d", "message": "Changelog \u2014 Resource Path Update\n\n\ud83d\udcdd Changelog \u2014 Resource Path Update\nChanged\nUpdated get_resource_path() to a safer, more reliable implementation that works correctly in both development and PyInstaller builds.", "created_at": "2026-02-12T19:15:02Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "df6704b6d295b349f7c46a47b47df89e664d6081", "message": "Changelog \u2014 Resource Path Update\n\n\ud83d\udcdd Changelog \u2014 Resource Path Update\n\nChanged\nUpdated get_resource_path() to a safer, more reliable implementation that works correctly in both development and PyInstaller builds.", "created_at": "2026-02-12T19:11:27Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "35871db748465e3dae9ca601a96288b721b845c9", "message": "Removed LHM Web Polling / UI Freeze Fix\n\n\ud83d\udcdd Changelog \u2014 Removed LHM Web Polling / UI Freeze Fix\nAdded\nNothing new added in this update.\n\nChanged\nUpdated LibreHardwareMonitor configuration to disable the remote web server since the app no longer polls sensor data.\n\nCleaned up UI by removing unused sensor display elements.\n\nRemoved\nRemoved get_sensors() function (no longer needed).\n\nRemoved update_sensor_panel() function and related QTimer.\n\nRemoved periodic HTTP polling to http://localhost:8085/data.json.\n\nRemoved unused imports related to sensor polling (requests, JSON parsing, etc.).\n\nRemoved sensor monitoring UI block from the Dashboard.\n\nFixed\nResolved UI micro\u2011freezes caused by blocking network requests running on the main Qt thread.\n\nImproved overall responsiveness and smoothness of the application.", "created_at": "2026-02-12T17:45:19Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a2e2607445a7bc34a0ef075647576c85e1b52899", "message": "Update main_window.py\n\n\ud83d\udcdd Changelog \u2014 Removed LHM Web Polling / UI Freeze Fix\nAdded\nNothing new added in this update.\n\nChanged\nUpdated LibreHardwareMonitor configuration to disable the remote web server since the app no longer polls sensor data.\n\nCleaned up UI by removing unused sensor display elements.\n\nRemoved\nRemoved get_sensors() function (no longer needed).\n\nRemoved update_sensor_panel() function and related QTimer.\n\nRemoved periodic HTTP polling to http://localhost:8085/data.json.\n\nRemoved unused imports related to sensor polling (requests, JSON parsing, etc.).\n\nRemoved sensor monitoring UI block from the Dashboard.\n\nFixed\nResolved UI micro\u2011freezes caused by blocking network requests running on the main Qt thread.\n\nImproved overall responsiveness and smoothness of the application.", "created_at": "2026-02-12T17:41:59Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d751b0484d33a2240f74c5f5116d5b922d756a5f", "message": "Update release.yml", "created_at": "2026-02-12T13:09:14Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "fcbdf0b43b149344563116c72e233d19142f7ad0", "message": "Update release.yml", "created_at": "2026-02-12T12:39:30Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5f579b5c26b61a1189c37e42bcb1250b11249254", "message": "Update release.yml", "created_at": "2026-02-12T12:10:36Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1e93a674e4bdfc27d4f5b5f755fa8d91b1b8d4f3", "message": "Update release.yml\n\ntook out code signing till i find a workaround", "created_at": "2026-02-12T10:57:44Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "47c46c14a04065569cb9cffcec6642920287239e", "message": "Update release.yml", "created_at": "2026-02-12T10:27:33Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a6188882d93750a3b6c6778ba2965650d20df849", "message": "Update release.yml", "created_at": "2026-02-12T10:21:26Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "23b82825891e5751e5d5e507593813597791bef1", "message": "Update release.yml", "created_at": "2026-02-12T10:14:24Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4c9c645387b954b14c8aca86a63530475c46e777", "message": "Update release.yml", "created_at": "2026-02-12T10:06:34Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3e1575b2141d0529959d59fd3d4655f85336de15", "message": "Update release.yml", "created_at": "2026-02-12T09:55:57Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "efbfe11657cfa99360e50cbb898c6865d224d386", "message": "Update release.yml", "created_at": "2026-02-12T09:52:55Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8b3956d12dac9ad2f5ae9ccedc2f43527ce1abe5", "message": "Update release.yml", "created_at": "2026-02-12T09:44:03Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "26b3078b0e53e0743bc1a0741abf87dcd07d9241", "message": "Update main_window.py", "created_at": "2026-02-12T06:42:59Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "aa2050c7be167d18124ed9aa64fd87c58f4616a1", "message": "Update requirements.txt", "created_at": "2026-02-12T06:14:43Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "418cb206501241eb3b487f1a4a27d5ddbf505d35", "message": "v5.0.6", "created_at": "2026-02-12T06:12:41Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "90140ca9516ddf764c1ceaa6ff700a718ceccbea", "message": "Update release.yml", "created_at": "2026-02-10T21:56:41Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0dc318d16413e81803b08dc264dcab2fe1408ee7", "message": "Update requirements.txt", "created_at": "2026-02-10T21:41:31Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "bbd84c617774e3e0c4818b8979bf3086c5814740", "message": "Enhanced Environment Sanitization\n\nEnhanced Environment Sanitization: Both the update logic and the privilege elevation helper now actively strip _MEIPASS and all PYI* (PyInstaller-specific) variables from the environment before launching the new process.\n\u2022\nPATH Purification: Automatically removes any directory references containing _MEI from the PATH environment variable. This prevents the bootloader from accidentally discovering and using DLLs from an old extraction directory.\n\u2022\nRobust PowerShell Updater: The PowerShell-based updater now explicitly clears its own $env:_MEIPASS and sanitizes its $env:PATH before starting the updated executable.\n\u2022\nIncreased Reliability: Bumped the update delay to 5 seconds to ensure all file handles from the previous version are fully released by the OS before replacement occurs.", "created_at": "2026-02-10T21:35:46Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "89c261ab95a719103f36d56ad971452def0d6376", "message": "Updated the GitHub Actions workflow, Update Manager Fix:\n\nUpdated the GitHub Actions workflow for CodeQL analysis to use version v4, as v3 is scheduled for deprecation in December 2026.\n\nUpdate Manager Fix: In src/gui/main_window.py, the PowerShell updater now receives a clean environment where _MEIPASS is removed. This ensures that the new version of the app performs its own extraction into a fresh temporary directory.\n\u2022\nPrivilege Elevation Fix: In src/utils/helpers.py, the _MEIPASS variable is now cleared before calling ShellExecuteW (runas). This prevents similar DLL loading errors when the application restarts with administrative privileges.\nThese changes ensure a smooth transition during updates and elevation, resolving the reported crash.\n\nv5.0.4 to v5.0.5", "created_at": "2026-02-10T21:22:26Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "32301a2ec8aff6273799c571a92db73091fdd560", "message": "Robust SQLite Backend\n\nRobust SQLite Backend: Replaced the legacy JSON-based storage (vault.json) and separate salt file with a single, professional SQLite database (vault.db) for the Password Manager (ShadowKeys).\n\u2022\nFixed Security Bug: Resolved the issue where the vault could be \"unlocked\" with any password if it was empty. The system now enforces a mandatory verification block that must be decrypted correctly to grant access.\n\u2022\nAutomated Legacy Migration: Added a migration engine that automatically detects and imports passwords from the old vault.json and salt files into the new SQLite format upon the first successful unlock.\n\u2022\nRefactored Security Logic: Moved key derivation (PBKDF2-HMAC-SHA256) and salt management directly into the PasswordManager core, making the UI components (MasterPasswordDialog) simpler and more focused.\n\u2022\nEnhanced Reliability: Using SQLite ensures that data is stored safely in the user's %APPDATA%\\GhostyTools directory, protecting it from accidental loss during app updates or EXE replacements.\n\u2022\nUI & Documentation Update: Bumped the feature version to ShadowKeys 2.1 in the About page and updated the README to reflect the new architecture.\n v5.0.3 to v5.0.4", "created_at": "2026-02-10T20:54:37Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f763bc56d900514841a08a0bd68f5b97a9a4b1f2", "message": "Robust SQLite Backend\n\nRobust SQLite Backend: Replaced the legacy JSON-based storage (vault.json) and separate salt file with a single, professional SQLite database (vault.db) for the Password Manager (ShadowKeys).\n\u2022\nFixed Security Bug: Resolved the issue where the vault could be \"unlocked\" with any password if it was empty. The system now enforces a mandatory verification block that must be decrypted correctly to grant access.\n\u2022\nAutomated Legacy Migration: Added a migration engine that automatically detects and imports passwords from the old vault.json and salt files into the new SQLite format upon the first successful unlock.\n\u2022\nRefactored Security Logic: Moved key derivation (PBKDF2-HMAC-SHA256) and salt management directly into the PasswordManager core, making the UI components (MasterPasswordDialog) simpler and more focused.\n\u2022\nEnhanced Reliability: Using SQLite ensures that data is stored safely in the user's %APPDATA%\\GhostyTools directory, protecting it from accidental loss during app updates or EXE replacements.\n\u2022\nUI & Documentation Update: Bumped the feature version to ShadowKeys 2.1 in the About page and updated the README to reflect the new architecture.", "created_at": "2026-02-10T20:50:06Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d7423e773db31e71d38777e3fc247e983d3cb400", "message": "Release.yml update\n\nRelease.yml fix", "created_at": "2026-02-10T19:54:58Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "10344e2fc2c4eba8a7bbd8e8cab8665fa4012077", "message": "Implemented new safe UX/security tweaks\n\nImplemented new safe UX/security tweaks and expanded System Tools;", "created_at": "2026-02-10T19:37:36Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "cfe8ccef92af338f142b3cb7af287dc5321027fe", "message": "version mismatch\n\nversion mismatch", "created_at": "2026-02-10T12:23:18Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ed862e2c90fbafcc3c91403e0b48b0db39b8a23d", "message": "known vulnerability\n\nknown vulnerability Fix 2.32.3 - 2.32.4", "created_at": "2026-02-10T12:12:12Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "cf69237a23f08f879201fdf197b2587c563e96a2", "message": "auto\u2011update system\n\nAdded a mechanism to track the last version the user acknowledged in version_info.json within the app's config directory.\n\u2022\nUpdate Detection: On startup, the app compares the current code version with the stored version. If they differ, it recognizes that an update has just occurred.", "created_at": "2026-02-10T11:54:56Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7700835640e890612d11f575f42fc9c1425688c9", "message": "subprocess.run\n\nadded,\nCREATE_NO_WINDOW = getattr(subprocess, 'CREATE_NO_WINDOW', 0)\n\nto all subprocess.run", "created_at": "2026-02-09T22:02:16Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3ab5be5805054d0d0062f0f0dda0a13fb2222634", "message": "updated the hell out of it", "created_at": "2026-02-09T15:15:39Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "18231c8c5d29eaabbedc13fdf7d0d98d77d2c5b7", "message": "Update README.md", "created_at": "2026-02-09T15:00:53Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4dc46d8d9c80f3869a187f05494ce1d175b16b11", "message": "Removed forced admin; elevation now optional.", "created_at": "2026-02-09T14:50:17Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7e8ccb8bcf9c72aa2bbb62b03d3107d45fd28868", "message": "SpeedTestWorker\n\nRedirection in main.py: Added logic at the very top of the entry point to ensure sys.stdout and sys.stderr are redirected to os.devnull if they are found to be None. This provides a valid file descriptor for any library (like speedtest-cli) that expects them to exist, even when running without a console window.\n2.\nResilience in src/core/workers.py:\n\u25e6\nWrapped the import speedtest statement in a try-except block to prevent the entire application from failing to start if the module fails to load.\n\u25e6\nAdded a safety check in the SpeedTestWorker.run() method to provide a user-friendly error message if the speed test is attempted when the module is unavailable.", "created_at": "2026-02-09T14:24:21Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6dec9ef103c4ba621aadb3d3f9c2b62620683d76", "message": ".github/workflows/release.yml\n\nNew Workflow: .github/workflows/release.yml\n\u25e6\nThis workflow will now automatically trigger whenever you create/publish a Release on GitHub.", "created_at": "2026-02-09T14:11:47Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "26f6d8e9ef973cd9932fa31f86a425c47c543a08", "message": "updated\n\nUpdated the Security & Quality Audit workflow so that the Audit (Bandit + pip-audit) job does exactly that: it now runs only Bandit (failing the job only on High\u2011severity findings) and pip-audit.\n\u2022\nRemoved unrelated quality gates (flake8, black, mypy) from this job because they were the actual source of the failures, even though the job\u2019s name/readout highlighted the Bandit/pip\u2011audit audit.\n\u2022\nKept the quick py_compile syntax check for a fast sanity pass.", "created_at": "2026-02-09T13:57:39Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c83aae7eba86b6b0a1dca703f3423218f6343d37", "message": "Merge branch 'main' of https://github.com/Ghostshadowplays/Ghosty-Tools", "created_at": "2026-02-09T13:49:15Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "67c953b096e060371dfc116085671fa1d746ed4a", "message": "Update security-audit.yml", "created_at": "2026-02-09T13:48:35Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "13b9beca99b991e2f6af802bdd4022f1f08ba09d", "message": "Update codeql.yml (#7)", "created_at": "2026-02-09T13:37:23Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "98b1a83aa6309d78d8b8357c8aaa228d0ffe6039", "message": "Update python-app.yml (#3)", "created_at": "2026-02-09T13:33:16Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "37e2353195fac3a2cc51f7c97ee22421609fd3c3", "message": "Update python-app.yml (#6)", "created_at": "2026-02-09T13:30:40Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "98287f131128cd45320a3c4bd729a693ae7a9101", "message": "Update python-app.yml (#4)", "created_at": "2026-02-09T13:21:53Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "641118a6601da97b8aa3671dca7375c9652aa03e", "message": "Enable CodeQL; add flake8/black/mypy badges to README\n\n- New CodeQL workflow: .github/workflows/codeql.yml (push/PR + weekly)\n- README: added lint/format/type badges under main CI badge\n- No runtime changes", "created_at": "2026-02-09T12:39:46Z", "repo": "Ghosty-Tools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4190c88b925d5c2dccfb6f12f2ccacf57e6de1e3", "message": "Merge branch 'main' of https://github.com/Ghostshadowplays/Ghosty-Tools", "created_at": "2025-09-05T15:32:46Z", "repo": "Ghosty-Tools", "file_sampled": false, "has