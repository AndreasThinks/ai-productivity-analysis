47\u0442\u043e \u043d\u0435\u0442. \u0418\u043d\u043e\u0433\u0434\u0430 \u043e\u043d \u043d\u0430\u0445\u043e\u0434\u0438\u0442 \u043b\u0438\u0448\u043d\u0438\u0435 \u043f\u0440\u044f\u043c\u044b\u0435, \u0438\u043d\u043e\u0433\u0434\u0430 \u0442\u0435\u0440\u044f\u0435\u0442. \u0422\u0435\u0440\u044f\u0435\u0442 \u0440\u0435\u0436\u0435, \u043f\u043e\u0441\u043a\u043e\u043b\u044c\u043a\u0443 \u043e\u0448\u0438\u0431\u043a\u0438 \u043f\u043e\u0442\u0435\u0440\u044c \u0432\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u0434\u0438\u0441\u043a\u0440\u0435\u0442\u043d\u043e\u0441\u0442\u0438 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430 \u0425\u0430\u0444\u0430 \u043d\u0435 \u0432\u043e\u0437\u043d\u0438\u043a\u0430\u044e\u0442 (\u0442\u0430\u043a\u0438\u043c \u043e\u0431\u0440\u0430\u0437\u043e\u043c \u043f\u043e\u0434\u043e\u0431\u0440\u0430\u043d\u043e \u0441\u043e\u043e\u0442\u043d\u043e\u0448\u0435\u043d\u0438\u0435 Fi_num \u0438 R_num). \u041b\u0438\u0448\u043d\u0438\u0435 \u043f\u0440\u044f\u043c\u044b\u0435 \u044f \u0442\u043e\u0436\u0435 \u043f\u044b\u0442\u0430\u043b\u0441\u044f \u043e\u0431\u0440\u0430\u0431\u0430\u0442\u044b\u0432\u0430\u0442\u044c, \u043d\u0430\u0445\u043e\u0434\u044f \u0432 \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0435 \u0425\u0430\u0444\u0430 \"\u0444\u0438\u0433\u0443\u0440\u044b\" -- \u0443\u0447\u0430\u0441\u0442\u043a\u0438, \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0435\u0441\u0442\u044c \u0441\u043a\u043e\u043f\u043b\u0435\u043d\u0438\u0435 \u043f\u0435\u0440\u0435\u0441\u0435\u0447\u0435\u043d\u0438\u0439. \u0422\u0435\u043c \u043d\u0435 \u043c\u0435\u043d\u0435\u0435, \u0447\u0430\u0441\u0442\u043e \u043f\u0440\u043e\u0441\u043a\u0430\u043a\u0438\u0432\u0430\u044e\u0442 \u0431\u043b\u0438\u0437\u043a\u0438\u0435 \u043d\u0430\u0439\u0434\u0435\u043d\u043d\u044b\u0435 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u043e\u0439 \u043f\u0440\u044f\u043c\u044b\u0435 (\u0412 \u043a\u043e\u043d\u0441\u043e\u043b\u0438 \u043f\u0435\u0440\u0432\u044b\u0435 \u0441\u0442\u0440\u043e\u043a\u0438 -- \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044f \u043e\u0431 \u0438\u0441\u0445\u043e\u0434\u043d\u044b\u0445 \u043f\u0440\u044f\u043c\u044b\u0445 (\u0432 \u0434\u0430\u043d\u043d\u043e\u0439 \u043a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u0438 \u044d\u0442\u043e 2 \u0441\u0442\u0440\u043e\u043a\u0438), \u0430 \u043f\u043e\u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435 \u0441\u0442\u0440\u043e\u043a\u0438 -- \u0434\u0430\u043d\u043d\u044b\u0435 \u043e \u043d\u0430\u0439\u0434\u0435\u043d\u043d\u044b\u0445 \u043f\u0440\u044f\u043c\u044b\u0445. \u0412\u043f\u0440\u043e\u0447\u0435\u043c, \u043f\u043e\u0442\u0435\u0440\u0438 \u043f\u0440\u044f\u043c\u044b\u0445 \u0442\u043e\u0436\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0430\u044e\u0442\u0441\u044f \u043f\u0440\u0438 \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f\u0445 Edge \u0431\u043b\u0438\u0437\u043a\u0438\u0445 \u043a N_on_line. \u0414\u0443\u043c\u0430\u044e, \u043e\u0448\u0438\u0431\u043a\u0438 \u043f\u043e\u0442\u0435\u0440\u044c \u043f\u0440\u044f\u043c\u044b\u0445 \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0434\u044f\u0442 \u0432\u0441\u043b\u0435\u0434\u0441\u0442\u0432\u0438\u0435 \u0434\u0438\u0441\u043a\u0440\u0435\u0442\u043d\u043e\u0441\u0442\u0438 \u0438\u0441\u0445\u043e\u0434\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0441\u0442\u0440\u0430\u043d\u0441\u0442\u0432\u0430. \u041d\u0443 \u0438\u043b\u0438 \u0436\u0435 \u043a\u0440\u0438\u0432\u043e \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u044b\u043c \u0433\u0435\u043d\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u043c \u0442\u043e\u0447\u0435\u043a \u043d\u0430 \u043f\u0440\u044f\u043c\u044b\u0445 (\u043f\u043e\u0442\u043e\u043c\u0443 \u0447\u0442\u043e \u0438\u043d\u043e\u0433\u0434\u0430 \u043d\u0430 \u0432\u0438\u0434 \u043f\u0440\u043e\u0441\u043a\u0430\u043a\u0438\u0