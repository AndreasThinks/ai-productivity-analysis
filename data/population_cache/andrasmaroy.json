"has_impl_file": null}, {"sha": "7037194c1406a0f88c2ee5929538ef54da4c54aa", "message": "Add additional finder settings", "created_at": "2023-12-03T21:32:32Z", "repo": "dotfiles", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6a6d1a8461cf52f18d98b3fbcb56a2b8a62977fc", "message": "Add Finder preferences", "created_at": "2023-11-29T08:57:24Z", "repo": "dotfiles", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8b5da0c66bb2b29792a38a5298694a36f1af1368", "message": "Set additional dock preferences", "created_at": "2023-11-27T11:24:12Z", "repo": "dotfiles", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "92f90757d0ad9c2e676b3807674620b675c5cb2c", "message": "Set menubar and control center preferences", "created_at": "2023-11-27T11:23:49Z", "repo": "dotfiles", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d046f2cb34565674f69075bbbd1adcffb0a440ad", "message": "Set screensaver settings", "created_at": "2023-11-26T17:09:56Z", "repo": "dotfiles", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7fce30c2d5243c405b08b51fd9744075163dbf46", "message": "Configure macos dock", "created_at": "2023-11-26T16:48:32Z", "repo": "dotfiles", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c2220adfd56e3044a4a90e3a52834b0cbc6020e2", "message": "Break out macos setup tasks to separate files", "created_at": "2023-11-26T16:23:41Z", "repo": "dotfiles", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "73505e1033d6e7b3b3e5aebb2d50be4b1dab8499", "message": "Enable long press accent menu on long press", "created_at": "2023-11-26T16:18:13Z", "repo": "dotfiles", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c64fdc730a304905b6047069f011f0374bf4185e", "message": "Enable three finger drag for internal and bluetooth trackpads", "created_at": "2023-11-26T12:12:28Z", "repo": "dotfiles", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5815a8d137a028781a3f0cf9ccb10044301bf099", "message": "Map caps lock to escape\n\nThis is a bit tricky to automate. Modifier mappings are stored per keyboard in defaults. In order to find the correct key to store the mapping the keyboard needs to be identified first.\n\nThis can be done with ioreg. Special care needs to be taken as intel macs use USB keyboards internally, apple silicon macs use SPI keyboard, so these reside under different classes in ioreg. Ioreg can output in XML, so we can find the id using xpath querying. Since different keyboards reside under different classes, the query is for all devices, making it quite slow...\n\nOnce the product id is found using ioreg, we first check the current value and if it is incorrect then set it. This has to be done this way because we need to write the key in XML format, so that the mappings are stored in the correct integer type, not as strings which is the default. When storing in XML format the diff checking doesn't work correctly, thus the check beforehand.", "created_at": "2023-11-26T12:19:58Z", "repo": "dotfiles", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "88f52e86739a585747d835eb9be4fa6e94745d21", "message": "Fix typo in bash profile", "created_at": "2023-11-25T17:44:45Z", "repo": "dotfiles", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e94db84b1447800a7963fcd853947166ed25790a", "message": "Replace homebrew role with geerlingguy.mac.homebrew", "created_at": "2023-11-25T17:43:08Z", "repo": "dotfiles", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "55042c6dd1a007ae06793b046de42764b721f961", "message": "Use requirements file for ansible galaxy dependencies", "created_at": "2023-11-25T17:42:01Z", "repo": "dotfiles", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9b50c127ac050a