e": null}, {"sha": "f8390404e65f1bfc157f2f90b6a2b165c414cdac", "message": "Add missing Title for NuGet package", "created_at": "2017-08-15T07:22:27Z", "repo": "AsyncTestTools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "68bc76e696e0e227843eb64bb7c04ac62d8034db", "message": "Migrate from project.json to VS2017\n\nThis directly addresses #3 but it also deals with #4 because with the new tooling it's straightforward to target .NET Standard", "created_at": "2017-08-15T07:12:03Z", "repo": "AsyncTestTools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8a9e157f62349c1441f552a8349d55c8b153a41f", "message": "Support Task<T> in WithTimeout.\n\nImplements #2", "created_at": "2016-05-24T15:58:22Z", "repo": "AsyncTestTools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ef119e5df62189a62444d4fcdd5c27010468b2f1", "message": "Wait multiple times to work around xunit.\n\nAnother attempt to fix #1", "created_at": "2016-04-04T13:43:03Z", "repo": "AsyncTestTools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a5ab53d6d1df90ae5b809474d9225c8f41475353", "message": "Add ConfigureAwait in WithTimeout.\n\nAssociated issue: #1", "created_at": "2016-04-04T12:56:22Z", "repo": "AsyncTestTools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "347acada2342e5aca0b51e0c6d7a5c5cd566bd98", "message": "Extended default timeout to 5 seconds.\n\nIt seems that running XUnit tests in DNX RC1, things often go slow enough that it frequently takes more than 2 seconds for even fairly simple work triggered asynchronously to complete!\n\nThis only seems to be an issue with concurrent execution of tests, but that's the default behaviour.\n\nI'm hoping this is just a perf problem with preview bits. Meanwhile, 5s is tolerable.", "created_at": "2016-03-25T17:03:20Z", "repo": "AsyncTestTools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4c78f9de73a5768c3d112d989f486734f203edd1", "message": "Add task timeout extension methods.\n\nWhen testing async code, it's often useful to wait for something to\nhappen but being prepared for it not to happen because of a fault in\nthe code under test (or because you've not written the code required to\npass the test yet). So it can be helpful to wait for a reasonable time\nand then give up with an error.\n\nThese new WithTimeout extension methods for Task make this easy.", "created_at": "2016-03-10T07:28:45Z", "repo": "AsyncTestTools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1f322d036c189ddb4378859b9b2886d2a1469ca7", "message": "Add CallCount and fault-ignoring wait.", "created_at": "2016-02-11T18:09:24Z", "repo": "AsyncTestTools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "799eeb5720125f2a530535f677a5b8becac2c96e", "message": "Add version and copyright info.", "created_at": "2015-12-16T10:11:49Z", "repo": "AsyncTestTools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6c9e6952f1a3c504027f2d8ad6b660c2b60b50a0", "message": "Enable package build on Release, disable on Debug.", "created_at": "2015-12-16T10:08:32Z", "repo": "AsyncTestTools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f815bcfb84a84bc74cf6df3079205c0525594abe", "message": "Add CompletionSource and CompletionSourceWithArgs.", "created_at": "2015-12-16T10:07:13Z", "repo": "AsyncTestTools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c0a8c6a1062d516159187cf7fc1d7acf17a96f00", "message": "Initial commit", "created_at": "2015-12-16T07:20:26Z", "repo": "AsyncTestTools", "file_sampled": false, "has_test_file": null, "has_impl_file": null}], "prs": [{"created_at": "2020-04-28T09:00:35Z", "body_length": 336}, {"created_at": "2019-07-05T10:02:34Z", "body_length": 106}]}