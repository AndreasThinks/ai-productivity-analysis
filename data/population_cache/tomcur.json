 {"sha": "492180f5c22f3106fde43edba64fa9366f893e76", "message": "Sequences are now constrained such that any one color can not follow itself in the sequence. E.g., red-red-blue is not allowed, but red-blue-red is.", "created_at": "2015-10-24T15:31:22Z", "repo": "SequenceRetentionExperiment", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "be0245c9147583c01abb044f9c345beb07b4c6d8", "message": "Added Diede to author credits in source code.", "created_at": "2015-10-23T14:42:07Z", "repo": "SequenceRetentionExperiment", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2a3ea31ef2a712eca6c5d747bf90281a317ba4bb", "message": "Added running information to the readme.", "created_at": "2015-10-23T14:29:59Z", "repo": "SequenceRetentionExperiment", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1783be66762b80c42e7fa4d516a5fe3b3061ffa9", "message": "Added auditory feedback to tell the user that a button has been pressed successfully.", "created_at": "2015-10-23T14:14:01Z", "repo": "SequenceRetentionExperiment", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "159cde739e4b201ff6a8a5a8ca4a058ff00dad57", "message": "Changed border-highlight, color-highlight such that now a border is shown on hover, and the color is highlighted on click.", "created_at": "2015-10-23T14:06:32Z", "repo": "SequenceRetentionExperiment", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "470a572933ec35dac68565743a99c10e40632a8b", "message": "Added course information to the readme.", "created_at": "2015-10-23T13:47:14Z", "repo": "SequenceRetentionExperiment", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "00ec66cb3c177170499f48bea2de980ec52bfab5", "message": "Merge branch 'master' of https://github.com/Beskhue/SequenceRetentionExperiment", "created_at": "2015-10-23T11:27:58Z", "repo": "SequenceRetentionExperiment", "file_sampled