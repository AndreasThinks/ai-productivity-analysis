3T03:38:49Z", "repo": "tooltipster", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e0a8620563f349c69f0c66ea7c409e16b76614a0", "message": "Tooltips will now be removed if its origin is removed", "created_at": "2013-02-13T03:37:35Z", "repo": "tooltipster", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9f7a73550d4269e216a2265c499426ec2f0d8f3d", "message": "Fixing update API bug", "created_at": "2013-02-13T03:17:44Z", "repo": "tooltipster", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "cbfd8bc0d760bb09b926751248c79aedb1768db2", "message": "Need to fix origin detection removal", "created_at": "2013-02-12T22:33:28Z", "repo": "tooltipster", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b5c2174814fc92a62962a1a57de1ab260ceac41d", "message": "expanding API calls to support container selectors\n\nSelect containers to interact with the API of all tooltip origins\ninside: $('body').tooltipster('show');\n\nThere is currently a bug with updating content in this manner. Work in\nprogress.", "created_at": "2013-02-12T22:16:28Z", "repo": "tooltipster", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "36178ccc7141fe40d4abe67e159824f45e732453", "message": "updating v2.1.1", "created_at": "2013-02-12T20:56:41Z", "repo": "tooltipster", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "41f9efe1a022b059904b9bc6e9305437c26cc953", "message": "Merge branch 'dev'", "created_at": "2013-02-12T20:54:29Z", "repo": "tooltipster", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "642cf7c538d3fd226e7670b1256ba3ffd4726180", "message": "updating to v2.1", "created_at": "2013-02-12T20:54:04Z", "repo": "tooltipster", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "734db3315e6104d84fc72d15e314978bb3c35f3a", "message": "updating all files to v2.1", "created_at": "2013-02-12T20:52:17Z", "repo": "tooltipster", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "78e58c01f60da3d0d941560c462a59f6dc6baf4c", "message": "added option for functionReady() - fires when tooltip contents have been added to DOM\n\n$(...).tooltipster({\n    functionReady: function(origin, tooltipster) {\n        ...\n    }\n});\n\norigin = element tooltip originates from\ntooltipster = tooltip itself", "created_at": "2013-02-12T20:30:44Z", "repo": "tooltipster", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d10bcce447ece865a463077094d8b08665f61b6a", "message": "if a tooltip is open and its origin is removed, the tooltip will hide as well", "created_at": "2013-02-12T20:19:21Z", "repo": "tooltipster", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "71ff902641c5f0028773bc5bf3bf67ea66c3a3f3", "message": "added new API method to reposition tooltips\n\n$(...).tooltipster('reposition')\n\nThis will make sure selected tooltips are correctly positioned. This\nhas now been attached to the window resize event under the Tooltipster\nnamespace. Open tooltips will now reposition themselves on window size\nchange.", "created_at": "2013-02-12T18:35:10Z", "repo": "tooltipster", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5f0480c7903947e9a07c92e6dd633f7b87848dad", "message": "everybody loves comments!", "created_at": "2013-02-12T16:42:27Z", "repo": "tooltipster", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "548a3367c62ead29fd6465cf441db77895670c69", "message": "better name spacing and interaction with API - thanks to glebtv\n\nBetter API allowing:\n$(...).tooltipster('show')\n$(...).tooltipster('hide')\n$(...).tooltipster('destroy')\n$(...).tooltipster('update', 'new text')\n\nNamespace mouseenter, mouseleave, and click events to allow destroying\ntooltip without affecting user's other events", "created_at": "2013-02-12T16:35:59Z", "repo": "tooltipster", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "37ddd500015e84055b8b2b57e52592d30c964b7e", "message": "Merge branch 'dev'", "created_at": "2013-02-12T16:00:30Z", "repo": "tooltipster", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9abad070fc0239671829847719d2c4be421fcc3b", "message": "updating latest stable version", "created_at": "2013-02-12T16:00:14Z", "repo": "tooltipster", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0ed1a632260c0385a88fec512c1e83830d1cd968", "message": "arrow: false position bug fix - thanks to glebtv", "created_at": "2013-02-12T15:51:20Z", "repo": "tooltipster", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "224621fe0f368a103c8a59c1f75185ea3de8b70c", "message": "Merge pull request #11 from glebtv/patch-1\n\nTooltip without arrow is not positioned - fixed", "created_at": "2013-02-12T15:10:45Z", "repo": "tooltipster", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f108903b50795115c1e11263c0d989f442dcb971", "message": "Merge branch 'dev'", "created_at": "2013-02-06T21:31:46Z", "repo": "tooltipster", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "acc5b65c79ca8fe4921cc4aece6b97ff80474324", "message": "fixing a bug with the 'content' option", "created_at": "2013-02-06T21:31:23Z", "repo": "tooltipster", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2b4d6f4975880e0ca37c8325f34d5576198c4fb3", "message": "Merge branch 'dev'", "created_at": "2013-02-06T21:15:16Z", "repo": "tooltipster", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5b12d7c257c2b27a5f63b10c10fbbe215925a1a1", "message": "refinining how tooltip content is updated when tooltip is showing", "created_at": "2013-02-06T21:14:56Z", "repo": "tooltipster", "file_sampled": false, "has_test_file": null,