Z", "repo": "linux-config", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "45875a85892a6b05f309fdb2fe6065faff1a9cde", "message": "add highlight group for vim-gitgutter plugin", "created_at": "2025-02-27T00:08:02Z", "repo": "linux-config", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9b27ea34641150a978543f9a7927eef077a6f97d", "message": "add options for ycm", "created_at": "2025-02-26T03:35:21Z", "repo": "linux-config", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d2e4e0d77b1f9e45dcf340145f1a130af25bedad", "message": "clean up", "created_at": "2025-02-26T03:34:16Z", "repo": "linux-config", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5570d5ff7d65992ada3f7bd46aa56b8d6ae0e4b8", "message": "fix lowercase", "created_at": "2025-02-25T17:02:02Z", "repo": "linux-config", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2467744516cd65b932c494430d61ab2cc44666e1", "message": "Update\n\n* change the Ycm error and warning symbol\n* change keymap for replacing the current word under cursor\n* add keymap for NERDTreeToggle command\n* more robust color scheme load\n* change the LineNr and SignColumn background color to be the same\n* set the line number to display the current line number on the\n  cursorline", "created_at": "2025-02-21T16:39:09Z", "repo": "linux-config", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "dd5ff3c5c85f674bfb92a51278b57289a2b78e3a", "message": "Improve for vim 9.1\n\n* Reorganize and clean\n* Use termguicolors instead of xterm 256 colors\n* Simplify the airline_section_z of vim airline\n* Remove automatic detection of python virtualenv always start venv\n  before start vim\n* Remove the background color in Visual mode. This color is not set by\n  \"highlight Visual\" in zenburn.vim and is suspected to be changed by vim\n  itself\n* Move calling of AirlineInit() outside of augroup. Placing it inside\n  the augroup caused some issues that needs more time to investigate.", "created_at": "2025-02-14T20:58:29Z", "repo": "linux-config", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6a6327c34da9ec52a865008dc1ea36ccf9b895db", "message": "enable blank line, zenburn prompt color", "created_at": "2024-09-13T17:05:17Z", "repo": "linux-config", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "57d2266d0a209a9bef64d59d9927dba54aad5c80", "message": "clean stuff", "created_at": "2024-09-13T16:23:14Z", "repo": "linux-config", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "69ab5aaf008bb5ed359aabbd12352cd62e400c16", "message": "formatting\n\nremove window size change\n\nchange the custom command from RG to Rgx beacause RG exsists in fzf.vim\nplugin already", "created_at": "2024-07-23T19:38:55Z", "repo": "linux-config", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c40dfd6c340602b737842df30cf10b5bb92f7bb8", "message": "add bat(1) configuration file", "created_at": "2024-07-17T23:38:11Z", "repo": "linux-config", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8b3704694d11f06d46922f926c1de20a2b2dc88f", "message": "use agkozak zsh prompt and add its settings", "created_at": "2024-07-17T20:19:01Z", "repo": "linux-config", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f78fffe2e8d70077f03dd843a743068e892e9204", "message": "add global .gitconfig for wsl2 linux", "created_at": "2024-07-12T21:25:55Z", "repo": "linux-config", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f4816c6bcabf758f684c74e8f55a6e1f688f4e36", "message": "add global .gitconfig file for linux", "created_at": "2024-07-12T21:24:23Z", "repo": "linux-config", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "67112a4c831572dea12fc321251b85fe