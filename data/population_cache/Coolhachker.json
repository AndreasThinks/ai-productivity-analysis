441\u0438\u043c\u0432\u043e\u043b\u044b, \u043d\u043e \u043d\u0443\u0436\u043d\u043e \u0431\u043e\u043b\u044c\u0448\u0435 \u0434\u0430\u043d\u043d\u044b\u0445 \u0434\u043b\u044f \u0442\u0435\u0441\u0442\u0430", "created_at": "2024-01-04T00:35:36Z", "repo": "PERSEPHONA", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "da299fca48ae316ec57c11198d868c78520e9da9", "message": "\u0421\u043e\u0437\u0434\u0430\u043b \u043d\u043e\u0432\u044b\u0439 \u0444\u0430\u0439\u043b generate_text.py \u0434\u043b\u044f \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u0438 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432 \u043d\u0430 \u043e\u0441\u043d\u043e\u0432\u0435 \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u0438\u0439 \u043c\u043e\u0434\u0435\u043b\u0438. \u0412 \u043a\u043b\u0430\u0441\u0441\u0435 PERSEPHONA \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b, \u0447\u0442\u043e \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u043c\u043e\u0435 state \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u044d\u0442\u043e tuple(state, state). \u0412 \u043a\u043b\u0430\u0441\u0441\u0435 Education \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0438\u043b \u0444\u0443\u043d\u043a\u0446\u0438\u044e \u0442\u0440\u0435\u043d\u0438\u0440\u043e\u0432\u043a\u0438 \u043c\u043e\u0434\u0435\u043b\u0438", "created_at": "2024-01-02T14:20:35Z", "repo": "PERSEPHONA", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9fd223e7b62ca781dda5425146ee95bae110c35c", "message": "\u0432 \u043a\u043b\u0430\u0441\u0441\u0435 DATASET \u043f\u043e\u043c\u0435\u043d\u044f\u043b \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435 batch_size \u0441 64 \u043d\u0430 1. \u0412 \u043a\u043b\u0430\u0441\u0441\u0435 PERSEPHONA \u0440\u0435\u0448\u0438\u043b \u0431\u0430\u0433 \u0441\u0432\u044f\u0437\u0430\u043d\u043d\u044b\u0439 \u0441 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u044f\u043c\u0438 (27 \u0441\u0442\u0440\u043e\u043a\u0430). \u0412 \u043a\u043b\u0430\u0441\u0441\u0435 Education \u0434\u043e\u0431\u0430\u0432\u0438\u043b \u0444\u0443\u043d\u043a\u0446\u0438\u044e \u043a\u043e\u043c\u043f\u0438\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u043c\u043e\u0434\u0435\u043b\u0438 \u0438 \u0444\u0443\u043d\u043a\u0446\u0438\u044e \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f checkpoints", "created_at": "2024-01-02T12:20:28Z", "repo": "PERSEPHONA", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "acd3e12d5c0fcce37d92159b79d49ec90534a065", "message": "\u0412 \u043a\u043b\u0430\u0441\u0441\u0435 DATASET \u0434\u043e\u0431\u0430\u0432\u0438\u043b \u043d\u043e\u0432\u0443\u044e \u0444\u0443\u043d\u043a\u0446\u0438\u044e, \u043a\u043e\u0442\u043e\u0440\u0430\u044f \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 Dataset (\u0434\u043e\u0431\u0430\u0432\u043b\u044e \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0438 \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0445 \u043a\u043e\u043c\u043c\u0438\u0442\u0430\u0445). \u0421\u043e\u0437\u0434\u0430\u043b \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0439 \u0444\u0430\u0439\u043b \u0434\u043b\u044f \u043e\u0431\u0443\u0447\u0435\u043d\u0438\u044f \u043c\u043e\u0434\u0435\u043b\u0438", "created_at": "2024-01-01T23:42:16Z", "repo": "PERSEPHONA", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "458c741f34f00463fe93d88ee661a05e107fe313", "message": "\u043d\u0430\u043f\u0438\u0441\u0430\u043b \u043a\u043e\u043c\u043c\u0435\u043d\u0442\u0430\u0440\u0438\u0438 \u0434\u043b\u044f \u0444\u0443\u043d\u043a\u0446\u0438\u0439 \u0432\u043d\u0443\u0442\u0440\u0438 \u043a\u043b\u0430\u0441\u0441\u0430 Vectorization", "created_at": "2024-01-01T18:20:51Z", "repo": "PERSEPHONA", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "61527b1634739441bb966013dfcc67c5a6779a8b", "message": "\u043e\u043f\u0438\u0441\u0430\u043b \u043c\