node lazily. Bump package version to 9.0.49.", "created_at": "2026-02-26T16:30:48Z", "repo": "zek", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "457c6c8cab3734424e5d327fb7eb5d7badfcb388", "message": "Update Zek.csproj", "created_at": "2026-02-26T09:37:13Z", "repo": "zek", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "98217f355e5009563e8748ed07d19644a23d00fd", "message": "Use expression-bodied IsValidUrl methods\n\nConvert IsValidUrl implementations in ValidationHelper and UrlHelper to expression-bodied members. Simplifies the methods to a single Uri.TryCreate call with an HTTP/HTTPS scheme check, removing commented code and a redundant null/empty check while preserving behavior.", "created_at": "2026-02-18T07:05:45Z", "repo": "zek", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "91768a184e31bf25abaa4c14ce6eafcabd81a71e", "message": "Delete Zek.saproj", "created_at": "2026-01-06T11:09:39Z", "repo": "zek", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "607a608af397aca53dbe2b675a038de6d0872db0", "message": "PutAsJsonAsync", "created_at": "2026-01-06T09:01:16Z", "repo": "zek", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "23a0cac529661a5972a338814be765035c666574", "message": "version update", "created_at": "2026-01-05T09:15:03Z", "repo": "zek", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ef743c86bedde6b2eadc6be0eff4e65ed3f746a6", "message": "UrlShortener", "created_at": "2026-01-05T09:03:21Z", "repo": "zek", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a7123f7d2abc64b3b81bbf9f95e30661bae411c5", "message": "Update HashHelper.cs", "created_at": "2025-12-27T08:52:42Z", "repo": "zek", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3b140c94ee26f04381928dbac078c08cdf338340", "message": "asdad", "created_at": "2025-1