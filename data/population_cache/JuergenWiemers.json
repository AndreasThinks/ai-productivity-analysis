{"login": "JuergenWiemers", "location": null, "commits": [{"sha": "568adf78c0546f37559af7f6834132eb21f8406e", "message": "Update README.md", "created_at": "2025-01-07T18:41:39Z", "repo": "fframeappend", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7910f9b3e4da6ce99f39ee6daafa5b60cafaefc7", "message": "Bugfix string variable promotion", "created_at": "2025-01-07T12:56:48Z", "repo": "fframeappend", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "96497b20dca7984d841d7167943a9605f37114b2", "message": "Update README.md", "created_at": "2023-08-04T16:00:12Z", "repo": "fframeappend", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "368496ae264402e34326b42b022d91edeeaac455", "message": "Fix abbreviated varlists\n\n- Abbreviated varlists didn't work after v1.1.0. Fixed.\n- More solid parsing of arguments.", "created_at": "2023-08-04T13:26:27Z", "repo": "fframeappend", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "769b39c1a4e56c3fcf269bdc0665194484fca967", "message": "Merge branch 'v1.1.0DEV'", "created_at": "2023-07-31T08:44:50Z", "repo": "fframeappend", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "38af57a2fb9f3d3bdd95fb2e69ef5baa36b8f5c9", "message": "v1.1.0", "created_at": "2023-07-31T08:39:35Z", "repo": "fframeappend", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "35768fb0e3531ef72b102ebf71116888887e4c68", "message": "Make `generate` variable numeric...\n\n... and add value labels indicating the original frame.", "created_at": "2023-07-23T11:12:57Z", "repo": "fframeappend", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ed8a84cc26b56a84fc04a88dd3ee8b31298f8e80", "message": "Update README.md", "created_at": "2023-07-23T10:24:14Z", "repo": "fframeappend", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "697963b60fb91a979a