ull, "has_impl_file": null}, {"sha": "ac01259ade0ff5c60d0369113e074cd012a22ecc", "message": "Minor constructor fixes", "created_at": "2020-09-27T23:35:50Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "62f244fc5c63053a3460d0b92522bd7362f78ee3", "message": "Refactored InternalEngine\n\nRe-wrote InternalEngine implementation and changed it to DZEngine that was more convenient for a multiplayer setup\n\nTODO:: DZEngine AbstractWorldEntity has no way of getting to the PhysicalObject or PhysicalJoint Entity it is refering to. PhysicalObject and PhysicalJoint should inherit from AbstractWorldEntity and UpdatableAndDeletable should be changed to a interface", "created_at": "2020-09-27T23:31:59Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "392caf7cb1399b75999f5ffa01f3157556bc189b", "message": "Removed old initialisation code from client", "created_at": "2020-09-14T19:15:46Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1ee16b01d01e54686f4a99109c4f427b721b15d9", "message": "Added Client-Side Interpolation\n\nClient can now interpolate movement between server snapshots to make gameplay smoother.", "created_at": "2020-09-14T16:44:19Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "281592142d2a5919a207f861d87a67e183434326", "message": "Brief test code for sending a world snapshot to clients\n\nWrote very brief code that parses entities into byte[] to be sent to clients to be unwrapped and instantiated, currently many problems occure, such as clients being unable to interpolate with their client-side physics with maths going to infinity for unknown reason.\n\nCode cleanup needs to be done in the byte parsing.", "created_at": "2020-09-09T23:19:47Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c162ab18a36dc14cabb2006d52325f5c4fcfcd28", "message": "Refactored ID system\n\nChanged EntityIDs such that they are assigned using a simpler faster algorithm than what was previously implemented.", "created_at": "2020-09-09T20:34:38Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a4c31cb6289e789c28ff1b3c17e05eeb5d5cd016", "message": "Merge branch 'master' of https://github.com/randomuserhi/Enter-The-Dead-Zone", "created_at": "2020-09-09T10:13:25Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "370431caf8b395feef9283584ddd83e1d332f25b", "message": "Updated CheckEntityID to add new IDs and throw an error on already used IDs", "created_at": "2020-09-09T10:13:21Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0f063ec745dc4da47cc840d00bb2a8120a26e652", "message": "Made all EntityObjects and EntityInteractions inherit EntityBehaviour\n\nEntityBehaviour makes sure every entity type creates its own ID on creation and removes its ID and frees it on destruction. This allows for proper tracking of entities and their interactions (such as DistanceJoints) across server and client", "created_at": "2020-09-08T19:42:19Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8c4a5ac3bc9ced36d4de47df99f73da04f41d304", "message": "Imported portion of internal engine into server for testing snapshot generation and sending", "created_at": "2020-09-07T20:19:23Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8fcc0c0f91ead20803992e8afcf10bb5337eeb88", "message": "Updated to Unity version 2020.1.4", "created_at": "2020-09-06T22:08:53Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "597c3ce052bc65f6c4d5b66c2a3b89c3034b1908", "message": "Implemented EntityID tracking\n\nGives each entity a unique ID such that when implementing networking, entity data can be sent with reference to its ID", "created_at": "2020-09-06T21:43:14Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4fb1fe7ef478fa22400fa6eb05c6aa4610ed4b55", "message": "Refactored InternalEngine to work in conjunction with UnityEngine\n\nRe-wrote major parts of the engine such that it works using unity rigidbodies and colliders to allow for easier use in the editor.", "created_at": "2020-09-02T17:43:00Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "79e48afa2c4594bd34c67b63d9ed0f6e13d5a2ed", "message": "Added Warm Starting\n\nWarm Starting implemented for CircleCircle collisions", "created_at": "2020-08-20T19:57:23Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b8343839d35c45eb37f3995ca1a7eab5ab23c903", "message": "Circle Colliders + Distance Joint Implemented\n\nA brief implementation of Circle Colliders and Distance Joints has been implemented to the physics system. The physics is based off of Erin Catto sequential impulse ideology. Warm Starting needs to be implemented (accumulation of impulses over frames).", "created_at": "2020-08-20T18:45:45Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3b8314df8e5c73ca42d38b514832d6f7e5ceb930", "message": "InternalEngine Project Added", "created_at": "2020-08-19T16:06:48Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2fa2a8a023753c134d6c2b634074ca91b21e0310", "message": "Added InternalEngine\n\nInternalEngine is the physics engine I intend to use for my project, Currently no methods are implemented.\n\nIn the future I intend the engine to work only with Circle and Box colliders using GPGPU programming for performance (This can be done using implementations such as ComputeShaders in Unity) => In this way unity will be used for rendering rather than as a physics engine\n\nCurrently coding it seperately, will port to Server once written and tested", "created_at": "2020-08-19T16:06:12Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "23fbed26ed4e9596c553580ed8c73b1c2e279bcc", "message": "Implemented ServerBackend Code into Unity Projects\n\nAdded some organisation:\n- Added events for server and client code for ease of use (OnClientConnection and OnStart)\n\nImplemented basic server communication and establishing UDP connection after successful TCP connection.\n- Implemented ServerCodes used to determine the purpose of each packet", "created_at": "2020-08-17T17:19:08Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d2cc7f81c5d2353576817c7bb1c9617cc37c1ac1", "message": "Updated to Unity Editor 2020.1.0", "created_at": "2020-08-16T21:34:46Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "479ba00fb8d6884f12cb1220b807e141f4581c4c", "message": "Fixed UDP connection: SocketException\n\nStopped the UDP socket closing upon sockets connections being forcibly closed by clients", "created_at": "2020-08-15T19:38:02Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "698e3a4569cd8601871e44d06a3f3bda3dc92388", "message": "Added handle for disconnection on server side\n\nServer can now disconnect, not yet tested on client side.\n\nDisconnection is not very clean when performed due to Sockets.IO error or Sockets.SocketException tho it is currently functional", "created_at": "2020-08-11T18:58:21Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "467cc0d4b231a6d7d0df1f4c7057252f611e0a0f", "message": "Implemented TCP and UDP connection to server\n\nUDP and TCP connections between server and client can be made.\n\nTODO:: a clean method of disconnecting and handling loss and regain of connection to clients and servers needs to be added for TCP, UDP and IPC", "created_at": "2020-08-09T18:39:04Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3322ccd18ad889f871120af047153e9ea521885d", "message": "Finished IPC connection libraries\n\nAdded Packet class to handle parsing of data via byte arrays\n\nImplemented a server handle such that packets can be processed and managed on the main thread", "created_at": "2020-08-08T20:14:54Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "162c77d2020720c7a556b78e2c1d1055f61f2307", "message": "Started work on server code\n\nAdded 2 new console code projects to write the server and client libraries:\n  - ServerBackend houses the full library\n  - ServerBackendReceiver is used to test client code from the library\n\nCurrent code is now able to establish IPC connection and send / reciever data => this is planned to be used when the server and client connect locally on the same machine, TCP and UDP connections will be implemented later\n\nSending data currently just sends a couple set bytes => a Packet class template is left to implement to handle variety of data types", "created_at": "2020-08-05T15:10:12Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "cf7b35c01e2f273df850f536b1ad95940a7ad778", "message": "Merge branch 'master' of https://github.com/randomuserhi/Enter-The-Dead-Zone", "created_at": "2020-07-13T20:50:13Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5329e16c7082f64a519a412f0da486ac5d55cfa6", "message": "Updated to latest version of Unity", "created_at": "2020-07-13T20:49:13Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4d58ae977febee81e9e0200175d1bf673ce1c72c", "message": "Updated unity version", "created_at": "2020-07-04T11:46:28Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6a924b17373db94466161f96c4aba0233eed422b", "message": "Updated version of unity", "created_at": "2020-07-04T11:41:46Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "45a615e3d46aabcec492c290e27257ca73ac2860", "message": "Added Server and Client Projects", "created_at": "2020-05-25T17:21:02Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b0722d4f5419663e7f15bef29e0f6343de897169", "message": "Update .gitignore", "created_at": "2020-05-25T17:18:39Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "aa13b11182fbc5037b58389f602d3579588e8736", "message": "Initial commit", "created_at": "2020-05-25T17:12:54Z", "repo": "Enter-The-Dead-Zone", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e3596b2670f0469068736abf4072d63460aa3e75", "message": "Fixed formatting", "created_at": "2022-04-11T23:57:43Z", "repo": "CNN", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d0fa6670983dfa2af333abfde88ce04efb1f7751", "message": "Updated UI", "created_at": "2022-04-11T11:32:47Z", "repo": "CNN", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a9862ffc9dc61009d767f1354a4fb2e642c18628", "message": "Fixed a lot of bugs lmao", "created_at": "2021-02-12T13:39:49Z", "repo": "CNN", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ed430b057d521b5a114373d3