ll}, {"sha": "2ccc147ecfeeabf6011493b97cf33b87b8f67e54", "message": "PWM-related functions were moved to separate files.", "created_at": "2025-03-26T17:36:37Z", "repo": "ESL-project-BLE", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5ce40ab074b1a40dda1b0f8a48fce07cb38521f0", "message": "The number of characteristics has been reduced.", "created_at": "2025-03-26T17:18:07Z", "repo": "ESL-project-BLE", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "cb9e02cb11cc66044ee005a7889d47351a8fb44f", "message": "Rename characteristics-related variables and constants", "created_at": "2025-03-26T16:26:55Z", "repo": "ESL-project-BLE", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8d852995860cdbe03c6839df46a334f0f8ff1b55", "message": "Removed unnecessary actions for writing data to flash memory (in particular, when starting the application).", "created_at": "2025-03-26T12:08:57Z", "repo": "ESL-project-BLE", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e6a9f9c624935089f9ae866ad1e534a694d8f0df", "message": "Added garbage collector for FDS module.\nMinor code changes.\n\nCloses #5", "created_at": "2025-03-26T06:57:16Z", "repo": "ESL-project-BLE", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "77ba4ad54ea72cf2f28c8b87158ed43cfe81db0e", "message": "Implemented work with the Peer Manager module.\nRecording of characteristics 1 and 2 is now possible only after pairing.\nNotification of characteristics 5 and 6 is now possible only after pairing.\n\nRelated to #5", "created_at": "2025-03-25T14:56:35Z", "repo": "ESL-project-BLE", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "09c85f616c728da3f5dec7a073bc1baf37105ea4", "message": "Added the ability to select the UUID type for the service and characteristics.\nAll characteristics in the current implementation are marked as vendor-specific.\nAdded a se