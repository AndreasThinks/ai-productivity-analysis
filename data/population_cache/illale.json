-11-23T12:41:43Z", "repo": "miinaharava", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6e8096add374cb75e78ade41740cff727829a5ef", "message": "Create README.md", "created_at": "2020-01-30T14:55:05Z", "repo": "Server", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "fabfadb6376a06531fcd57ef6e145c0b9decb0ef", "message": "Made the code cleaner.", "created_at": "2019-11-05T19:06:33Z", "repo": "Server", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "53ba57250d8484a15d11e1ba44dada61270ebb42", "message": "-Server should now sent messages from client to another client.", "created_at": "2018-12-18T10:31:07Z", "repo": "Server", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "90aedc390b486d3228367cac376f371c90d83ae3", "message": "-Small changes", "created_at": "2018-12-18T09:25:15Z", "repo": "Server", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "34e5efc56aa2eafb5dd6ceb7584f0d2ec5966f49", "message": "-Made changes to the server file, so that it differeantes between clients\n using names client sent them.", "created_at": "2018-12-18T09:21:47Z", "repo": "Server", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c7f8c6ee88bda16c76310be648fc39e5e230e0a2", "message": "-Added names for connections.", "created_at": "2018-12-18T09:05:42Z", "repo": "Server", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5939abb106c5ff76b0aea1fda186aa22caf4a2b0", "message": "-Made small changes to the source-code. Nothing big.", "created_at": "2018-12-18T08:14:24Z", "repo": "Server", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f5997d5275befd8439133d474502abc2ecafe775", "message": "-Fixed a bug, in which client got automatically kicked out of server.\n This was caused by threading.daemon, which was set to be True.\n When daemon values were true, clients main thread died first, so\n other threads died too.", "created_at": "2018-12-17T19:28:20Z", "repo": "Server", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c1bf1be18d239f9f9da698cac51a8aef303331a8", "message": "Version 0.0.1 of the server and client.\n-Simple system to send and receive messages from client using threads.\n-Server receives data, and swaps messages casing.\n-In server.py created handle_client function, which handles each client,\n and send back messages.\n-In client.py we defined two functions. send_data and receive_data.\n both are running in their own thread, so they can be working at the same\n time. When we do this, the client can send messages contionously, and they\n don't have to wait for an answer from the server. Client.py uses threading.Lock()\n function to lock print, so that messages get printed to different lines.", "created_at": "2018-12-17T18:49:34Z", "repo": "Server", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a4cbb16786085a956d3f7a1f8a1344df5212cb67", "message": "Update README.md", "created_at": "2020-01-30T15:15:39Z", "repo": "JTKJ", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b2775211cfbaaa85da9db5ec3435122600d4a8e4", "message": "Create README.md", "created_at": "2020-01-30T15:13:42Z", "repo": "JTKJ", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "38d8ab7ef633515097b3c44532dd4006f78e5a6b", "message": "Rename main123.c to main.c", "created_at": "2020-01-30T15:09:53Z", "repo": "JTKJ", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5602720a4f0fb7be54bf131b8f15e2900f512b35", "message": "Added the final version", "created_at": "2020-01-30T15:06:49Z", "repo": "JTKJ", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "49d56488d432f0d0ab3b27aa341e61823d3c9319", "message": "Add files via upload", "created_at": "2019-10-22T07:38:32Z", "repo": "JT