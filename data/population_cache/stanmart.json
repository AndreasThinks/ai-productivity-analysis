ha": "e18ee831684c9f0d6bf75a97a5591497cf441fed", "message": "Started working on the data downloader script", "created_at": "2020-02-26T12:28:19Z", "repo": "project-for-pp4rs", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a1974b1591c8065129cc848f2ce00c1df5c2ab8b", "message": "updated .gitignore", "created_at": "2020-02-26T12:11:23Z", "repo": "project-for-pp4rs", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e106a5b0d6cac1f54e4cd242f9ac6f03280f9000", "message": "Initial commit", "created_at": "2020-02-26T12:03:34Z", "repo": "project-for-pp4rs", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "498c498c9b9a0dec209ae78f3eac0a8a29ea076d", "message": "Move one more file", "created_at": "2024-02-28T13:33:42Z", "repo": "diseq", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4e204163cbfec291e135ded3a89bd49ab100fd8d", "message": "Add license", "created_at": "2024-02-28T13:32:59Z", "repo": "diseq", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7a64e9c9d911bfac05effe033b8a6db2fdc304a3", "message": "Add a short readme", "created_at": "2024-02-28T13:28:10Z", "repo": "diseq", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f346ad6478c74444207730e4bec0b66b9d373fd4", "message": "Organize code into folders", "created_at": "2024-02-28T13:21:03Z", "repo": "diseq", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "222535b695cea04ca0e1fa309edb213e399c8ca6", "message": "Add some documentation to the functions", "created_at": "2024-02-28T13:15:09Z", "repo": "diseq", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "abb881ad9b48f83a782f76cac44dd488b957717a", "message": "Added unconditional expected deficit predictions", "created_at": "2020-07-09T20:30:00Z", "repo": "diseq", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "48e3e3d8c09df93640bc0a1196be18754cd42516", "message": "Correct standard errors for rho", "created_at": "2020-06-29T16:43:19Z", "repo": "diseq", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "95c24821e8a488b7c6dcaf3a6a8a79a16024e56d", "message": "Added new prediction types\n(conditional, expected deficit)", "created_at": "2020-06-29T15:59:15Z", "repo": "diseq", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5a1e46b1ca4dde20bac136993bd4a450a7140fdb", "message": "tanh transformation for rho (implemented by Petii)", "created_at": "2020-06-24T16:21:24Z", "repo": "diseq", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "bc2fc0e98174351c756a6d16315e76b7532c7f89", "message": "Added the option to choose standard error types\nPossible choices: Hessian-based (IM), gradient-based (score) and robust (not exploiting information matrix equality).\nA side benefit is that now we have a proper closed-form function for the gradients, so we can use it for gradient-based optimization algorithms if we would like to.", "created_at": "2020-06-12T10:07:50Z", "repo": "diseq", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a678a8e306e43362024cacd4ee818c68873f65b2", "message": "Transforming the standard deviations in outputs\nNow the coefficients vector and the coefficients matrix of the diseq and summary.diseq objects contains the correct, scaled standard errors. Raw optimization results are in the raw_coefficient vectors and matrices. Be aware that the latter has to be used from now on when calculating LL contributions and continuing estimationns (hopefully changed it in all relevant places).\nFinally, the estimated standard errors of the standard deviations are calculated correctly (using the Delta-method) for the transformed coefficients.\nNote: if a different transformation is chosen for any of the coefficients, the corresponding part of `summary.diseq` must be changed accordingly.", "created_at": "2020-06-11T12:19:29Z", "repo": "diseq", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "dc975f8ad619cbef3bcf2eae53ec494fdcefced2", "message": "Adds an option to fix equal sigmas\nNow `fitdiseq` (and related functions) accept the `equal_sigmas` argument, which constrains the sigmas to be equal. Tested it against Peti's solution and the results are the same.\nSimplifies the code as much as I could and removed unused code paths (although there were very few).\nSome minor fixes are also made (e.g. using sigma vs log(sigma) in prediction)", "created_at": "2020-06-11T11:50:14Z", "repo": "diseq", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f9270f4e51f015c8caf1f6c66a639a12ab933096", "message": "Fixed a minor bug (equation with only a constant)", "created_at": "2020-06-11T09:36:36Z", "repo": "diseq", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4da062ba3719ba0e70b12233fbd5cabb9b5b15fa", "message": "Added functions for analyzing likelihood contributions", "created_at": "2020-05-12T20:42:14Z", "repo": "diseq", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2adcbb08fed2ddaf772b22e878966bc89caa0d31", "message": "Added a file to generate some descriptive stats", "created_at": "2020-05-07T19:19:35Z", "repo": "diseq", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "05f4eeed52511041974c1a7be6b579fe5b4d05e7", "message": "Introduce bias into likelihood\nAdded an option to introduce an additive bias to the likelihood before\ntaking logs. It might help with extremely small likelihoods.\nMade the plots more informative in the example and the to_run scripts.", "created_at": "2020-04-16T14:55:07Z", "repo": "diseq", "file_sampled": false, "has_test_file": null, "has_impl_file": null}], "prs": []}