at": "2026-01-27T06:50:17Z", "repo": "sview", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3c77c7d02ffb353af62c0596d0c902c32c089417", "message": "FFmpeg - fix StVideoQueue::hwaccelInit() compilation with 8.0.1 due to renames", "created_at": "2026-01-27T05:02:05Z", "repo": "sview", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e5dad82239d98326cbf8add1186f04ccd336cff9", "message": "CI/CD - always specify 'path' for 'actions/checkout' to avoid implicit changes", "created_at": "2026-01-26T05:06:02Z", "repo": "sview", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "87796648d4f1bb6c5333d5c109a38fbd5ef38d98", "message": "StWindow, XLib implementation - create sepate GL rendering context for second window\n\nThe patch effectively reverts the change introduced in '2013.\n\nIt seems that glxMakeCurrent() invalidates GL_BACK contents\nor GLXContext reuses the same buffers when attached to another Drawable.", "created_at": "2026-01-20T18:30:24Z", "repo": "sview", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "781527c358cf45c63301945c6f707d17438138a7", "message": "StOutDual - when only single monitor is available, display second window with half-width offset", "created_at": "2026-01-20T17:46:54Z", "repo": "sview", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2b34aa0a503ff2284c5d954c7ee98ae58a10c2cb", "message": "Linux, XDND - fix opening of file dropped from Thunar as `text/uri-list`\n\nFixed handling of `text/uri-list` when it is the only suggested option\n(previously it handled only when other application suggested more than 3 formats).\n\nFixes compatibility with Thunar as well as some other apps via XWayland.", "created_at": "2026-01-08T06:34:45Z", "repo": "sview", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9fb011c33d90f42d8c5d8005b62a5818af2ca7e5", "message": "Update changelog", "created_at": "2026-01-07T06:11:58Z", "repo": "sview", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3585cfadbfbda176987672e424fab57c023bc498", "message": "Update copyright years in about dialogs", "created_at": "2026-01-07T06:02:15Z", "repo": "sview", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3cc2520d6e041e774b635e6ff59323f6e7537aa5", "message": "StWindows, Linux - workaround lost keyboard input focus within XWayland\n\nwhen switching to fullscreen mode.\n\nXSetInputFocus() is now called for decorated window instead of\nre-parented fullscreen window which for some reason doesn't recieve\nkeyboard events within XWayland.\n\nIt seems that this works without side effects within X11 session too.", "created_at": "2026-01-06T16:20:38Z", "repo": "sview", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "cf990f89409a8108e76b8bdc3c712fd09d6dc61d", "message": "StGLContext - suppress verbose messages from Mesa driver in debug builds", "created_at": "2026-01-06T15:06:31Z", "repo": "sview", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ea294de5ec774f7dc745dc7dc467dcfb047027cb", "message": "CI/CD - update checkout action to V6", "created_at": "2026-01-04T14:30:05Z", "repo": "sview", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "cdf795dc8199211e024e934ef4dca666d74780a0", "message": "CI/CD - combine workflows", "created_at": "2026-01-04T13:41:56Z", "repo": "sview", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b44fa756d88c5d31ac5c8cd5b4f120bf7478a343", "message": "CI/CD - run INSTALL target within MSVC job", "created_at": "2025-12-10T06:45:59Z", "repo": "sview", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ec2b3c0be84baee5aa0baca5d98ac25fc6856cab", "message": "StImageViewer - add shuffle playlist button", "created_at": "2025-12-10T06:35:01Z", "repo": 