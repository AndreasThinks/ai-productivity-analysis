17:52:27Z", "repo": "sanity-studio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a9f1893885d9da7a0ecd182726cd55863c8cb87c", "message": "rebuild locally hylke 04-03-2025-01", "created_at": "2025-03-04T16:40:59Z", "repo": "sanity-studio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6e93f99d61fc08871d78d6cdc15681c5e3f36702", "message": "Changes 02-01-2024-02", "created_at": "2025-01-02T17:27:18Z", "repo": "sanity-studio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2d9560fe4f3f905e5f71d98957f9f4ba4307e1b2", "message": "Initial commit for Sanity Studio", "created_at": "2025-01-01T12:03:30Z", "repo": "sanity-studio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f90cbdb2fdf8d6ecd6379987575c98d665fe5eef", "message": "feat: bootstrap sanity studio", "created_at": "2024-12-24T19:03:46Z", "repo": "sanity-studio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5157b37980cf325e7762225188792f28479a30db", "message": "Change channel relation to manyToMany for multi-channel publishing\n\nArticles and categories can now belong to multiple channels,\nenabling write-once publish-to-many across sites.\n\nCo-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>", "created_at": "2026-02-24T13:34:11Z", "repo": "strapi-cloud-template-blog-7a4e644d7f", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1f02750311ecd9b68107c0fe2fe002e3e6917159", "message": "Add Channel type to generated TypeScript definitions\n\nRegisters ApiChannelChannel interface and adds channel relation to\nArticle and Category types so the build passes strict type checking.\n\nCo-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>", "created_at": "2026-02-24T12:58:10Z", "repo": "strapi-cloud-template-blog-7a4e644d7f", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8806a12cf2450e2108b1cc9f620d30c84b2bcb2b", "message": "Add Channel collection type for multi-site content management\n\nEnables serving multiple sites (Virtalize, Launchminds) from a single\nStrapi instance by scoping articles and categories to channels.\n\nCo-Authored-By: Claude Opus 4.6 <noreply@anthropic.com>", "created_at": "2026-02-24T12:24:39Z", "repo": "strapi-cloud-template-blog-7a4e644d7f", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7114b2a695453292d3181784e481436260fdb824", "message": "Add Article, Author, Category content types with i18n and dynamic zone components\n\n- Enable i18n plugin with en/nl locales\n- Article (localized): title, slug, description, cover, author, category, blocks dynamic zone\n- Author (not localized): name, avatar\n- Category (localized): name, slug\n- Shared components: rich-text, media, quote, slider\n\nCo-Authored-By: Claude Opus 4.5 <noreply@anthropic.com>", "created_at": "2026-02-02T12:37:48Z", "repo": "strapi-cloud-template-blog-7a4e644d7f", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "fd0a62eb6c7c6a12ef7ba4adaeba6bfb94c174b1", "message": "Initial commit from Strapi", "created_at": "2026-02-02T11:11:07Z", "repo": "strapi-cloud-template-blog-7a4e644d7f", "file_sampled": false, "has_test_file": null, "has_impl_file": null}], "prs": []}