ile": null}, {"sha": "817bef7c1647cafa7d54477b9b5c443588cd45dc", "message": "Use ServicePerEndpoind for Thrift clients", "created_at": "2018-04-03T19:57:22Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c7b011e5a9c92a6d7287e4e8a1b47a20bd3bb195", "message": "Fix Thrift exceptions propagation", "created_at": "2018-04-03T19:56:37Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "07e2833f47a7610dd8df25f779f9fd2fe3a702cc", "message": "Refactor (way to more) things\n\nThere is now a standard ServerException embedding all information about\nwhat went wrong during the handling of a server request.\nRemove the discovery module, make operators discovered through a Guice module.\nMove the parsing of workflows/runs on the client side.\nRemove Thrift wrapper types.\nThe client is now asynchronous (i.e., commands return a Future).", "created_at": "2018-04-03T16:34:11Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f20010b4d8cb33700aece09ebc41c49fff7450ff", "message": "Use the terminology of credentials where applicable", "created_at": "2018-03-30T22:42:55Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ca4ebcbedaa4c34e6a0e83a1e60429fc3a9af363", "message": "Handle authentication on client-side (#14)", "created_at": "2018-03-30T22:17:13Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "603b0797ed348982211b865898582c9fa5ab4ac2", "message": "Rename the 'addr' field in 'server' in clusters configuration (for consistency)", "created_at": "2018-03-30T20:50:16Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "442a76712e71e1b7a03973c1feffde01434b6451", "message": "Move the gateway under tools/", "created_at": "2018-03-30T20:45:21Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "098dd0e0776fff07c01f5b6c09f85fbf9f4493f3", "message": "Support authentication on server-side (#14)", "created_at": "2018-03-30T20:43:25Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1539eb11cf2ca84bd3768589ba1d9150b5f0a268", "message": "Merge branch 'master' of github.com:privamov/accio", "created_at": "2018-03-30T16:47:46Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d346eb05ec52b0430927bf4d839c36721fc4557a", "message": "Update Vagrantfile to handle Windows line endings", "created_at": "2018-03-30T16:47:30Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b0aacc1e8090a0da7342a0e3da511ad0b94599bd", "message": "Migrate the agent under Finatra\n\nFinatra avoids us a lot of boilerplate, and gives us additional capabilities such as facilitating the way of using filters.", "created_at": "2018-03-30T09:30:19Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "05a541b20617c683af8abe72350cc27dba73afbe", "message": "Bump version to 0.7.0-devel", "created_at": "2018-03-29T16:04:21Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "617d94ce043f49da75223f9ebfd2b4447aab0435", "message": "No need anymore to manually update the Vagrant box", "created_at": "2018-03-29T09:14:46Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "faf08cc6e2d4e3f4bd2052614a99ebac20263061", "message": "Fix Vagrant box version", "created_at": "2018-03-29T09:07:58Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "53d5ab51db37e18283554c57a444acbed65ddcb3", "message": "Fix Travis YAML", "created_at": "2018-03-29T08:21:35Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b1929b08f6caa982e81a3c5c6fd94092acbc47be", "message": "Try to remove MySQL password for Travis", "created_at": "2018-03-29T08:21:21Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "03be53e015de70c65571276739761da383dcd823", "message": "Forward environment variables to Bazel", "created_at": "2018-03-29T00:01:27Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a0aff8b306eeabe1d2e82b39d1dae0ee15e46192", "message": "Change MySQL host for travis tests", "created_at": "2018-03-28T23:47:27Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "71a2aa65fa72f2bdfb119fcfdaebb8bfd0040a44", "message": "Try to switch to container-based Travis", "created_at": "2018-03-28T23:39:33Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9d441ff45baced65da84bfb7fa3d85e1abe23b1e", "message": "Simplifies MySQL storage initialisation", "created_at": "2018-03-28T23:33:24Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d62751d1b39b9bb596a9c80770409a0c3d0d20a7", "message": "Fix travis configuration", "created_at": "2018-03-28T23:26:33Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "dbfe11fbbc256de0f23985903412856fb564f769", "message": "Move accio/util to accio/version", "created_at": "2018-03-28T23:01:25Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "fb61a535fbd1b2950a3990cbe50850e61d4bd720", "message": "Implement MySQL storage (#5)\n\nThe actual implementation does not use schemas, but rather stores the binary encrypted objects. Filtering is mostly done by the storage layer (and not handled by the database itself).", "created_at": "2018-03-28T22:58:56Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "71a40d0aa5af07981be447ba995a6fb3bc81b845", "message": "Rename storage/inject into storage/install", "created_at": "2018-03-28T19:46:51Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c84ca529450e88a32c7d2661e191227b1afe4063", "message": "Refactor the storage API\n\nIntroduce two new methods, read and write, giving access to the underlying stores.\nThe memory storage now holds a global write lock, replacing the messy individual locks that were previously into play.", "created_at": "2018-03-28T19:42:02Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "af707a89063e9d3fd7331e8758d02462f6f8cb5f", "message": "First cleanup of Storage interface", "created_at": "2018-03-28T18:18:13Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "bed5c0309af6c392e99fef10fb0576cafc3516c0", "message": "Basic content for README", "created_at": "2018-03-28T11:19:17Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e951bcc0d8398c21e76dcba3f93ecdc36cbc8a35", "message": "Fix the search path in the docs", "created_at": "2018-03-28T11:10:35Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "fd417c8a166f74a88be61f01c85396665d6372f3", "message": "Merge pull request #17 from enummela/vagrant-docs\n\nFix typos and perform minor rewrites to improve clarity of Vagrant docs.", "created_at": "2018-03-28T10:56:36Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e836a0b7f72dd3517400897428447eb557dec272", "message": "Remove bazel build files", "created_at": "2018-03-27T22:22:44Z", "repo": "accio", "file_sampled": false, "has_test_file": null, "has_impl_file": null}], "prs": []}