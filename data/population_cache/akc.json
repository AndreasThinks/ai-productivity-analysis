", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7887faaf88440630b101906ddc8ff74fff0a5822", "message": "Implement the cyc statistic", "created_at": "2012-12-07T04:31:53Z", "repo": "sym", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "97a782a1f9aad7caf27c7b3989b9fb3229b7bcd5", "message": "Correct an error in the documentation of 'avoiders'", "created_at": "2012-12-07T03:09:11Z", "repo": "sym", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5588d928731b05c60a90db059a5fd8cccef845ea", "message": "Implement a few more statistics.\n\nSmall ascents and descents; lmin values and indices.", "created_at": "2012-12-05T10:31:12Z", "repo": "sym", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f84229a6b667f22b932a3675315ae01419f902f9", "message": "Define single point deletions and shadow", "created_at": "2012-12-02T06:41:56Z", "repo": "sym", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2ebbc675cc8464bca54430b8a0beddd6834bab67", "message": "RankLex Ord instance for StPerm", "created_at": "2012-12-01T07:23:35Z", "repo": "sym", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a6a1e30bb3c4debcb910658cb79fdc3ead3fc189", "message": "Swap order of arguments to \"avoids\", and rename copies as copiesOf", "created_at": "2012-12-01T07:23:35Z", "repo": "sym", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "bda0b7a3e5859296c34c21d89436d9eee4aac51f", "message": "Provide a predicate to check if a permutation is simple", "created_at": "2012-12-01T07:23:05Z", "repo": "sym", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "52add5645aac74c4f288192929744e1d94a7ada3", "message": "Implement the dim statistic", "created_at": "2012-11-07T14:06:21Z", "repo": "sym", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1b70fa857a2