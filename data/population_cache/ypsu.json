6:44Z", "repo": "latex-to-unicode", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "fa93c1b9c5e23f8ec0affd5da01284365b3f223c", "message": "Add README.", "created_at": "2011-06-09T17:45:33Z", "repo": "latex-to-unicode", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "136525779bfb0990ef81efb7db2bde68826afdce", "message": "Simplify the makefile\n\nAnd strip the resulting binary for a smaller size.", "created_at": "2017-01-23T22:26:03Z", "repo": "myts", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "cd377c388e74f6b860c1a9a95f595cae55873da9", "message": "Fix the scrolling issues, take 4\n\nThis reapplies 2369dd5db6bfc895d7b1240e3b31d46a1699a887 \"Handle jump to line as\nin xterm\" and a6c4eb0a64d5ae445ca74abb4290394dbfb676e0 \"Fix another\njump-out-of-the-scroll-region bug\".\n\nWe need these after all. I've thought 8ed9aa32 would fix everything without\nthese but I can still find cases where it doesn't work (scrolling vim in tmux).\nNot only that but these patches had a silly bug in them and now that is fixed as\nwell.\n\nAlso, switch to an opt build.", "created_at": "2014-04-05T19:00:06Z", "repo": "myts", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8ed9aa32feca30cb121c2e743d849da2adb71142", "message": "Fix the scrolling issues, take 3\n\nThis also reverts 6f0e9379e0ad18bd619f3fad899c2d2dbe51f41f \"Properly fix the\nscrolling issues\".", "created_at": "2014-01-12T14:47:51Z", "repo": "myts", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "501927e01a58c80b2f678d25b698fe752025f117", "message": "Add a better fix for the split UTF-8 characters\n\nThe previous fix didn't think of short reads (e.g. a 868 long read).", "created_at": "2013-12-01T20:44:41Z", "repo": "myts", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5c43a3c93c6f924f6dff23dd82e15de304c5ea4c", "message": "Swap Left/Right nav keys so that DX and K3 match functionality", "created_at": "2013-12-01T18:07:38Z", "repo": "myts", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "fd9a7efe3d8c4c49b196810ab0f83a4653df0566", "message": "Add a prebuilt binary", "created_at": "2013-12-01T14:59:11Z", "repo": "myts", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "af2dbf1011d3ee58848b19b1fdccb09845c23d4d", "message": "Rename the target from myts.arm to myts", "created_at": "2013-12-01T14:57:48Z", "repo": "myts", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6354798e43df0bc76da036fdefc21f6b3d8f11c8", "message": "The \"sym\" button should behave as the real Alt-key", "created_at": "2013-12-01T14:55:13Z", "repo": "myts", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6f0e9379e0ad18bd619f3fad899c2d2dbe51f41f", "message": "Properly fix the scrolling issues\n\nThis reverts 2369dd5db6bfc895d7b1240e3b31d46a1699a887 \"Handle jump to line as in\nxterm\" and a6c4eb0a64d5ae445ca74abb4290394dbfb676e0 \"Fix another\njump-out-of-the-scroll-region bug\".", "created_at": "2013-12-01T14:37:47Z", "repo": "myts", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c7a795cab674f1d73aa807bfc599f77df4f288e8", "message": "Add support for ICH\n\nTmux uses this because xterm supports this so we need to support it as well.", "created_at": "2013-12-01T12:28:12Z", "repo": "myts", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d6be2296bbcd8cfb82adf7382775e7e4e5ca191d", "message": "Use terminus as the font", "created_at": "2013-11-30T22:35:26Z", "repo": "myts", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "669a7607cddfb631dc5d5ef898e91423f917bce5", "message": "Raise the minimum terminal sizes", "created_at": "2013-11-30T22:33:52Z", "repo": "myts", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "de7e157d635c64b739df6749a7f2b8de5d4efa8a", "message": "Add bdf2hex from the official distribution", "created_at": "2013-11-30T21:28:20Z", "repo": "myts", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a6c4eb0a64d5ae445ca74abb4290394dbfb676e0", "message": "Fix another jump-out-of-the-scroll-region bug", "created_at": "2013-11-30T21:25:06Z", "repo": "myts", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4c9bd25cb92ba9b06a1f31da74995bbaabff5fdb", "message": "Fix the split UTF-8 character handling", "created_at": "2013-11-30T21:15:32Z", "repo": "myts", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e9932d4e6d7589e635cf5c64872382a7203bd1e5", "message": "Increase the buffer sizes\n\nThis will reduce the number of problems with unicode characters being sliced\nbetween reads. You can see such slicing in tmux's separator lines: random\nquestion marks appear in the middle of the line.", "created_at": "2013-11-30T20:22:44Z", "repo": "myts", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0806f80625b2af72b1cdbe8a6bf62d011b18cae2", "message": "Fix the character deletion in UTF-8 mode", "created_at": "2013-11-30T17:03:26Z", "repo": "myts", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3ea15b07d4e9733e828540eaad349229af0f4056", "message": "Decrease intensity rather than just ignore some colors", "created_at": "2013-11-30T16:40:59Z", "repo": "myts", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "80fec6d8562052b1e15f5a425d7c4fb5fd1651c9", "message": "Add a note about the development process", "created_at": "2013-11-30T16:23:14Z", "repo": "myts", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2369dd5db6bfc895d7b1240e3b31d46a1699a887", "message": "Handle jump to line as in xterm\n\nThis fixes an annoying screen corruption when scrolling in vim under tmux.", "created_at": "2013-11-30T15:47:07Z", "repo": "myts", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f7d56820be534531b2d0436599e3cc843c1639df", "message": "Remove duplicates in the keydefs\n\nDuplicates are removed in the code. Defining the DX keys as last doesn't work\nanymore as the musl's qsort sorts differently and thus different entries will be\nremoved (not the first ones). Let's just have one definition for each keycode.", "created_at": "2013-11-30T12:30:46Z", "repo": "myts", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4ffb0d3fec9ee1aae639aadbc78ccf9ce7aee0b6", "message": "Use the foreground color for highlighting as well", "created_at": "2013-11-29T23:27:34Z", "repo": "myts", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "62ea12220334346a64847ab931afbc752e2663e0", "message": "Make things more readable by not allowing too dark background", "created_at": "2013-11-29T23:22:26Z", "repo": "myts", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8d8d19f5f768229735764b02d79ddd992cee2538", "message": "Fix the formatting of the README", "created_at": "2013-11-29T23:01:03Z", "repo": "myts", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "50c5d34a0d398dc0ea149c90441b8d8e2c4273c3", "message": "Add my note to the README", "created_at": "2013-11-29T22:58:14Z", "repo": "myts", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "dec32c1323e944db715221d13eb8ba7c833ad254", "message": "Set the Makefile to debug and use musl libc\n\nIf I create a static build with musl on my Raspberrry Pi using the standard\ntools and copy the resulting binary to the kindle it just works flawlessly!", "created_at": "2013-11-29T22:46:40Z", "repo": "myts", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1af7f2d33adcf5c1272f548b8bbccfa14b70fd7e", "message": "Add .gitignore", "creat