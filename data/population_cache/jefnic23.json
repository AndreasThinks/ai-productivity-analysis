:08Z", "repo": "the_movie_game", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "976db0f768e99e1d28ccf53276a7b5dce5fafa7c", "message": "Merge branch 'master' of https://github.com/jefnic23/the_movie_game", "created_at": "2021-04-07T19:20:49Z", "repo": "the_movie_game", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "26a9441c2d3a8c837e820be3e7b707aef856d356", "message": "fixed api call", "created_at": "2021-04-07T19:20:33Z", "repo": "the_movie_game", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "28f2aedf6b235b4f53f5216020c7eaf79d269df5", "message": "Update themoviedb.js", "created_at": "2021-04-07T18:51:05Z", "repo": "the_movie_game", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f7084a5fb9bbfd21b27ae9eafe3f38fe8fda33d5", "message": "moviedb javascript wrapper", "created_at": "2021-04-06T05:31:12Z", "repo": "the_movie_game", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0b8b3659fa602568e2a678d392e6a05261ad4a70", "message": "add ajax", "created_at": "2021-02-16T19:13:47Z", "repo": "the_movie_game", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f176b7f1afc5f04d45a9f60b294c21c6b65ff19a", "message": "ajax", "created_at": "2021-02-16T04:45:25Z", "repo": "the_movie_game", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "060d5fca108485940dd56299d7b954b1dbbb869c", "message": "add flask stuff", "created_at": "2021-02-15T04:09:56Z", "repo": "the_movie_game", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "71ede25a2a573f5cf20dd651429d2d606201931d", "message": "add flask stuff", "created_at": "2021-02-15T04:09:08Z", "repo": "the_movie_game", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ced11eb11d04582ffea3664796d30035371deedd", "message": "first commit", "created_at": "2021-02-14T23:25:05Z", "repo": "the_movie_game", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c6d4e2703fa9b09e8b71a9469169b3c1d9fae964", "message": "\ud83d\udd28 refactor(models.js): remove unnecessary blank lines\nThe blank lines between the model classes in models.py were removed to improve code readability.\n\n\ud83d\udd28 refactor(main.js): add park factor to createValues function\nThe createValues function in main.js was updated to include the park factor in the function parameters.\n\n\u2728 feat(main.js): add color coding to bets based on park factor\nThe createValues function in main.js was updated to add color coding to bets based on the park factor. Bets with a park factor greater than or equal to 1.5 are colored green, bets with a park factor less than or equal to 0.5 are colored red, and bets with a park factor between 0.5 and 1.5 are colored yellow.", "created_at": "2023-04-19T02:35:19Z", "repo": "zell_baseball", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c3e12216d337bc29bafed14ea8c165136a719d23", "message": "only 3.9.13 works right now", "created_at": "2023-04-02T17:20:00Z", "repo": "zell_baseball", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "94cf1b0a42cc7cd0e9a08e50c6c9cfbefe121be8", "message": "\ud83d\udc1b fix(baseball.py): catch all exceptions in Game function\n\ud83d\udd27 chore(runtime.txt): update Python version to 3.11.2\nThe Game function now catches all exceptions instead of just the AttributeError. This ensures that the function does not crash and allows for better error handling. The Python version in the runtime.txt file has been updated to 3.11.2 to ensure compatibility with the latest version of Python.", "created_at": "2023-04-02T17:11:59Z", "repo": "zell_baseball", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "35a19661bf410af1a7cc6266b657491577d36931", "message": "\ud83d\udd00 chore(requirements.txt): update dnspython and eventlet dependencies\nThe dnspython dependency has been downgraded to version 1.16.0 to fix compatibility issues with other dependencies. The eventlet dependency has been downgraded to version 0.30.2 to fix a bug that caused the application to crash.", "created_at": "2023-03-31T21:58:14Z", "repo": "zell_baseball", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5f91bc1203e105f08dcd8ed9ee182440002f9758", "message": "\ud83d\udd00 chore(requirements.txt): downgrade eventlet to version 0.33.0\nThe version of eventlet has been downgraded to 0.33.0. This was done to resolve compatibility issues with other dependencies.", "created_at": "2023-03-31T21:55:03Z", "repo": "zell_baseball", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5a40fc3126c5f71f11be2b585a456acde8d08783", "message": "\ud83d\udce6 chore(requirements.txt): add eventlet, gunicorn, and six packages\nThe eventlet package is added to support the use of WebSockets in the application. The gunicorn package is added to support the deployment of the application on a production server. The six package is added to support the use of some libraries that depend on it.", "created_at": "2023-03-31T21:48:20Z", "repo": "zell_baseball", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "65b06b0b1cef0f4f182977ac116aceb52127a4be", "message": "\ud83d\ude80 chore(requirements.txt): add new dependencies\nAdded dnspython, email-validator, fake-useragent, psycopg2, python-dotenv, and pytz to the requirements.txt file. These dependencies are required for the application to function properly.", "created_at": "2023-03-31T21:39:43Z", "repo": "zell_baseball", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5434473ad5e3514b80548481c9afd54a19d166e1", "message": "\ud83d\udc1b fix(baseball.py): fix typo in variable name\nThe variable name `GameID` was changed to `GameId` to match the correct attribute name. This fixes an issue where the `idfoevent` key in the `betData` dictionary was not being populated correctly. Additionally, an `AttributeError` exception was added to handle cases where the `odds` list is empty.", "created_at": "2023-03-31T21:34:33Z", "repo": "zell_baseball", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "083683971f6552e998808af2362c8a375b933a9e", "message": "\ud83d\udd28 refactor(apis.py): refactor schedule and betting_data functions\n\u2728 feat(apis.py): add make_request function\nThe schedule function has been moved from baseball.py to apis.py. The function has been refactored to use the make_request function. The betting_data function has been added to get odds from bettingdata.com. The make_request function has been added to make HTTP requests to URLs. This function is used by both the betting_data and schedule functions.\n\n\ud83d\udd25 chore(odds.py): remove unused betting_data function\n\u2728 feat(routes.py): import betting_data from new apis module and remove unused imports\n\ud83d\udd28 refactor(main.js): change betData.market.idfoevent to betData.idfoevent and betData.market.selections.find(x => x.name === \"Over\").idfoselection to betData.idfoselection\nThe betting_data function was removed as it was no longer being used. The betting_data function was moved to a new module called apis.py. The imports for the removed function were also removed. The main.js file was updated to use the correct properties for the betData object.", "created_at": "2023-03-31T02:03:54Z", "repo": "zell_baseball", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "41f8b52dc1917dbe3ef0fc1488bfe460f2d27376", "message": "\ud83d\udd25 refactor(baseball.py): remove fanduel function\n\ud83d\ude80 feat(odds.py): add function to get odds from bettingdata.com\n\ud83d\ude80 feat(routes.py): use betting_data function to get odds data\n\ud83d\udd25 refactor(main.js): remove getFanduel function and related code\nThe fanduel function is no longer used and has been removed. A new function betting_data has been added to get odds data from bettingdata.com. The betting_data function is used in the routes.py file to get odds data. The getFanduel function and related code in main.js have been removed as they are no longer needed.", "created_at": "2023-03-30T22:19:53Z", "repo": "zell_baseball", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f856b27a12d82cd379b931534b2a68d657b739db", "message": "\ud83c\udfa8 style(routes.py): reformat imports and remove unused imports\n\ud83d\udd12 chore(routes.py): add password hashing with pbkdf2_sha256\n\ud83d\udd12 chore(routes.py): add database instance to routes file\n\ud83d\udd12 chore(routes.py): add database models to imports\n\ud83d\udd12 chore(routes.py): add database views to imports\n\ud83d\udd12 chore(routes.py): add password reset email functionality\n\ud83d\udd12 chore(routes.py): add baseball schedule, game, and value functions\n\ud83d\udd12 chore(routes.py): increase max_decode_packets to 50 for Payload class", "created_at": "2023-03-30T22:08:55Z", "repo": "zell_baseball", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5da67c2be6d945e19e7fb1d8c8b0ad6a6dc37d6d", "message": "style(baseball.py, forms.py): remove unnecessary blank lines and add blank lines between classes and functions\nfeat(forms.py): add MiscForm class for handling miscellaneous form data\n\nrefactor(models.py): improve readability of get_reset_password_token and verify_reset_password_token methods\nrefactor(views.py): remove unused imports and update import statement for MiscForm in views.py", "created_at": "2023-03-29T02:49:58Z", "repo": "zell_baseball", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2b1467ca37f63429a40873b3a60411fb2c126669", "message": "reinstalled dependencies", "created_at": "2023-03-28T22:31:46Z", "repo": "zell_baseball", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c0d6eb636f2e17a0ef1b60b5570586cebe6ac37b", "message": "minor tweaks", "created_at": "2023-03-28T22:18:37Z", "repo": "zell_baseball", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a330361a26f9d434b2b9b436434e98f8c177c59b", "message": "fix password reset form", "created_at": "2022-05-20T16:32:12Z", "repo": "zell_baseball", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "765673b496930822863313eec0dbe6c5f176ec73", "message": "more css fixes", "created_at": "2022-05-19T22:03:43Z", "repo": "zell_baseball", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "029031d783224bc2415d62bdf8cc804ce3053557", "message": "more mobile css fixes", "created_at": "2022-05-19T19:31:18Z", "repo": "zell_baseball", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c35c34b575cb36f4544b54ccc2032fee5bcadeae", "message": "fixed total popup on mobile", "created_at": "2022-05-19T19:19:30Z", "repo": "zell_baseball", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "85f8215ebb4de4cbb93387bf494c17d5f784b50e", "message": "Merge branch 'main' of https://github.com/jefnic23/zell_baseball", "created_at": "2022-05-19T16:33:00Z", "repo": "zell_baseball", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ca91672383081befe5c0ed23ed1b85d5f3644bf9", "message": "PvB overhaul", "created_at": "2022-05-19T16:32:51Z", "repo": "zell_baseball", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0092656d9b718a848014a28ffb36af3e0796c24a", "message": "Update README.md", "created_at": "2022-05-18T22:23:24Z", "repo": "zell_baseball", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7940ce3597a8edbfbb0e1605a81c561b2a550382", "message": "fixed PvB matchups", "created_at": "2022-05-18T18:09:19Z", "repo": "zell_baseball", "file_sampled": false, "has_test_file":