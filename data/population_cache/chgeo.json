: "cds-swagger-ui-express", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f4dbb63934b360f913ae06d8921f8badefcd3e73", "message": "Set release date", "created_at": "2024-10-02T11:49:28Z", "repo": "cds-swagger-ui-express", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "56bf61fb5fb32fae98066f0b94211327b48dd021", "message": "Allow relative service root paths (#152)\n\nThe default value for option `apiPath` is now `/`, allowing more flexible control\r\nover the root path where the CDS services are served.\r\nFormerly, it was not possible to set root path _relative_  to the current host,\r\nlike `abc.com/1234-appid/$api-docs/...`, `abc.com/5678-appid/$api-docs/...`.", "created_at": "2024-10-02T11:48:36Z", "repo": "cds-swagger-ui-express", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "932524154161f3837dbc3a27f6248662eefb1977", "message": "Fix code scanning alert no. 1: Incomplete string escaping or encoding (#154)\n\nCo-authored-by: Copilot Autofix powered by AI <62310815+github-advanced-security[bot]@users.noreply.github.com>", "created_at": "2024-10-02T11:31:21Z", "repo": "cds-swagger-ui-express", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "20bd67ab5af190fed952029dd23b495758b707a4", "message": "Weekly scan", "created_at": "2024-09-21T10:15:10Z", "repo": "cds-swagger-ui-express", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d7ea722b9c219c141d48bf30df1c1fe656db57d7", "message": "Add cds-types", "created_at": "2024-09-21T10:07:20Z", "repo": "cds-swagger-ui-express", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "259ea0b04da978ddf65444e59de76c197efaf094", "message": "Add sqlite (#150)", "created_at": "2024-09-20T13:16:23Z", "repo": "cds-swagger-ui-express", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8131a5f52625fa8955dc465b014435a3ce06fda9", "message": "Glitch", "created_at": "2024-08-14T14:43:15Z", "repo": "cds-swagger-ui-express", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c15b6b3017117438be2cd1b378de0da728df264e", "message": "Glitch", "created_at": "2024-08-14T14:42:38Z", "repo": "cds-swagger-ui-express", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2fdd8a045ea0f31774eb8ac8567eab10a5466d27", "message": "Use `@cap-js/openapi` instead of `@sap/cds-dk` (#134)\n\nAlso test w/ Node 22", "created_at": "2024-07-15T08:37:07Z", "repo": "cds-swagger-ui-express", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "afb50f0c70d0296376305d01c118eea71702b51c", "message": "Debug log for swagger document", "created_at": "2024-04-12T11:09:48Z", "repo": "cds-swagger-ui-express", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f3e988bada6019a09f0f66cc4bf3a081cf24d099", "message": "Sample for swagger auth", "created_at": "2024-04-11T12:50:29Z", "repo": "cds-swagger-ui-express", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6b96e0f3fb105deab1a5613c81912604cc872424", "message": "Changelog, cosmetics", "created_at": "2024-01-18T18:01:38Z", "repo": "cds-swagger-ui-express", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "07cc93ee9077a92455966ce28f0618effb30011d", "message": "Auto registration as CAP plugin (#87)\n\n- The middleware registers itself when loaded as a CAP plugin\r\n- Declarative configuration through `package.json` / `cds-rc.json`\r\n- Programmatic registration is still possible, but disables auto mode then\r\n- Make dependency to `@sap/cds-dk` optional.\r\n   If running with the `cds` executable during development,\r\n   the dependency is fulfilled anyways. Only when running as part of\r\n   a deployed appi with `cds-serve`, then such a dependency is needed.", "created_at": "2024-01-18T17:50:53Z", "repo": "cds-swagger-ui-express", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3439f847a355ee9bd8e660a5ba699eee0c75513f", "message": "Bump to 0.8.0", "created_at": "2023-12-04T18:24:22Z", "repo": "cds-swagger-ui-express", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2e7681422e2b24d1bf64386c3a5d561e3d54d02d", "message": "Changelog cosmetics II", "created_at": "2023-12-04T17:45:22Z", "repo": "cds-swagger-ui-express", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "566c9570a23e344478a173147642d188ccbbb15d", "message": "Changelog cosmetics", "created_at": "2023-12-04T17:44:34Z", "repo": "cds-swagger-ui-express", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e8028079d2656bdcb9e32c2c2e27b822677cc1b8", "message": "Update GH actions", "created_at": "2023-12-04T17:42:04Z", "repo": "cds-swagger-ui-express", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1f645ecd0fdafd777a5ab231ce1fc94426560409", "message": "Drop Node 16", "created_at": "2023-12-04T17:40:12Z", "repo": "cds-swagger-ui-express", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2000cc5d3e36637267b4e9cd9403dbc34377ebee", "message": "Package lock", "created_at": "2023-12-04T17:38:22Z", "repo": "cds-swagger-ui-express", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b9dea6afc9b18e667270854ee6a0cd0a4c2aa6f8", "message": "Shorter version specs", "created_at": "2023-12-04T17:36:54Z", "repo": "cds-swagger-ui-express", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7d674c0b97ad058c23ed1136302fabf294ead9c8", "message": "Bump min. Node version", "created_at": "2023-12-04T17:35:56Z", "repo": "cds-swagger-ui-express", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e683c44355d21394b21b95fea4b9fa7e80aeb3d7", "message": "Manual release", "created_at": "2023-12-04T17:34: