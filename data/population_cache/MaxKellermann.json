sult\n\nIf the resolver returns no address (e.g. upon NXDOMAIN), ferm should\nreturn an empty array instead of returning \"undefined\"; it should\nsuppress the calling rule instead of generating a broken one.\n\nCloses https://github.com/MaxKellermann/ferm/issues/85", "created_at": "2022-05-05T13:26:16Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "af082cdc9f00075830dfe6b2b6bb69690873de81", "message": "defer the cat() call if parameters are deferred\n\nFixes crash because cat() does not support deferred parameters.\n\nCloses https://github.com/MaxKellermann/ferm/issues/86", "created_at": "2022-05-05T13:21:29Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "af37d987ea56909052523a33d9120417ba14e293", "message": "test/resolve/with_cat: new unit test\n\nTest part 2 of https://github.com/MaxKellermann/ferm/issues/86", "created_at": "2022-05-05T13:21:07Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "47569de854c17aff690ebb177625aefc5d9178fd", "message": "recursive realize_deferred() call\n\nTo support nested deferred evaluation.", "created_at": "2022-05-05T13:15:40Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7d8d8667e7d835adbae6a345b2cd18abe4003ca6", "message": "add realize_deferred() call to unfold_rule()\n\nFixes part 1 of https://github.com/MaxKellermann/ferm/issues/86", "created_at": "2022-05-04T15:14:57Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3bb73820164227a17d30cdd5babf4e450b8bd3b5", "message": "test/resolve/with_ipfilter: new unit test\n\nTest part 1 of https://github.com/MaxKellermann/ferm/issues/86", "created_at": "2022-05-04T15:14:21Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "728d21d7540c9b570047222fa9627eebf0b2a8a5", "message": "support \"MASQUERADE random-fully\"\n\nCloses https://github.com/MaxKellermann/ferm/issues/80", "created_at": "2021-02-07T20:49:58Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8e263057763592b15d0c1a7fea633038ddb2e0f1", "message": "increment version number to 2.7", "created_at": "2021-02-07T20:48:46Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "132481ac627cc9beb402faf0a339b3341adffd7d", "message": "release v2.6", "created_at": "2021-01-30T12:24:35Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c418c1e27202d7bd8e5f0400b68e937d7d4e20c7", "message": "increment version to 2.6", "created_at": "2021-01-30T12:24:33Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "63c1b1ca0770186742beef03217ce811b750c1f9", "message": "stricter regex for numeric IPv6 addresses, require two colons", "created_at": "2021-01-30T12:09:45Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9502e7b3a411298f5ad323181535b53df043d7d9", "message": "@resolve allows numeric IP address with netmask prefix", "created_at": "2021-01-30T12:09:33Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "21e8e9d074c78cebdf0286c8012ebb6acd65d2cf", "message": "@resolve filters out numeric IP addresses for the wrong domain", "created_at": "2021-01-30T12:01:37Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d7a28d95ca71ac0ee3e02e4c40682a2437da963f", "message": "move code to identify_numeric_address()", "created_at": "2021-01-30T11:57:56Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b18a8f2cfa73a851b92e03a70b2431f8df66614c", "message": "NEWS: fix typo added by commit 23355141bb39f659acfd3af9d0cecd8d461ce965", "created_at": "2021-01-30T11:41:22Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b88c5abb241318771f5348957c6afd44c90c7f15", "message": "CT: support \"--zone-orig\", \"--zone-reply\"", "created_at": "2021-01-30T11:40:11Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a1cd9e7d922341b7a481759f9f6fae27ec94c7fb", "message": "doc/ferm.pod: document the \"CT\" target\n\nCloses https://github.com/MaxKellermann/ferm/issues/72", "created_at": "2021-01-30T11:38:47Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a1ef084785b857478770cab08eacbac4b219ad3f", "message": "fix negated @ipfilter/@resolve\n\nFor negated values, a `realize_deferred()` call was missing.\n\nRegression by commit 31bb5d33a2b68ecf34f2a3855f239eae6ab9a670\n\nCloses https://github.com/MaxKellermann/ferm/issues/78", "created_at": "2021-01-30T06:55:03Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ee72db30e49c1b1bc9e15e9631c83ccfaf19fe17", "message": "test/misc/ipfilter.ferm: add test for @ipfilter with negation\n\nCrashes currently (see https://github.com/MaxKellermann/ferm/issues/78).", "created_at": "2021-01-30T06:53:38Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e5d336e833af13bacb2facc02e0680ebfdc12ad9", "message": "test/misc/ipfilter.ferm: add test for @ipfilter in variable declaration", "created_at": "2021-01-30T06:51:23Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "14c1a7b56f5bfb767a5a49073bba20e9e168f67b", "message": "test: use --test-mock-previous for the \"preserve\" tests\n\nUsing network namespaces for the unit tests is a clever idea, but\nunfortunately it is very fragile.  It breaks if the kernel doesn't\nhave iptables support or if the iptables tools are not installed, and\nrequires root privileges.\n\nInstead of going through all those hoops, let's just mock the previous\niptables ruleset.", "created_at": "2021-01-30T05:50:31Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "73e8cd70a356c24ec3310db8d2cb9738634b3a30", "message": "add option --test-mock-previous for unit tests", "created_at": "2021-01-30T05:50:28Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c83b1aa97d682f95a958c5904df19dc8d31ab5fb", "message": "move code to read_previous()", "created_at": "2021-01-30T05:50:26Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "137daf0c7e75ce0e9bac2be1065896034950bbde", "message": "Merge branch 'preserveprefix' of git://github.com/awelzel/ferm", "created_at": "2021-01-30T05:50:12Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "23355141bb39f659acfd3af9d0cecd8d461ce965", "message": "NEWS: remove some garbage text added by previous commit", "created_at": "2020-02-26T18:21:55Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "57ed2a83a363c096b980d73f41fab417d040c19b", "message": "NEWS: mention the previous commit", "created_at": "2020-02-26T18:01:29Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "392062953871e1ddce3e9a20cbfb096802db906d", "message": "Merge branch 'jool' of git://github.com/julianschuh/ferm", "created_at": "2020-02-21T16:47:03Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2a0fedbb3903c5b0370ab8c5774fa6839914b35e", "message": "restore x-bit on src/ferm again\n\nGot lost yet again, sigh.", "created_at": "2020-02-20T17:19:10Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8cd1b7f561a6981bf3593640ce8510b2f736fa8f", "message": "Merge branch 'master' of git://github.com/nepella/ferm", "created_at": "2020-02-20T17:04:35Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "bde1f876ee16cf2c44232e543661cbadc8f3c014", "message": "Merge branch 'fix-multitable' of git://github.com/atonkyra/ferm", "created_at": "2020-01-24T12:06:34Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "96e333449bae5068d05434e4d1e341de81376cbe", "message": "increment version number to 2.5.2", "created_at": "2020-01-24T12:04:38Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "71a7264125f78ff548ab14e19af01c44ecd59413", "message": "release v2.5.1", "created_at": "2020-01-24T11:56:05Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "040bbf268276c781642c90bc61f92ee64a6ba115", "message": "add shortcuts \"sports\", \"dports\", \"comment\"\n\nCloses https://github.com/MaxKellermann/ferm/issues/33", "created_at": "2020-01-24T11:53:31Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3ba3d07dbbec35efde60807b0cdf5370a7712752", "message": "fix $LINE after function call\n\nDon't show the function definition's line number.\n\nCloses https://github.com/MaxKellermann/ferm/issues/34", "created_at": "2020-01-24T11:33:52Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "95f75f3d6e9b87a003b7218f6b50a1e841a2b7fc", "message": "test/misc/line: new unit test for $LINE\n\nFailing currently due to\nhttps://github.com/MaxKellermann/ferm/issues/34", "created_at": "2020-01-24T11:32:33Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "df45a48b2d0a47f111a4fc14412352780b65dc45", "message": "default to --fast when Getopt::Long is not installed\n\nWhen --fast was made the default in commit c644687dfd593 (twelve years\nago), I forgot to update the \"not $has_getopt\" branch as well.\n\nCloses https://github.com/MaxKellermann/ferm/issues/53", "created_at": "2020-01-24T11:05:12Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1d65388566831383b2882b40591f28c511c4fd15", "message": "fix lazy subchain protocol propagation for all protocols\n\nCommit 39ba36f5b3aa1f6a0eedbced5df335e4efd50e23 made the protocol\npropagation to subchains lazy, i.e. only if \"sport\" and \"dport\" was\nspecified.  This however was only a special case for \"tcp\" and \"udp\",\nbut broke every other protocol.\n\nThis commit adds a generic implementation.\n\nCloses https://github.com/MaxKellermann/ferm/issues/54", "created_at": "2020-01-24T10:50:45Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4bb2a925e91f40310b494037e54c194f53b89780", "message": "test/misc/subchain: add unit test for \"proto icmp\" with @subchain\n\nTests https://github.com/MaxKellermann/ferm/issues/54", "created_at": "2020-01-24T09:56:59Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3e330e8024c6a2c0b1727b8791c07a6c3c23ad9f", "message": "test/multiport: add test for range splicing", "created_at": "2020-01-23T18:54:26Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e9832e2c6c3992a2e694e9ba730d663bec1e2e87", "message": "Merge branch 'fix-multiport-ranges' of git://github.com/ivandeex/ferm", "created_at": "2020-01-23T18:52:21Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f7cd1fc3715b7b324db81ebaa8ef7766ad909855", "message": "increment version number to 2.5.1", "created_at": "2020-01-23T18:49:45Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0134ff41a5579abf6f84db43b1585afa86a51bac", "message": ".travis.yml: switch to Ubuntu Xenial, drop old Perl versions and add Perl 5.30", "created_at": "2020-01-23T18:46:37Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "462927f0fe334513ce464d1069916973b34950c8", "message": ".travis.yml: drop \"sudo: false\", deprecated", "created_at": "2020-01-23T18:46:37Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3d3d18a0629c13dfca5980c5cd4d2611687babdc", "message": ".travis.yml: use Ubuntu Trusty to fix Perl 5.18 and 5.14\n\nWhen Travis-CI switched the default from Trusty to Xenial, those two\nPerl versions ceased to work because they are not available in\nXenial.  This is a minimal fix for the problem.", "created_at": "2020-01-23T18:34:02Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a2203f14bcd3f0bb67ec7298387597a032bb30c5", "message": "make src/ferm executable again\n\nThis mode was accidently removed in 590c8bd324796e", "created_at": "2020-01-23T18:16:41Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ca95255d89343e10d219f1716238d14b1fa8f186", "message": "NEWS: add missing release date\n\nCloses https://github.com/MaxKellermann/ferm/issues/51", "created_at": "2020-01-23T18:16:18Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "590c8bd324796e151b1d50c7075c4b8f00bf0c19", "message": "release v2.5", "created_at": "2019-11-22T21:28:24Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "66e8d84155f254111e2472ce7e58b3ea0a2bd339", "message": "warn when chosen subchain name already exists\n\nCloses https://github.com/MaxKellermann/ferm/issues/25", "created_at": "2019-11-22T21:26:57Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3e5598dd1af647cdc60974baeab08372ce6aa3cd", "message": "doc: clarify that --domain also selects the default domain\n\nCloses https://github.com/MaxKellermann/ferm/issues/45\n\n(By declaring that the observed behavior is correct, and only the\ndocumentation was wrong.)", "created_at": "2019-11-22T21:17:16Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4ac7a32c8054ab96e3bf85290dc03cd60f2fed75", "message": "fix $TABLE and $CHAIN evaluation in multi-table/multi-chain rules\n\nJust like commit 729e3ed18bd07b313eaa7d7884fb75f8423747e2, but for\n$TABLE and $CHAIN instead of $DOMAIN.\n\nCloses https://github.com/MaxKellermann/ferm/issues/46", "created_at": "2019-11-22T20:49:39Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "89af92c822da152c62caefef2ba8d7666e9f9410", "message": "use to_array for \"chain\"", "created_at": "2019-11-22T20:42:17Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "39ba36f5b3aa1f6a0eedbced5df335e4efd50e23", "message": "copy protocol specification to subchains only if needed\n\nCloses https://github.com/MaxKellermann/ferm/issues/49", "created_at": "2019-11-22T20:35:22Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "843da31f3d5b22d48468493bf8a274a471148241", "message": "test/misc/join: test for @join()", "created_at": "2019-11-22T20:21:44Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2f50588586f3d32ab7c58a0191e54bd8754b0c14", "message": "test/misc/cat: test for @cat() with array", "created_at": "2019-11-22T20:21:35Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5daa56ca2164b7e8495932a7f953a9bcd1531ca8", "message": "import-ferm: don't merge options which allow only one string parameter\n\nFor example, \"mod comment comment (foo bar)\" is illegal in ferm, and\nthus import-ferm shouldn't emit such a rule.", "created_at": "2019-11-22T20:20:52Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c5c95b469d8424797d4b48b55ae7b11aa29545ac", "message": "add prototype for flatten()\n\nFixes \"main::flatten() called too early to check prototype\" if it gets\ncalled recursively.", "created_at": "2019-11-22T19:49:00Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c553619b943a63c632b9405b6a4b22265612ab2a", "message": "add function @join", "created_at": "2019-11-22T19:42:16Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "51f05c38503c958d625f67573e5ffa47f623a4c7", "message": "allow passing arrays to @cat\n\nCloses https://github.com/MaxKellermann/ferm/issues/39", "created_at": "2019-11-22T19:27:13Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "cc07648b08983064e43b88501c705c7f0c8f5034", "message": "move code to cat()", "created_at": "2019-11-22T19:16:20Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f90435003265a6a0c4b5bf3db1a842db2751593f", "message": "add code comment for legacy tools", "created_at": "2019-11-22T19:08:06Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "47b78b683d3d8a33e37ff8bf1816054906966302", "message": "call \"legacy\" xtables tools because nft based tools are incompatible\n\nApparently, /usr/sbin/iptables-restore refers to the \"nft\" based tools\non some installations, and those are incompatible enough that they\nsometimes break ferm.  To fix this, explicitly, refer to the \"legacy\"\ntools.\n\nCloses https://github.com/MaxKellermann/ferm/issues/47", "created_at": "2019-11-22T19:04:57Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d9fcee7575bb51a5761c3776fda4e9146e8ecf2e", "message": "add /usr/sbin to hard-coded search path\n\nApparently, Debian has moved those executables to /usr/sbin (with some\ncompatibility symlinks in /sbin), so let's add this, just in case ferm\ngets called by a non-root user (to \"compile\" the ferm rules to\niptables commands).", "created_at": "2019-11-22T19:03:35Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "021d9d6c0cfe3d4665fc55442a744f369027acf4", "message": "add variable @path, prepare for reusing it", "created_at": "2019-11-22T19:03:05Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "17491b0e74cfd203e9788cfd79edcb2e0b424fa0", "message": "NEWS: mention RTPENGINE", "created_at": "2019-10-25T08:18:56Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d323e2291cef55a26f1158cd9263f3fed4c1abea", "message": "Merge branch 'dual-stack-resolve' of git://github.com/paravoid/ferm", "created_at": "2019-01-25T13:19:50Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8381e6dba30574abf07696570d7cb752a3dcd918", "message": "Merge branch 'ebtables-atomic' of git://github.com/atonkyra/ferm", "created_at": "2019-01-25T13:10:40Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d993bb339828e965a9a4fb298cd56d4309a07991", "message": "doc/ferm.pod: mention the \"mod\" shortcut for \"module\"\n\nCloses #28", "created_at": "2018-10-26T16:57:41Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "22a0a83757ef850ebb1901a3cebf7afd2741302d", "message": "doc/ferm.pod: mention the \"proto\" shortcut for \"protocol\"", "created_at": "2018-10-26T16:57:41Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "dedd4cc6af2d2e9eeb422a311b65a6324bc5cea6", "message": "src/ferm: make executable\n\nThis mode got lost in commit 10a6631a52befc6cf8172a65f4629def58f8a684", "created_at": "2018-10-26T16:47:26Z", "repo": "ferm", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e9bcd53307e6cf32aeca