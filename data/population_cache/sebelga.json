efore saving the entity.\r\n\r\nfix #206", "created_at": "2019-12-08T10:39:07Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "94b74d8636d50369ad9aa8468da8241aac9091f5", "message": "fix(gstore.save()): update \"modifiedOn\" property on entities (#209)\n\nWhen entities have a \"modifiedOn\" property declared on their schema, saving the entity (with\r\nentity.save() or gstore.save()) will update update the property with the current time.\r\n\r\nfix #202", "created_at": "2019-12-08T05:44:58Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4a7e2005994f96de985be6c212c2e4966a365003", "message": "Update Travis build url", "created_at": "2019-11-08T04:06:01Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4cf8aa54caafe655d26c382683892f547cfa3fc9", "message": "chore: execute integration tests on CI (#205)", "created_at": "2019-11-08T03:56:25Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5fec345bc3ee9af1964b781c1cdf1b177e4818f0", "message": "chore(tests): convert tests to Jest + Typescript (#204)", "created_at": "2019-11-07T20:14:00Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c8104b6471e16354eb26051d63214fc9fe464ef5", "message": "chore(release): 7.2.3", "created_at": "2019-10-26T19:13:50Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e4935788b93e01be7c5cb57768247bf80614ae52", "message": "chore(types): expose Typescript interfaces/types (#201)\n\nfix #196", "created_at": "2019-10-26T19:10:29Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8e19a157e228ff6225a82070c61e34e0fe808646", "message": "fix(findOne): add missing `readAll` option (#200)", "created_at": "2019-10-26T19:09:52Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0ec188d843a07cb935e03c16044da709d1b74896", "message": "Fix(cache): Get multiple keys (#198)\n\n\r\nfix #187", "created_at": "2019-10-24T18:27:30Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "43b1b1e6710593eb1ff193a9520a001529ed7f44", "message": "chore(release): 7.2.2", "created_at": "2019-10-01T21:09:46Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7c3e5b0e172efb4b3d141cd40f3e30f38340bf9e", "message": "fix(typings): add Methods generic to Model<T, M>", "created_at": "2019-10-01T15:34:03Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7337c1fb1e61002cb611693b715c83c69cb6c5a2", "message": "chore(release): 7.2.1", "created_at": "2019-09-26T10:29:08Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "22bff864a38a294f7bd3bea3d31a14aab7a5b01c", "message": "chore(npm package): fix missing files in npm tarball", "created_at": "2019-09-26T10:28:41Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e51829a3197798994d67adfdebcb8280fa7a3dc9", "message": "chore(release): 7.2.0", "created_at": "2019-09-26T10:22:24Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "43d9dc22bbbd017fade88ede920aca705b12f430", "message": "feat(Typescript): Improve typings support\n\nThe source code has been converted to Typescript. As a result, typings support has been greatly improved in gstore.", "created_at": "2019-09-26T10:07:58Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c58c7bf727d9076360a6d3fe5efa9aa6da3f97b4", "message": "chore(release): 7.1.0", "created_at": "2019-09-13T15:11:44Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "dbf98611ee29e73bc0092906e25c24b521ecc12f", "message": "feat(auto-unindex): add Schema option to auto unindex large properties (#183)\n\nSince version 4.3 of the Datastore client you can specify that large properties are automatically\r\nnot indexed. In gstore node there is a new option on the schema \"excludeLargeProperties\" that you can set to true to benefit from it.", "created_at": "2019-09-13T15:06:17Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "96b0f798135aa4f91f199e55e16d721e12ae6687", "message": "Update README.md", "created_at": "2019-09-12T13:24:52Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "cfeef9fda39a43a8d9a159366d52b8a809dfd249", "message": "chore(release): 7.0.0", "created_at": "2019-09-11T06:33:39Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c9da35b8b08124fef7ad41c2ca8c76fac21c4ba4", "message": "fix(excludefromindexes): update logic to add all properties of Array embedded entities (#182)\n\nThe v4.2.0 of the Datastore client allows wildcard \"*\" to target all the properties of an embedded\r\nentity. The logic to define the Array of excludeFromIndexes has been updated to make use of it.\r\n\r\nfix #132", "created_at": "2019-09-11T06:32:22Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "cc11e0294302bb1df9053ab606a9619817bc0bf9", "message": "fix(model): throw NOT_FOUND error when trying to update a Model that does not exist (#181)\n\nfix #164", "created_at": "2019-09-10T07:48:21Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "15a713ac600b35225df02186a595a6cc3fc3259b", "message": "fix(entity): add \"id\" property to entity after it has been saved (#180)\n\nfix #172", "created_at": "2019-09-10T06:52:57Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "75dc8690861d34f416f5e1793a6db973ad583bd4", "message": "fix(entitykey): remove convertion of string number to integer for entity key id (#179)\n\nThe live Datastore treats the same way User.get(\"123\") than User.get(123). Both return the entity with the Key.id being \"123\". The conversion from string to an integer has been removed inside gstore and let to the consumer to implement if needed.\r\n\r\nBREAKING CHANGE: The \"keyType\" Schema option has been removed as it is no longer needed. Also, as gstore does not parse the id anymore, running your project against the Datastore emulator locally might break as the emulator treats differently User.get(123) than User.get(\"123\"). Auto-allocated ids are integers and need to be provided as integers for the Emulator.\r\n\r\n#168", "created_at": "2019-09-10T06:13:08Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "16999cb124941fb08304aba7dc9acca756dde449", "message": "chore(package): remove unnecessary files from npm package", "created_at": "2019-09-10T04:00:10Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7fa94b18dc7ac313e1236e456b297fc5fb9b1206", "message": "chore(Dependencies): Update lib dependencies (#178)\n\nNode v8.x end of life is December 31st, 2019. Please upgrade to v10.x\r\n\r\nBREAKING CHANGE: Node version 8.x not supported anymore. Upgrade to v10.x or superior.", "created_at": "2019-09-09T07:57:38Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ac52ffba58530df7e59c49d6439b8183bd12e59e", "message": "chore(Dependencies): Set google-cloud datastore as peerDependency (#177)\n\nBREAKING CHANGE: The @google-cloud/datastore package is not defined  anymore as a dependency of gstore-node. You will need to manually install it in your project.", "created_at": "2019-09-08T13:22:52Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "349ffe9f284d3315307a2e0f88e3fb5c01d3eac5", "message": "chore(release): 6.0.2", "created_at": "2019-04-26T13:49:07Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "bf4325d502c5dc88fd5bc3407483e7eaea184588", "message": "Merge branch 'master' of github.com:sebelga/gstore-node", "created_at": "2019-04-26T13:47:29Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "fbf7702c806ee07b7639c63bbb0a1ff250b99eb5", "message": "refactor(typings): change schema prop type definition", "created_at": "2019-04-26T13:47:25Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "76a0db20671f981304dbad50ec45e72e18008b2a", "message": "chore(license): change to Apache 2.0", "created_at": "2019-04-26T09:08:30Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3e4bfbcd82cd0bc32b79e4375c8ea05f66b888ca", "message": "chore(release): 6.0.1", "created_at": "2019-03-26T09:58:16Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f91fc394b745139e60dc78df3a4c8431ca8f3c20", "message": "fix(Typescript): Add missing export types", "created_at": "2019-03-26T09:56:49Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "89781ef9d583afccd87925987d2f15d321349ecd", "message": "chore(release): 6.0.0", "created_at": "2019-03-07T10:13:51Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "45e68fc067be5b0703220849186ae154e3a6c111", "message": "fix(Model.get()): Consistently return an Array when providing an array of ids (#155)\n\nBREAKING CHANGE: When an Array of ids is provided to Model.get(), gstore will now consistently return an Array. In earlier versions, if an array of one id was provided, gstore would return a single entity instead of an array containing the entity.\r\n\r\n#134", "created_at": "2019-03-07T10:13:11Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a91fa9683d65ffd93c54ef293fd38f4426d36d5c", "message": "chore(release): 5.0.2", "created_at": "2019-03-07T09:35:18Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "afdca6e61a394b8737919e0ea748945f13f5f6d3", "message": "refactor(Model.get()): Rename vars and prevent possible future bug for undefined or null data fetche", "created_at": "2019-03-07T09:30:48Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a24c75a5afcc9c3fc618d4c52091870580e4d19f", "message": "fix(Entity): Allow saving an entity that has been populated", "created_at": "2019-03-07T08:51:55Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "cb7c8be62e0ace370d889ffacdd0471d91043375", "message": "chore(release): 5.0.1", "created_at": "2019-02-05T08:09:09Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b25b3130d1965cbfbb6a85b1472a06f2150f921a", "message": "chore(editorconfig): Change tab size from 4 to 2", "created_at": "2019-02-05T08:06:01Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a23dbe1f4d156b7c225e79f6b1adb2179e377627", "message": "chore(Typescript): Add missing \"instances\" export from type definition file", "created_at": "2019-02-05T08:00:21Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c22df6e846fba305eb9b7903859ca4e35744436c", "message": "chore(release): 5.0.0", "created_at": "2019-02-04T08:41:14Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3f27d4c86e223dc0aeec6181900e86dbd0a615b7", "message": "refactor: Change gstore instantiation to be consistent with es modules (#149)\n\n\r\nBREAKING CHANGE: The new way to create gstore instances is with \"new Gstore(<config>)\". Refer to the\r\ndocumentation.", "created_at": "2019-02-04T08:38:53Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e4cfaa632073fea9923e2c7d4ee9b52853601b1f", "message": "fix(Model.update()): Fix bug in Model.update() inside a transaction (#148)\n\n#144", "created_at": "2019-02-03T18:56:24Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "951cad3afcc0459b82037d797a3a957d8b51d96c", "message": "chore(Dependencies): Update @google-cloud/datastore to v3 (#147)\n\n#143", "created_at": "2019-02-03T18:49:56Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "72fff67b064e2498b9081d3377f3bc6b0a76109c", "message": "feat(Populate): Fetch entities references in Model.get() and queries\n\nIf an entity property value is a reference Key to another entity, we can now populate that other\r\nentity by chaining .populate(<refs>, <properties>) calls to Model.get(), queries and on entity instances.\r\n\r\nBREAKING CHANGE: Callback (hell) are not supported anymore as the last argument of gstore methods. Only Promises are returned.\r\n\r\nBREAKING CHANGE: Node runtime must be version 8 or superior\r\n\r\nBREAKING CHANGE: The old Schema property types \"datetime\" and \"int\" have been removed. Date and Number types should be used instead.", "created_at": "2019-02-03T16:36:29Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c8c73f10ce2ae4d80825287b791a95f99bf8ca6f", "message": "chore(release): 4.3.3", "created_at": "2018-12-29T09:40:54Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4ba1ce621638d98ba3611f845b4c1486c85bc8b6", "message": "fix(Sanitize): Remove non writable property on Joi schema (#140)\n\n#139", "created_at": "2018-12-29T09:39:42Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7f89cbc83ae6febd1a725e15799cfc7117f7200e", "message": "Update README.md links to doc", "created_at": "2018-12-22T10:08:46Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f8eb10dc2e260b418caebe79e329f6712e8a02de", "message": "chore(release): 4.3.2", "created_at": "2018-12-21T18:50:18Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e86a875e0e4350f2c1494f2d0ada40d269bce8f3", "message": "fix(Model): Update validate() to not sanitize prop where write is set to false (#138)", "created_at": "2018-12-21T18:48:42Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "03bcf53c2555ba74d7bb7f2a66ac968e64dc4902", "message": "fix(excludeFromRead): Make sure segment exist before trying to access it when deserializing", "created_at": "2018-12-04T09:12:40Z", "repo": "gstore-node", "file_sampled": false, "has_test_file": null, "has_impl_file": null}], "prs": [{"created_at": "2020-12-15T15:46:14Z", "body_length": 35}, {"created_at": "2020-12-15T11:08:56Z", "body_length": 60}, {"created_at": "2020-12-15T11:00:39Z", "body_length": 135}, {"created_at": "2020-05-09T14:06:02Z", "body_length": 271}, {"created_at": "2019-12-15T11:28:58Z", "body_length": 80}, {"created_at": "2019-12-13T06:41:49Z", "body_length": 293}, {"created_at": "2019-12-10T13:22:16Z", "body_length": 132}, {"created_at": "2019-12-08T10:34:52Z", "body_length": 195}, {"created_at": "2019-12-08T05:27:46Z", "body_length": 192}, {"created_at": "2019-11-07T20:30:08Z", "body_length": 0}, {"created_at": "2019-11-07T02:04:40Z", "body_length": 11}