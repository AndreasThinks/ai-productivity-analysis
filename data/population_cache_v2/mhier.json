plate: use GNUInstallDirs to determin install destionations\"\n\nThis reverts commit 7eace484c0ffcc9c9041a58190bd9f7a184b1321.\n\nGNUInstallDirs doesn't really deliver the intended directories. CMAKE_INSTALL_LIBDIR e.g. points to lib/x86_64-linux-gnu on Ubuntu 16.04", "created_at": "2018-10-04T15:27:36Z", "repo": "DeployTool", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7eace484c0ffcc9c9041a58190bd9f7a184b1321", "message": "project-template: use GNUInstallDirs to determin install destionations", "created_at": "2018-10-04T13:37:38Z", "repo": "DeployTool", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "173bb9aeaf460580325e183f0c0d5c9f5c3e9bae", "message": "added missing <PROJECT_NAME>ConfigVersion.cmake in create_cmake_config_files macro", "created_at": "2018-10-04T12:36:16Z", "repo": "DeployTool", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "bd24ec38bcf1c815ee8f233ac9ed660b171bff76", "message": "Merged project-template/master", "created_at": "2018-10-01T15:25:46Z", "repo": "DeployTool", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "34a054b550dfd7abb53245d24501d65e5988ba5d", "message": "fixed installation of cmake find_package script / configuration file", "created_at": "2018-10-01T15:15:10Z", "repo": "DeployTool", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d7ea5b7d57b6dcfd3372dea56b50addae8839d20", "message": "Merge remote-tracking branch 'project-template/master'", "created_at": "2018-09-14T14:11:09Z", "repo": "DeployTool", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "db3c5f2175725421b421442461725c871fdd18a0", "message": "Removed HowTo_project-template.md", "created_at": "2018-07-18T14:30:19Z", "repo": "DeployTool", "file_sampled": false, "has_test_file": null, "has_impl_file": null}], "prs": []}