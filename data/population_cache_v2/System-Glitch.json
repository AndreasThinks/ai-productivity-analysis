{"login": "System-Glitch", "location": "FR", "commits": [{"sha": "9a0cf9256df95f8fb9e23d3444a97518e2e13b5f", "message": "Update README.md", "created_at": "2018-05-08T09:21:50Z", "repo": "MaintenanceManager", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "80dd48869cbf6a25d3951c79227e42d5ac583514", "message": "Update README.md", "created_at": "2016-01-23T20:05:25Z", "repo": "MaintenanceManager", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "bbc332f75cbfa7815404cb01d89d5f3763d5aabf", "message": "Update README.md", "created_at": "2016-01-23T20:04:20Z", "repo": "MaintenanceManager", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "dbef40d5dbde238906efbfa6c1c4297cd7cdea5b", "message": "Update RELEASE_MANIFEST.version", "created_at": "2016-01-23T20:04:10Z", "repo": "MaintenanceManager", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "93f852591553799fc0a62183fce62a944561b4a0", "message": "Various changes\n\nThreaded backups. This means that the server will not freeze anymore\nwhile the files are beung copied. Theorically, no map corruptions will\noccur neither\nMultiple lines messages in the config is now supported for all sections.\nUse the \"<n>\" tag to break the line.\nMinor fixes in the config.\nCode improvement in the PlayerJoinEvent handling.", "created_at": "2016-01-23T20:02:53Z", "repo": "MaintenanceManager", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8abd59d6c2f3d992f1aab507579e5d2f2742ade1", "message": "Update README.md", "created_at": "2016-01-21T20:50:46Z", "repo": "MaintenanceManager", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "562f0022235403bc7189f6647dbed1545df677af", "message": "Update RELEASE_MANIFEST.version", "created_at": "2016-01-20T19:23:32Z", "repo": "MaintenanceManager", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "660834920bd19c53e76d52cea09ebbce56a428f3", "message": "Version 2.1\n\nThe plugin now uses my own configuration system. There won't be any\ndifference in its usage.\nAs a consequence, the configuration is now way more lisible and fancy.\nIf you were already using the plugin, you should delete your actual\nconfig, then run the server, or use /maint reload to reset your config\nto the new default one.\nAdded some configuration security: wrong values will be reported in the\nlogs and won't cause errors\nIn some cases, the help message didn't show up when using wrongly the\ncommand. Fixed\nAdded a countdown of 10 seconds before a scheduled maintenance.\nThe seconds countdown message can be changed in the config.", "created_at": "2016-01-20T19:22:00Z", "repo": "MaintenanceManager", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "354fe3a874a74057414c0157e1f72ac119c3b085", "message": "Update README.md", "created_at": "2016-01-20T19:21:16Z", "repo": "MaintenanceManager", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "aa37c2c7740d69e03c4179f9d3d26213324a9e40", "message": "Update README.md", "created_at": "2016-01-19T17:59:21Z", "repo": "MaintenanceManager", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a4c83b723a28333f9f1e73e82f6783f7ed9c3d02", "message": "Update README.md", "created_at": "2016-01-19T17:53:21Z", "repo": "MaintenanceManager", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9279d8cd07f28fef100cc24b4cdd12469970da3b", "message": "Update README.md", "created_at": "2016-01-18T20:45:00Z", "repo": "MaintenanceManager", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8846a679dd32bb8f101f2e8ba4e37bfa93949d6f", "message": "Update README.md", "created_at": "2016-01-18T20:44:30Z", "repo": "MaintenanceManager", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "50919cab4ce33f31a7798639aa6a6fd1f35