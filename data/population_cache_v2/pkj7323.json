": null, "has_impl_file": null}, {"sha": "4ef1bbe1d8c79b855c6eca13f351c4e098c7edfd", "message": "\ud0c0\uc77c \ub9f5 \uc0ad\uc81c \uad6c\ud604", "created_at": "2024-10-30T10:41:00Z", "repo": "2DGP_Project", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0381ca508a15f3bb82fcdf51d9d2447241070453", "message": "\ud0c0\uc77c\ub9f5 flip,\ud68c\uc804 \uc560\ub2c8\uba54\uc774\uc158 \uc801\uc6a9", "created_at": "2024-10-23T13:49:26Z", "repo": "2DGP_Project", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4338f02dd422b2ef88885cd498895038ad01fa82", "message": "\ucee8\ubca0\uc774\uc5b4 \ubca8\ud2b8 \ud53d\uc140 \uac12 \uc870\uc815, \ucee8\ubca0\uc774\uc5b4 \ubca8\ud2b8 \uc560\ub2c8\uba54\uc774\uc158 \uac01 \uac1d\uccb4\ubcc4 \uc560\ub2c8\uba54\uc774\uc158 \ub3d9\uae30\ud654\uac00 \ud544\uc694\ud560 \uc218\ub3c4", "created_at": "2024-10-23T13:03:43Z", "repo": "2DGP_Project", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9de7aa7ca6472e4e56690c74591804e3f8b434b6", "message": "\ucee8\ubca0\uc774\uc5b4 \ubca8\ud2b8 \ub85c\ub4dc, \ud0c0\uc77c\ub9f5 \uc560\ub2c8\uba54\uc774\uc158 \uad6c\ud604, \ud0c0\uc77c\ub9f5 \uc560\ub2c8\uba54\uc774\uc158 \ub108\ubb34 \ube60\ub984 \uc904\uc5ec\uc57c\ub428", "created_at": "2024-10-23T11:59:05Z", "repo": "2DGP_Project", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5812635c0cf814ee52f6ed2275d637acde572199", "message": "\ub9c8\uc6b0\uc2a4 \ubaa8\uc591 \uc124\uc815", "created_at": "2024-10-23T11:11:27Z", "repo": "2DGP_Project", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9ffe53da3573324b7b09d96e6482972e63c3004b", "message": "\uadf8\ub9ac\ub4dc\ub85c \ucc98\uc74c\uc5d0 \ubaa8\ub4e0 \ud0c0\uc77c \ub370\uc774\ud130 \ubc1b\uc544\uc624\uace0 \uc800\uc7a5 \ud560\ub54c\ub3c4 \uadf8\ub9ac\ub4dc\ub85c \uc800\uc7a5\n\uc9d1\ud569 \uc790\ub8cc\ud615\uc774\ub77c \uc911\ubcf5\ud5c8\uc6a9\uc774 \uc548\ub418\uae30 \ub54c\ubb38\uc5d0 \uac01 \ud0c0\uc77c\uc774 \uc911\ubcf5\ud574\uc11c \ub193\uc77c \uc218\uc5c6\uc74c", "created_at": "2024-10-23T04:59:57Z", "repo": "2DGP_Project", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9d98265a0c16a8f32140e255abe2b8ea5d3a53ff", "message": "\uc6d4\ub4dc \uc52c\uc758 \uc624\ube0c\uc81d\ud2b8 \ub9ac\uc2a4\ud2b8\ub97c \ube14\ub7ed\uc2a4\ud14c\uc774\ud2b8\uc5d0 \ub530\ub77c \ub098\ub208 2\ucc28\uc6d0 \ube48\ubc30\uc5f4\uc744 \uc900\ube44\ud574\uc11c BlockState\uac00 \ud070\uac83\uc774 \ub098\uc911\uc5d0 \ub80c\ub354\ub9c1 \ub418\uac8c\ub054 \uc900\ube44\ud568\n\n\uadf8\ub9ac\ub4dc\uc5d0\ub3c4 \uc88c\ud45c\uac12\uc800\uc7a5, \ud0c0\uc77c\uc5d0\ub3c4 \uc88c\ud45c\uac12 \uc800\uc7a5\ub418\uc5b4\uc788\ub294\ub370 \ud55c\ubc88\ub9cc \ub8e8\ud504\ub3cc\uba74 \ub418\ub294 \uadf8\ub9ac\ub4dc\ub85c \uc800\uc7a5\ud558\ub294 \ubc29\ubc95 \uace0\ub824", "created_at": "2024-10-18T13:06:24Z", "repo": "2DGP_Project", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "bcf17d632a2fac9c2980832a4cb8227a9e2a961a", "message": "\ud0c0\uc77c\uc800\uc7a5\uc2dc append\ubaa8\ub4dc\ub85c \ub9cc \uc800\uc7a5\ud558\uace0 \ub098\uc911\uc5d0 \uac8c\uc784 \ub05d\ub0a0\ub54c \uc9d1\ud569\uc744 \uc774\uc6a9\ud574\uc11c \ubaa8\ub4e0 \uc911\ubcf5\ub77c\uc778\uc81c\uac70", "created_at": "2024-10-18T11:55:05Z", "repo": "2DGP_Project", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4a914777f10540845ce14093e86c9f6f319cd442", "message": "\ud0c0\uc77c \ubd88\ub7ec\uc624\uae30 \uc218\uc815\n\n\uc774\uc81c \ub611\uac19\uc740 \uc2a4\ud14c\uc774\ud2b8\uc640 \ub611\uac19\uc740 \uc88c\ud45c\uc778 \ud0c0\uc77c\ub9cc \ube7c\uace0 \ucd94\uac00 \uc800\uc7a5\ud558\ub294 \uac83 \uad6c\ud604\ud574\uc57c\ud568", "created_at": "2024-10-18T11:26:03Z", "repo": "2DGP_Project", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6e1b6c0713d071ee5ce4b28d9025e754c60730ac", "message": "\ube14\ub7ed \uc2a4\ud14c\uc774\ud2b8 \uc800\uc7a5 \ubc0f \ubd88\ub7ec\uc624\uae30 \uc644\ub8cc\n\uce74\uba54\ub77c \uae30\uc900 \uc548\ubcf4\uc774\ub294 \uac1d\uccb4\ub294 \uadf8\ub9ac\uc9c0 \uc54a\ub294 \ucf54\ub4dc \ucd94\uac00", "created_at": "2024-10-18T11:19:35Z", "repo": "2DGP_Project", "file_sampled": false, "has_test_file": null, "has_impl_file": null}], "prs": [{"created_at": "2024-01-18T06:24:57Z", "body_length": 36}]}