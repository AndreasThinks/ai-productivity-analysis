2020-04-29T17:45:36Z", "repo": "vimfiles", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d1b033461fe30dd70ad0f19e33d5af3679b762c9", "message": "Don't assume ~/.vim\n\nNow it's \"the same directory that has this vimrc in it. This is mostly\nfor Windows (which uses ~/vimfiles).", "created_at": "2020-04-28T22:19:39Z", "repo": "vimfiles", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ff1e8a28e4659ed7cfa9864f85cdab057d12c1d2", "message": "`packloadall` happens during startup either way.\n\nBut if you don't do it early, then you can arange stuff for your plugins\nfirst.", "created_at": "2020-04-28T22:18:46Z", "repo": "vimfiles", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "21c58a4fc5f2af14b9cb909b302b14ce80151c2b", "message": "Turns out on both Linux and Windows...\n\n...you can just leave your vimrc in the ~/.vim/ directory. No need to\nhave a sym-linking script.", "created_at": "2020-04-28T22:16:54Z", "repo": "vimfiles", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6d434ffa4a9206487b56b5d0a49ca9161b0e6ea9", "message": "This was removed from Fugitive\n\nAnd maybe the `.git` directory isn't a good place for tags.", "created_at": "2020-01-02T21:24:09Z", "repo": "vimfiles", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e01d9a8aa5516377fbb3795e78a00d863633920e", "message": "Eh. I don't really use MacVim anymore", "created_at": "2020-01-02T21:17:17Z", "repo": "vimfiles", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2f326edda0d1d99d838f61e97ec7d8deac6cba30", "message": "Updated tools\n\n* Removed tabbar\n* Fixed buffergator mapping\n* Added mapping for Flog", "created_at": "2020-01-02T21:16:01Z", "repo": "vimfiles", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "cbf54d64e6c78e9a6c0325c4e076d4e602dc518f", "message": "Updated language packs", "create