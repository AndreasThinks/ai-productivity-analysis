ull}, {"sha": "c877e12e678047ce7db8724e913f072685c99cca", "message": "Regenerate translation line numbers.", "created_at": "2008-10-14T16:16:30Z", "repo": "herrie", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f36baed085b87d7a393a1cd2d1864d5834c61e27", "message": "Document some definitions that don't have Doxygen tags yet.", "created_at": "2008-10-13T13:54:07Z", "repo": "herrie", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "00be6c132963ce5e7100f65dfdaf261273faef6e", "message": "Enable Doxygen preprocessing again.", "created_at": "2008-10-13T13:50:00Z", "repo": "herrie", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "de48b22533c89962a6d08f10b7ad366fa953193d", "message": "Just use the URI of the file as the base URI.\n\nlibSpiff expects the directory name to end with a slash. Otherwise the\nlast component will be ignored. We can exploit this fact by just passing\nthe URI of the file itself.", "created_at": "2008-10-12T19:26:53Z", "repo": "herrie", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b69399857ab7c97081c3341bd19d0097d4aec366", "message": "Prevent Herrie from writing corrupt XSPF playlists to disk.\n\nI got a report from Peter Koeleman that Herrie may generate XSPF\nplaylists that may contain invalid UTF-8. It turns out the contents of\nthe <title/> tag were not properly validated. Just ignore the titles if\nthey are not valid UTF-8.", "created_at": "2008-10-12T14:14:49Z", "repo": "herrie", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "71162ac53595e9918c9caafde9c0e3447c2f41a3", "message": "Update line numbers in translation files.", "created_at": "2008-10-12T08:01:05Z", "repo": "herrie", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "06592cf3cd261cd4fc673f288cda63b88bb8e831", "message": "Make the ChangeLog entry a little more optimistic. ;-)", "created_at": "2008-10-12T07:58:21Z", "repo": "herrie", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f6057e17558aa1b1eed435eedd4e00fca1723d1f", "message": "Add proper relative path support to our XSPF parsing code.", "created_at": "2008-10-12T07:45:17Z", "repo": "herrie", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "741e2fcde15e001688588fd2b1d3b68003519893", "message": "I'll just store the Doxygen docs on herrie.info itself.\n\nThe reason why I used Doxygen at Dispuut Interlink, was because Doxygen\nused to (indirectly) depend on X11. It doesn't seem to be like that\nanymore, so I'll just put Doxygen in a cronjob on the webserver.", "created_at": "2008-10-10T12:50:18Z", "repo": "herrie", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "fb7ae50bacfa3263f6a4dd484903b943ab547d85", "message": "Comment out the URL to the Doxygen page.\n\nIt needs a new home.", "created_at": "2008-10-10T12:34:34Z", "repo": "herrie", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e9d25ef2c79e83003d24257bcd78fe0aa7ab91eb", "message": "Make Herrie compile with libSpiff 1.0.0.\n\nPointed out by:\tRobert Buchholz <rbu gentoo org>", "created_at": "2008-10-09T16:53:14Z", "repo": "herrie", "file_sampled": false, "has_test_file": null, "has_impl_file": null}], "prs": []}