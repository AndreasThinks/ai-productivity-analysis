has_impl_file": null}, {"sha": "9aafc818fbf60232b5e6a3da90aebfd0dc879865", "message": "Added information how to achieve long delay times", "created_at": "2018-03-31T07:09:24Z", "repo": "TeensyDelay", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "04805309a3639bb2339d6822cb60c7d4974eac0c", "message": "updated version", "created_at": "2018-03-30T10:03:15Z", "repo": "TeensyDelay", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "70ad7259bc65e4f230853a44c79801c9a3e8b481", "message": "Merge pull request #6 from luni64/bugfix\n\nBugfix", "created_at": "2018-03-30T09:58:16Z", "repo": "TeensyDelay", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6591871c02e7748b97534556f968ba263fa9a5f1", "message": "Update readme.md\n\nAdded note to the maximum delay time", "created_at": "2018-03-30T09:56:13Z", "repo": "TeensyDelay", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0921c5f410c751a709687eb827ddf1a4b7d329f7", "message": "limit microsToReload to >= 1\n\nmicrosToReload was returning 0 for very small input values which would result in the maximum delay insteat of the expected minimum.", "created_at": "2017-12-16T17:18:13Z", "repo": "TeensyDelay", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a77964ccafac4ae7c6d15627e00bbfe9fdf00fe7", "message": "Override auto prescale\n\nThe automatically calculated prescale value can be overriden in config.h to accomodate longer delay periods", "created_at": "2017-12-16T15:43:06Z", "repo": "TeensyDelay", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "cb27536fbbe9c7a2c85a9925412476653a592e53", "message": "Simplified ISR", "created_at": "2017-12-16T15:34:20Z", "repo": "TeensyDelay", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "55b3acb07f765d079bfc8ed472322ab99ab665ea", "message": "Bug with large delays\n\nFor Teensy 3.2 the STATUS register does not work in any case. (There is the following note in the datasheet:\nThe STATUS register should be used only in Combine mode)\n\nRewrote the code to use the CHF flags from the CHnSC registers.", "created_at": "2017-12-16T15:24:56Z", "repo": "TeensyDelay", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5a04e733963e92539e06f88d5a0b307ff15906eb", "message": "Merge pull request #3 from luni64/bugfix\n\nBug if channel nr > 4", "created_at": "2017-11-26T10:34:53Z", "repo": "TeensyDelay", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ea049bf2b346c0c823987f6ec1eacd2fa3845f98", "message": "Bug if channel nr > 4\n\nFixed wrong masking of the status register", "created_at": "2017-11-26T08:56:29Z", "repo": "TeensyDelay", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "fac5dcb2fabfdcef317e8d81583aecbb3a93ffbb", "message": "bugfix\n\nIn some cases a overflow of one channel  triggere the callback of\nanother (not triggered) channel.", "created_at": "2017-05-24T18:09:25Z", "repo": "TeensyDelay", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c4771c0c41334a645997fded927ed0ef30535fa3", "message": "Update readme.md", "created_at": "2017-04-26T10:08:53Z", "repo": "TeensyDelay", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "96d798f53c0f4ef5f72756a23f2a17efb8142009", "message": "Update readme.md", "created_at": "2017-04-26T10:07:03Z", "repo": "TeensyDelay", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d1d2bd7dbb8938180ef8b914ff122bc48c7b1bea", "message": "GCC 5.4 compatibility\n\nGCC 5.4 follows standard more strictly than GCC 4.8. reinterpret casts in constexpressions are not allowed anymore __builtin_constant_p somehow overrides this (see http://stackoverflow.com/questions/10369606/constexpr-pointer-value)\r\nThanks to Per Magnusson for the fix", "created_at": "2017-04-23T16:11:55Z", "repo": "TeensyDelay", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c7cb993fc41465c30477dea482ff680564851ad9", "message": "GCC 5.4 compatibility\n\nGCC 5.4 follows standard more strictly than GCC 4.8. reinterpret casts in constexpressions are not allowed anymore __builtin_constant_p somehow overrides this (see http://stackoverflow.com/questions/10369606/constexpr-pointer-value)\r\nThanks to Per Magnusson for the fix", "created_at": "2017-04-23T16:03:24Z", "repo": "TeensyDelay", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3d07e068bbb1ea1c53c2849fdfd6de7911089da5", "message": "Update readme.md", "created_at": "2017-04-22T18:01:58Z", "repo": "TeensyDelay", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "40885c884b5c942576de44844e830885cab473f4", "message": "Update readme.md", "created_at": "2017-04-22T18:01:04Z", "repo": "TeensyDelay", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7065833a2d5a813957346c79cf0cddb0e73cf8d8", "message": "Added documentation for periodic timer", "created_at": "2017-04-22T17:57:25Z", "repo": "TeensyDelay", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f9d8d22a2268fda12d66d9ed3cb2949dde5327e6", "message": "Update readme.md", "created_at": "2017-04-22T17:44:33Z", "repo": "TeensyDelay", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2c0032db796f43843ebfe1425952a4ff3cfd73a1", "message": "Update .gitignore", "created_at": "2017-04-01T12:39:28Z", "repo": "TeensyDelay", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6a9475647450feadec4ef5f8bbd23f4a19221284", "message": "Update .gitattributes", "created_at": "2017-04-01T12:39:15Z", "repo": "TeensyDelay", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0a6a9d1070ed27a970bedcab7a3b6d1d77dcbda3", "message": "Update TeensyDelay.cpp", "cr