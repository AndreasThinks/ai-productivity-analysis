, "has_test_file": null, "has_impl_file": null}, {"sha": "2f0a50fe31129a604a39ea013c4006ebd184ee66", "message": "Registration fixes", "created_at": "2018-07-03T14:19:10Z", "repo": "anon-chat", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8e909b4aace08ec816df081ada673c5959132260", "message": "SendMessage and getchatlenght uid fix\n\nSendMessage and getChatLenght now fetch uid from $_SESSION instead of $_GET", "created_at": "2018-07-03T13:28:17Z", "repo": "anon-chat", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c3827461c14304e38115b46c8bdd9bb2bc1b6f4e", "message": "Fixes\n\nAvoid variables with short names like $a. Configured minimum length is 3.\n13\nusort($chat, function($a, $b) {\n\nAvoid variables with short names like $ad. Configured minimum length is 3.\n14\n$ad = new DateTime($a['datetime']['date']);\n\nAvoid variables with short names like $bd. Configured minimum length is 3.\n15\n$bd = new DateTime($b['datetime']['date']);", "created_at": "2018-07-03T13:14:40Z", "repo": "anon-chat", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "46920869d1b976c017aca51488c03b592737466b", "message": "Fixes\n\nAvoid variables with short names like $a. Configured minimum length is 3.\n8\nusort($chat, function ($a, $b) {\n\nAvoid variables with short names like $ad. Configured minimum length is 3.\n10\n$ad = new DateTime($a['datetime']['date']);\n\nAvoid variables with short names like $bd. Configured minimum length is 3.\n11\n$bd = new DateTime($b['datetime']['date']);\n\nExpected next thing to be an escaping function (see Codex for 'Data Validation'), not 'sizeof'\n31\necho sizeof($messages);", "created_at": "2018-07-03T13:13:35Z", "repo": "anon-chat", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8f0d3254539631738b79797bee8ab5497f9a5c4a", "message": "Fixes\n\nExpected next thing to be an escaping function (see Codex for 'Data Validation'), not '$_GET'\n6\n<h4 class=\"my-4 text-center\">Chat with <span id=\"name\"><?php echo $_GET[\"name\"] ?></span></h4>\n\nAvoid variables with short names like $a. Configured minimum length is 3.\n14\nusort($chat, function ($a, $b) {\n\nAvoid variables with short names like $ad. Configured minimum length is 3.\n16\n$ad = new DateTime($a['datetime']['date']);\n\nAvoid variables with short names like $bd. Configured minimum length is 3.\n17\n$bd = new DateTime($b['datetime']['date']);\n\nExpected next thing to be an escaping function (see Codex for 'Data Validation'), not '$message'\n42\n<p <?php echo ($message[\"isSender\"] == true ? \"class='text-right message'\" : \"class='message'\") ?>><?php echo $message[\"content\"] ?> </p>\n\nExpected next thing to be an escaping function (see Codex for 'Data Validation'), not '$user'\n63\nuid: \"<?php echo $user[\"uid\"] ?>\",\n\nExpected next thing to be an escaping function (see Codex for 'Data Validation'), not '$_GET'\n64\nchatid: \"<?php echo $_GET[\"chatid\"] ?>\",\n\nExpected next thing to be an escaping function (see Codex for 'Data Validation'), not '$_GET'\n96\nchatid: \"<?php echo $_GET[\"chatid\"] ?>\"", "created_at": "2018-07-03T13:11:45Z", "repo": "anon-chat", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6c2cc67cde1dffbcd2b4a4be9a7e5d959d2ef3ce", "message": "Fixed chat reload when not needed\n\ngetChatLenght call was still on pending even after have changed chat, this means the chat would get reloaded if chat 1 and chat 2 had different number of messages. Now it stops the timer and swaps to the other chat", "created_at": "2018-07-03T13:05:59Z", "repo": "anon-chat", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7fd1c5a2bdf476cf9d1a1c93a4c155078e22ffd7", "message": "LOTS AND LOTS OF THINGS\n\nI swear i'm a good programmer and i know how to use git", "created_at": "2018-07-01T15:45:12Z", "repo": "anon-chat", "file_sampled": false, "has_test_file": null, "h