t", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3db6f6a0e03c8e9f3ba12c42c6e6540833f9092e", "message": "Creating an example 2 file", "created_at": "2022-02-14T21:46:16Z", "repo": "coursera_git", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f8b89768c71179b4291c582ceaeb39f5e65ba41f", "message": "Adding a new file example", "created_at": "2022-02-14T21:44:38Z", "repo": "coursera_git", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2c2ac94b0214c5d5c07cd269f3f8f96da3de87f9", "message": "I am editing the README file.", "created_at": "2022-02-14T21:30:03Z", "repo": "coursera_git", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "fecf7202116c64365cc4da68354c6e79afc08c29", "message": "Initial commit", "created_at": "2022-02-14T21:23:46Z", "repo": "coursera_git", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "98dba33d011ed8c0e6242588ff30851d7ca23468", "message": "Enhanced conditionals and fixed bugs. Game is fully working", "created_at": "2022-04-11T02:55:32Z", "repo": "black_jack", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "df0225dc1e22aed57a1de6be9740ebeac367ccf4", "message": "added functionality cash out and fixed some bugs", "created_at": "2022-04-10T04:49:22Z", "repo": "black_jack", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9cb2e2dc77d1ea72fc3668cf0eabddb3954058ac", "message": "Fixing main body code according to the flow diagram", "created_at": "2022-04-08T03:02:29Z", "repo": "black_jack", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "37fb6a87248348340625a513492e9278bcba2483", "message": "Working on conditionals", "created_at": "2022-04-07T03:27:20Z", "repo": "black_jack", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "89160e5a5d4406c66562a5a22f0facc63cc7e565", "message": "Added method to ask player for 1/11 for ace card\n\nAdded method Classes.Classes.Deck.ask_ace_value(). This method\nallows receiving player or dealer as input object. If player,\nasks for the value. If dealer, randomly chooses the value.\n\nMinor changes in Classes/functions.py and in main.py", "created_at": "2022-04-04T04:38:45Z", "repo": "black_jack", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "04b871511c1870ab06cb3a5eae2a0af7d701a10d", "message": "Cnditionals to check bust in first two dealt cards\n\nAs player cannot bust in the first two dealt cards in a round,\ncreated conditionals in main.py to, in case this happens, return\nthe money and cards to player and  deal two cards again.\n\nAlso created function Classes.functions.deal_two_cards() to\ndeal two cards to either player OR dealer at the beginning of a game\n\nAlso 'split' function functions.check_bust_or_21_player() into\nfunctions.check_21_player() and functions.check_bust_player() to\nconveniently handle results, because even though they cause a break\nin the loop, they have slightly different outcomes. Did the same for\nfunctions.dealer()\n\nMinor changes to Classes/Classes.py", "created_at": "2022-04-03T19:11:02Z", "repo": "black_jack", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c22755e4abce5f5b70fe7d616ed086331d47cc8d", "message": "Fixed error on cards on table printing twice when starting game", "created_at": "2022-04-02T20:39:39Z", "repo": "black_jack", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f70581d668d694b699a86950c4f889c59f6ce4bc", "message": "minor changes", "created_at": "2022-04-01T04:03:14Z", "repo": "black_jack", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "307700d5423679881692297c20833a7acf5c6ad7", "message": "Merge branch 'master' of https://github.com/esgiraldop/black_jack", "created_at": "2022-03-31T03:16:43Z", "repo": "black_jack", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "02ff4e94b741834d06f03b20a140a6941df9a1e8", "message": "minor changes\"", "created_at": "2022-03-31T03:10:33Z", "repo": "black_jack", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a2b36b51611a328c1b66a0c6a580f22f1a7bdf6d", "message": "Create README.md", "created_at": "2022-03-31T02:32:47Z", "repo": "black_jack", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "148d5cbeb87639a927f1a666b1fd0be58c366c50", "message": "First commit. Old scripts added", "created_at": "2022-03-31T02:26:15Z", "repo": "black_jack", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "142f95f5ed2ade83578c09ee030657590a1df470", "message": "Added functionality for rejected inf and nan", "created_at": "2022-05-18T02:37:40Z", "repo": "binary_to_decimal_and_back_converter", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3f81f0fdd5e7998d62ed11af4cbfde1e84908d3d", "message": "Create README.md", "created_at": "2022-05-18T02:24:01Z", "repo": "binary_to_decimal_and_back_converter", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9b5b291caa490ea22dee49e0dac7e020cbde5fed", "message": "Enhaced code documentation", "created_at": "2022-05-17T05:01:09Z", "repo": "binary_to_decimal_and_back_converter", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5905976d15c31ae9755710cec1ddb52522dfb057", "message": "Enhanced partitioner to recognize negative numbers", "created_at": "2022-05-17T04:52:56Z", "repo": "binary_to_decimal_and_back_converter", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "14e55b989b168d30e17ebd89c6932fa78a85954f", "message": "Finished functions for transforming to decimal\n\nAdded functions binary_2_integer() and binary_2_float() in\nto_decimal.py. Also implemented these two functions in main.py\n\nIn to_binary.integer_2_binary(), added a functionality to\nsupport numbers with an integer part equal to zero. 0.246 is\nan example.\n\nMinor changes made to partitioner.py", "created_at": "2022-05-17T04:22:03Z", "repo": "binary_to_decimal_and_back_converter", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1e50554d9beca54badaef00df77f09b55f469e21", "message": "Enhanced function partitioner.float_partitioner()\n\nEnhanced function in order to split a float or an integer number\nindependently how the user enters it and without loosing precision\n\nAlso made some minor changes in ask_input.py and in main.py", "created_at": "2022-05-16T03:36:04Z", "repo": "binary_to_decimal_and_back_converter", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f8d3e7d56a09baaa2ab422f6bab2b755ad60c841", "message": "Finished functions for asking number from user", "created_at": "2022-05-16T02:36:33Z", "repo": "binary_to_decimal_and_back_converter", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e959edaa86d2ea5db646120e4fe3fd84a79db8b8", "message": "Added requirements file", "created_at": "2022-05-16T01:52:20Z", "repo": "binary_to_decimal_and_back_converter", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b1995555f47e8f60a9f695e4c1abbe9bd98b4238", "message": "First commit", "created_at": "2022-05-16T00:04:52Z", "repo": "binary_to_decimal_and_back_converter", "file_sampled": false, "has_test_file": null, "has_impl_file": null}], "prs": [{"created_at": "2020-04-19T05:57:25Z", "body_length": 0}, {"created_at": "2020-03-13T22:52:17Z", "body_length": 0}]}