{"login": "adolfopa", "location": "ES", "commits": [{"sha": "edacb7fad48544e59a402c9d8bb0525fc5ee206b", "message": "Remove travis-ci configuration\n\nIt hasn't been free for open source projects since a long time ago.", "created_at": "2025-12-22T10:30:23Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b04cdf345b5787b975341f8e7cac4c9287676660", "message": "Rewrite README file", "created_at": "2025-12-22T10:30:23Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "56795aa44280dd88813e212e85bb48690e2859b6", "message": "Add manpage", "created_at": "2025-12-18T21:10:00Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7512049122dd1192374c57e372d30f11654af477", "message": "Cleanup makefile", "created_at": "2025-12-06T13:46:17Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "311a76a894bb5838133543cb5bbeb9cfb0255947", "message": "Add custom implementation of dirname(3)\n\nOn FreeBSD, dirname modifies the input buffer, while on GNU libc it\nreturns a reference to an internal buffer.  These differences made it\nnecessary to do multiple copies/allocs.\n\nAdd a custom implementation so that only a single allocation is\nneeded.", "created_at": "2025-12-04T18:38:38Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "94cd9fac40c6de7b9d1c29a5cc6367f8caecc6a2", "message": "Reimplement relative path computation\n\nDon't use strtok to avoid unnecessary allocations and simplify the\ncode.\n\nInclude a test to cover the case where the package and target\ndirectories don't share any common parent (this was a special case in\nthe original implementation) and setup the path correctly in the\nMakefile so that we test the built version, not the one currently\ninstalled.", "created_at": "2025-12-03T20:24:38Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d4e95b34652a7d2498be5ab99fe2ef3070efaa56", "message": "Don't suppress test echoing", "created_at": "2025-12-02T15:48:32Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "30bb6eb847c61fa29aed5fd17b833223d51df4e2", "message": "Cleanup test leftovers", "created_at": "2025-11-30T19:28:16Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d0e86ecb488c52f60256f19a5ea23cf8adaa9c8a", "message": "Remove system dependant test\n\nThe error message varies between Linux and BSD; the test it not that\nuseful, so remove it and its support scripts.", "created_at": "2025-11-30T19:19:06Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3b28d56aa0c13f13ed514f84feee71d3523b6348", "message": "Merge source files and move everything to top level\n\nIn the process, simplify the Makefile and travis configuration.  Test\ncoverage wasn't working properly, so remove it until I figure out why.", "created_at": "2025-11-30T19:16:56Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e808be69f3f73555ba8e9b0bff59499e1a1a9305", "message": "Use a prefix instead of a direct installation dir\n\nUse the common convention of defining a prefix; also, let callers override it.", "created_at": "2025-11-28T22:14:05Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ea4665c93fc7720b76cf1a97d2eeb1db9f380f02", "message": "Remove dependency on tush", "created_at": "2025-11-28T22:14:05Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "766a9eb7abafc22efd7921f852c3d953eeaab809", "message": "Make everything fit in 80 columns", "created_at": "2025-11-28T21:58:38Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "756b5bc004654ef685da01ffe3ac480c5743666f", "message": "Move closer to first usage", "created_at": "2025-11-23T16:42:05Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "796d30797cdbe493838d405e099f8322acec3aa4", "message": "Inline options_init/free functions", "created_at": "2025-11-23T16:35:07Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f7ddf51efd62f425c3539c22a0ab73584ac7f37c", "message": "Inline absolute path functions", "created_at": "2023-05-05T13:38:35Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ece7cda0d21afb3fc491b74226174e5b5576fb97", "message": "Use PATH_MAX instead of POSIX_PATH_MAX\n\nWe're using functions (e.g. `realpath') that work with PATH_MAX\nanyway.", "created_at": "2023-05-05T13:30:46Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4729419e409017628b86cbf91d9a8ff0316f2f17", "message": "Avoid passing `options' around and remove macros", "created_at": "2023-05-05T13:20:27Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ca46307813888c4ae5452558e40a021af6eb571f", "message": "Inline skip_leading", "created_at": "2023-05-05T13:18:09Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "0ae6cb2f6a0ae53bb2233b86a0c3f51270fe798c", "message": "Remove xstrdup and xmalloc", "created_at": "2023-05-05T13:18:07Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7cd2ed50c1bf1f2b31a7ccde4c8b27246e01bf67", "message": "Reindent code", "created_at": "2023-05-05T12:34:58Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d03099abd90199726d7be67ea78ed5fc2ad2d243", "message": "Use readdir instead of readdir_r\n\nMorphOS doesn't include an implementation of the readdir_r function.  Also, both\nGNU and FreeBSD recommend against its use, and readdir not guaranteeing\nreentrancy is not a problem for us.", "created_at": "2019-04-09T19:58:07Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9b9f1228e760856df2ef804927000602bb43cd8b", "message": "gcov fails with clang on Travis, hack to skip over coverage report", "created_at": "2019-04-08T20:20:20Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "082933ace321607fdc313743801dbee3265ed0de", "message": "Add coveralls.io badge to README file", "created_at": "2019-04-08T20:01:55Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d55059d333b6e21c7823ee6f5cda1427919d18bf", "message": "Send coverage information to coveralls.io", "created_at": "2019-04-08T20:01:55Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "44573a04ae8e96760fd71bb077b6794a82eab289", "message": "Create install directory if it doesn't exist", "created_at": "2017-03-13T21:31:53Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8b588864758786580e1febe2ec011ff788fd50ea", "message": "Remove tabs", "created_at": "2017-03-08T23:36:22Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "05f3e7a337de7d938fc76fad9339c536eb0941e8", "message": "Hack to fix platform dependent outputs in tests", "created_at": "2017-03-08T23:18:38Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2025d5cc13facec703f8233099ca4c5405eb3684", "message": "Make tests pass in the CI\n\nThe error message is slightly different between Linux and OS\nX/FreeBSD. Make it pass on Linux so that the travis build succeeds\nuntil I find a way to fix this.", "created_at": "2017-03-08T22:41:52Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "c3f67065ef2fe30585668743e0a0101e7b89aeee", "message": "Fix error message and add a couple more tests", "created_at": "2017-03-08T22:27:30Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "5f9c1bc404779a64988a67a5a01295713b2fbd18", "message": "Add test and improve conflict message for regular files", "created_at": "2017-03-08T21:24:36Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "55130b7ed709a74261a6fd59fc4576b400b60270", "message": "Improve message when a conflicting link is found", "created_at": "2017-03-08T21:20:01Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ae58eba89272ecaa878c5c0fcf2df8112edd0137", "message": "Remove extra newline in conflict warnings", "created_at": "2017-03-08T20:53:09Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8fb6f2288b0d70a3cdf686b80c280b41529e80a9", "message": "Add test for the `-c` flag", "created_at": "2017-03-06T16:04:40Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "87f6c585a4a65b14f7595b13b2e4bc4c7f450e85", "message": "Consistent indentation", "created_at": "2017-03-06T15:53:39Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "71e5907e060b247857ca01e6f998f3390e4cebfc", "message": "Add codecov badge", "created_at": "2017-03-04T17:09:28Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7ab23bb5cbb650978c32b7318107c58b9fae87ac", "message": "Send coverage info to CodeCov", "created_at": "2017-03-04T17:01:50Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2ca5f6d3cb76c2a60e76136f67771886126f507d", "message": "Update README", "created_at": "2017-03-04T15:58:15Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4a6c7427840864a34bbb7a4eca60a57be190d5f4", "message": "Update tests", "created_at": "2017-03-04T15:50:45Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ed1a9ac6a6e2fc87f284d94111544fa9ffff9216", "message": "Move all configuration to the top level Makefile", "created_at": "2017-03-04T15:29:36Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "fa302371851bd5c7a2d65d01f0b53b7e6c937b23", "message": "Remove unused flags", "created_at": "2017-03-04T15:25:51Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "256e9b5da21a3964e024bf5d273980061e05038b", "message": "Fix indentation", "created_at": "2017-03-04T15:24:21Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "fcf42a4912395afdef7303c831abdc823638b057", "message": "Check the return status before usage", "created_at": "2017-03-04T15:24:07Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d7c19615fee0b74c3557f571600a14db59b068ea", "message": "Use correct type for mode bits", "created_at": "2017-03-04T15:23:42Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "098d9e8c1a875e89e845839d0d4c91f8cdc03137", "message": "No longer necessary", "created_at": "2017-03-04T15:23:16Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "25b81a5f893f5dff51dbfc6046544bb2103dc9d7", "message": "Avoid using reserved namespace\n\nNames starting with `__` or `_` followed by an uppercase letter are\nreserved by the standard.", "created_at": "2017-03-04T15:22:14Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "68266ccade352a2eeaea9c4a25fc0c097bfe0676", "message": "Use latest tush version", "created_at": "2017-03-04T15:21:34Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d2a89f5b0ea1d2ce3c9d33b6e4ce67715b1a69cd", "message": "Fix command order", "created_at": "2015-05-26T15:01:08Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "10885eb3444c618d1a08eb2f3624c1c9a14d3d7c", "message": "Remove target directory", "created_at": "2015-05-26T15:01:01Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "62fba9994f255cdc5fdcdd9587d33b2ed4b5f89e", "message": "Update tush submodule to point to latest master", "created_at": "2015-02-28T02:24:39Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4fa63da9354ddb4c7836b76ff5b43662c0b2247b", "message": "Remove ATF files\n\nAll ATF tests have been converted into Tush tests.", "created_at": "2015-02-28T02:21:38Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "abe537adaa0838c44a0e96a94d306f6341c1835d", "message": "Use `packages` instead of `tmp` as package dir", "created_at": "2015-02-28T02:20:39Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "790debefe64bf27855a4edb73b52bee6a48f8902", "message": "Add tests for the `-n` flag", "created_at": "2015-02-28T02:19:24Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "3ca1e79805dc2278100505f180e5b3ec069d68ea", "message": "Add test for `-R` flag", "created_at": "2015-02-28T02:11:09Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "499c4e2c4b9aed64cc529373730a53d618797155", "message": "Reorder test", "created_at": "2015-02-28T02:07:42Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ba111022ca9a4c2fdff11c32b525911288d01a00", "message": "Add tests for the `-d` and `-t` flags", "created_at": "2015-02-28T02:07:06Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "9e60262b5fd7b26a2196d785dcdfb6ba5a632580", "message": "Improve stowing/unstowing tests\n\n  - Create a common package structure to use in all tests.\n\n  - After stowing, check that the directories and links have been\n    created.\n\n  - Check that directories and links have been removed after unstowing.", "created_at": "2015-02-28T01:59:43Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "904e50142ee8407840afd4eb702aaf1fdef916dd", "message": "Update README file and other minor fixes", "created_at": "2015-02-21T23:38:28Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "14e31bee6c03d607f02bdedcb63293ddaa5b8762", "message": "Add tests for unstowing and clean up\n\n  - Add tests for unstowing packages and verbose mode.\n\n  - Clean up other tests, removing redundancy.", "created_at": "2015-02-21T23:21:35Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "da0b30f5ee54eeea76b42df6903d4d04b8973d3b", "message": "Fix some minor typos in the tests", "created_at": "2015-02-21T17:11:23Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "7076e27ae45ba9d393a7b2970b36b22659178dd9", "message": "Manually prepare Git submodule\n\nOtherwise, Travis will fail because it doesn't have my users public\nkey. By changing repository scheme to `https` on the fly it should be\nable to fetch the submodule.", "created_at": "2015-02-21T16:10:00Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "2017e5321d05f555233c372743e68ddd064202ef", "message": "Run tests on Travis slave", "created_at": "2015-02-21T16:06:28Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "523b49c06d6884b7ffe1d13bd8fc13a764b3adaa", "message": "Add tests for package stowing", "created_at": "2015-02-21T16:05:28Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a5b880dac571074eeb7db7e3f6cd1e859a5c15a9", "message": "Add test for `-h' flag", "created_at": "2015-02-21T15:59:01Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b043dbe8b4b117ab3d648a24018243289b380048", "message": "Add test for no arg execution", "created_at": "2015-02-21T15:59:01Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ac55f382b6609c1b7b5840bfdd3944a1a739ae42", "message": "Add skeleton tush test file", "created_at": "2015-02-21T15:59:01Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e20369722aa4377928d454d656ed3608c48cf552", "message": "Remove relative path tests\n\nWe won't be using ATF anymore, so no point in keeping this around. In\nfuture commits I'll write tush tests to cover this.", "created_at": "2015-02-21T15:59:00Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "84ef2df22e9831fc12430a5624305b46e21f0a60", "message": "Add submodule for `tush'", "created_at": "2015-02-21T15:58:53Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b3f2cc888b8520eac91e795f96cda0f0a8029811", "message": "Add license badge", "created_at": "2015-02-01T21:56:45Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "f0fa1dba6701f3dc208368d139ebde7ff1a31c33", "message": "Convert README to Markdonw and add travis-ci badge", "created_at": "2015-01-22T23:37:45Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8f64f6dbf89d661332e26302405e56e5a81d7e73", "message": "Add travis configuration file", "created_at": "2015-01-22T23:15:35Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e280c9da6818668089a846ea0f7f06b3231a25cf", "message": "Added some usage and installation documentation.\n  * The -h flag now offers a little more information.\n  * Added installation instructions and some (anemic) usage notes.", "created_at": "2011-08-14T17:11:39Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "31a2275cff264496ec4e8b38aeea66b938db9e16", "message": "Removed executable flag", "created_at": "2011-08-14T17:11:01Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8a403be7c5c0b731fa71553b27e445dc35ed28c8", "message": "Removed \"usage before initialization\" warning.", "created_at": "2011-08-14T17:09:54Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "1bd6f35ed652a14ba11197bd3d943a1f3bbbca89", "message": "Use of relative paths instead of absolute ones when symlinking.\n\n- cstow will now use relative paths when creating symbolic links for\n  files.  This is nice when you need to relocate the filesystem or\n  similar scenarios (e.g. backups).\n- Moved (almost) all path manipulation code to the path.c file.\n- Moved xwrappers to util.c\n- Added test case for relative path handling code.", "created_at": "2011-06-25T13:14:26Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "4cbf239d31e40fbfcb8f100fe4e7e565a942e446", "message": "Fixed problem with glibc's realpath(3)\n\nGlibc's realpath(3) fails when the argument file isn't a real file,\nwhile FreeBSD's one is happy with non existant ones.  This made cstow\nfail prematurelly on Linux when multiple -t or -d options were given\nand some of the overriden ones didn't exist.", "created_at": "2011-06-13T15:42:27Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b0d721438f5851796ea049e7af6b55fa7de73c68", "message": "Simplified `create_link'.\n\nThis function was doing a lot of unneeded work, assuring that the\nsource and target paths were ok (as understood by realpath(3)).", "created_at": "2011-06-12T10:58:13Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "e6a73d08c7c62019034a4f32c2d6fb84cbea668d", "message": "Fixed stup\u00ecd error in `directory_name'", "created_at": "2011-06-01T16:26:19Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8b2842a023bcf4c4ea152f3a5cce01af1cbb2746", "message": "Fixed problem with aliased pointers mofified by dirname(3)\n\nFreeBSD's implementation of dirname(3) doesn't modify the contents of\nthe input string, but glibc's one does under some circumstances.  The\ninput string is now copied before passing it into dirname().", "created_at": "2011-06-01T16:15:20Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "41749d14871018161c9e588f3087f963bd301353", "message": "Added a couple more tests for the -t and -d flags", "created_at": "2011-05-26T18:03:05Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "696c9ccf4345ee69a0be3c530a701bdc9a3fd981", "message": "Removed references to -d and -t options in the README", "created_at": "2011-05-24T18:28:25Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8eda7f6de51f172182969ffb95ab0f99b55a398a", "message": "Move install commands to inner Makefile", "created_at": "2011-05-24T18:26:17Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a812da6a27aba7a0e59df4ccff2b19dbffb8220b", "message": "Implemented -t and -d options", "created_at": "2011-05-24T18:24:31Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ebc82ba843e4cc26f1963df243e767f2832720f1", "message": "Forgot to update the synapsis after adding the -R flag.", "created_at": "2011-05-24T16:17:40Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "03d32108f1583a6b22628aaecf26c977c47013b4", "message": "Implemented the -R flag", "created_at": "2011-05-24T16:13:05Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "a0b048ae93d3f88c9fcf83171e93e1615d48884e", "message": "-n flag was completely broken.", "created_at": "2011-05-23T18:25:40Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "aa23cbdb87fbefa93ced9356f1cd469bb066e1d6", "message": "Added test cases for -v and -n flags.", "created_at": "2011-05-23T18:24:46Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "01b7ac84b832e40ea0ecb2fe5e56d4904591c750", "message": "* Fixed an error in the test case that made it useless.\n* Now the makefile creates the destination directory if necessary.\n* Added the README file.", "created_at": "2011-05-22T15:15:34Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "6317df1ce496ef16bfed02dc22a27171b54adedf", "message": "Initial revision.", "created_at": "2011-05-20T13:17:03Z", "repo": "cstow", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "09409ebdb70a9c1783529abdd2561d2c61ad2787", "message": "Added license terms.", "created_at": "2012-06-08T17:14:51Z", "repo": "shtest", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ab547c04f03c74ab3d3e6b9f010d94d3b1465b53", "message": "Initial commit", "created_at": "2012-03-19T14:27:09Z", "repo": "shtest", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "40b01bd7feada4098f490c15e68027e211bd0743", "message": "Added documentation about literal objects; expanded a litle bit the example.", "created_at": "2013-01-25T16:55:55Z", "repo": "racket-json-mapping", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "ab8e6e50f29be39faf698d3b676cc2325bfc365f", "message": "Added support for literal hashes.\n\nWhen a mapping declares an `object' with no constructor, it\nwill be treated not as a struct, but as a literal hash.", "created_at": "2013-01-25T16:40:39Z", "repo": "racket-json-mapping", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "84faaab2a1aa1261a816db828ecf262eaf594f78", "message": "Clarified some points in the documentation.", "created_at": "2013-01-24T22:49:38Z", "repo": "racket-json-mapping", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "04f4c9b46e6f6fab03aba82132736b24ef8a5a59", "message": "Support for booleans, numbers, strings, lists, literals and structs.", "created_at": "2013-01-24T22:42:24Z", "repo": "racket-json-mapping", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "8313acd8de8ccc76e7366476cecb39c112eba609", "message": "Initial commit", "created_at": "2013-01-24T22:40:15Z", "repo": "racket-json-mapping", "file_sampled": false, "has_test_file": null, "has_impl_file": null}], "prs": [{"created_at": "2016-11-16T19:41:21Z", "body_length": 0}, {"created_at": "2016-11-15T14:45:43Z", "body_length": 0}]}