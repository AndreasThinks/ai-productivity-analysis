 main.py helps to minimize the risk of mistake you have to do a lot job though if there are changes", "created_at": "2023-12-03T21:52:27Z", "repo": "parsing_books", "file_sampled": true, "has_test_file": false, "has_impl_file": true}, {"sha": "b9b700e93053dce45ee888de720f1c59e0d881d1", "message": "changed the design of the main function; moved parsing process to a standalone function which made possible parsing of an arbitrary number of books; added additional check for the presence of the book in the database; database still lacks dynamic design, work on that", "created_at": "2023-12-03T13:47:20Z", "repo": "parsing_books", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b76c7afcc84293032341d9da99089a9af797b6d0", "message": "most of the helper functions moved to helpers.py module; cleaned the code a bit", "created_at": "2023-11-30T19:20:07Z", "repo": "parsing_books", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "043e0cbe62fc22aaf859c474ad28e8116a63a941", "message": "modified from one table to many-to-many db; going to optimize code and db soon", "created_at": "2023-11-29T22:09:02Z", "repo": "parsing_books", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "d88315f56066e8d528f9263914cf418ce3f9888d", "message": "Merge branch 'main' of github.com:lefthand67/parsing_books\nI need to merge remote license and local files", "created_at": "2023-11-26T21:44:27Z", "repo": "parsing_books", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "b059e9b1613fe4e598ce21f3dfac1868d82e7357", "message": "first commit", "created_at": "2023-11-26T21:19:48Z", "repo": "parsing_books", "file_sampled": true, "has_test_file": false, "has_impl_file": true}, {"sha": "740353abdfdaa0b253ef6126fbeb2073158fbf24", "message": "Initial commit", "created_at": "2023-11-26T21:18:50Z", "repo": "parsing_books", "file_sampled": false, "has_test_file": null, "has_impl_file": null}, {"sha": "